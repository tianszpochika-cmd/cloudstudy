# Runtime
NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://englishflow:englishflow@localhost:5432/englishflow

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (local MinIO by default)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=englishflow-local
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

# AI provider abstraction: never commit real keys
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_TEXT=
AI_MODEL_REALTIME=

# Auth / sessions
AUTH_SECRET=change-me-in-local-only

# Product switches
ENABLE_REALTIME_VOICE=false
ENABLE_PAYMENTS=false
ENABLE_COMMUNITY=false
