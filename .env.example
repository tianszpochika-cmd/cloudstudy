RABBITMQ_MANAGEMENT_HOST_PORT=15690

# MySQL 8.x
DATABASE_URL=jdbc:mysql://127.0.0.1:13306/yuxuexing?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
DATABASE_USERNAME=yuxuexing
DATABASE_PASSWORD=yuxuexing

# Redis
REDIS_URL=redis://127.0.0.1:16379

# Object storage (local MinIO by default)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=yuxuexing-local
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

# Phase 2 AI only: never commit real keys
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_TEXT=
AI_MODEL_REALTIME=

# Auth / sessions
AUTH_SECRET=change-me-in-local-only

# Product switches
ENABLE_AI=false
ENABLE_REALTIME_VOICE=false
ENABLE_PAYMENTS=false
ENABLE_COMMUNITY=false
