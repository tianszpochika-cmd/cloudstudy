# Runtime
NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://127.0.0.1:18180
# v2 clients use the Gateway boundary; API_BASE_URL remains the v1 compatibility adapter during migration.
API_GATEWAY_BASE_URL=http://127.0.0.1:18070
API_BASE_URL=http://127.0.0.1:18080

# Fixed local host ports. Do not change per-agent or auto-increment.
API_GATEWAY_BIND_ADDRESS=127.0.0.1
API_GATEWAY_PORT=18070
IAM_SERVICE_BASE_URL=http://127.0.0.1:18087
IAM_SERVICE_PORT=18087
LEARNER_SERVICE_BASE_URL=http://127.0.0.1:18088
LEARNER_SERVICE_PORT=18088
CONTENT_SERVICE_BASE_URL=http://127.0.0.1:18089
CONTENT_SERVICE_PORT=18089
LEARNING_SERVICE_BASE_URL=http://127.0.0.1:18090
LEARNING_SERVICE_PORT=18090
ASSESSMENT_SERVICE_BASE_URL=http://127.0.0.1:18091
ASSESSMENT_SERVICE_PORT=18091
MEDIA_SERVICE_BASE_URL=http://127.0.0.1:18092
MEDIA_SERVICE_PORT=18092
NOTIFICATION_SERVICE_BASE_URL=http://127.0.0.1:18093
NOTIFICATION_SERVICE_PORT=18093
GAMIFICATION_SERVICE_BASE_URL=http://127.0.0.1:18094
GAMIFICATION_SERVICE_PORT=18094
SOCIAL_SERVICE_BASE_URL=http://127.0.0.1:18095
SOCIAL_SERVICE_PORT=18095
B12_SERVICES_ENABLED=true
COMMERCE_SERVICE_BASE_URL=http://127.0.0.1:18096
COMMERCE_SERVICE_PORT=18096
ADMIN_OPS_SERVICE_BASE_URL=http://127.0.0.1:18097
ADMIN_OPS_SERVICE_PORT=18097
ANALYTICS_SERVICE_BASE_URL=http://127.0.0.1:18098
ANALYTICS_SERVICE_PORT=18098
B13_SERVICES_ENABLED=true
B14_STRANGLER_ENABLED=true
B14_DEPRECATION_HEADERS_ENABLED=true
B14_DEPRECATION_SUNSET_AT=2027-06-30T00:00:00Z
B14_ROUTE_MODE_LEARNER=TARGET
B14_ROUTE_MODE_CONTENT=TARGET
B14_ROUTE_MODE_LEARNING=TARGET
B14_ROUTE_MODE_ASSESSMENT=TARGET
B14_ROUTE_MODE_MEDIA=TARGET
B14_ROUTE_MODE_GAMIFICATION=TARGET
B14_ROUTE_MODE_SOCIAL=TARGET
B14_ROUTE_MODE_COMMERCE=TARGET
COMMERCE_PUBLIC_TENANT_ID=platform
COMMERCE_PAYMENT_ENABLED=false
COMMERCE_PAYMENT_ENVIRONMENT=DISABLED
COMMERCE_REAL_PROVIDERS_ENABLED=false
GATEWAY_RESOURCE_SERVER_ENABLED=true
GATEWAY_JWT_PREVALIDATION_ENABLED=true
GATEWAY_RATE_LIMIT_ENABLED=false
GATEWAY_RATE_LIMIT_BACKEND=memory
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW=1m
GATEWAY_RATE_LIMIT_MAX_KEYS=10000
GATEWAY_RATE_LIMIT_FAIL_OPEN=false
GATEWAY_CONNECT_TIMEOUT_MS=1000
GATEWAY_RESPONSE_TIMEOUT=5s
GATEWAY_SECURITY_AUDIT_ENABLED=true
# Local platform-owned JWT authentication center. Private signing material is
# supplied only through an uncommitted file or a secret manager in production.
IAM_JWT_ISSUER=http://127.0.0.1:18087
IAM_JWT_AUDIENCE=yuxuexing-api
IAM_JWT_ALGORITHM=RS256
IAM_JWT_JWKS_URI=http://127.0.0.1:18087/api/v1/auth/jwks
IAM_JWT_PRIVATE_KEY_FILE=
IAM_JWT_PRIVATE_KEY_PEM=
IAM_JWT_PREVIOUS_PUBLIC_KEYS_JSON=
IAM_JWT_EPHEMERAL_KEY=true
IAM_PERSISTENCE_ENABLED=true
IAM_FLYWAY_ENABLED=true
IAM_LOCAL_ADULT_GATE_ENABLED=true
IAM_REFRESH_COOKIE_NAME=yuxuexing_refresh
IAM_REFRESH_COOKIE_SECURE=false
# B23/B30 aliases describe the self-owned JWT runtime and never enable an
# external provider or browser callback flow.
B23_JWT_ISSUER_URI=http://127.0.0.1:18087
B23_JWT_JWKS_URI=http://127.0.0.1:18087/api/v1/auth/jwks
B23_JWT_AUDIENCE=yuxuexing-api
B23_TEST_ACCOUNT_MATRIX=
# B16/B19 test seams point at the platform IAM JWKS endpoint.
B16_JWT_ISSUER_URI=http://127.0.0.1:18087
B16_JWT_JWKS_URI=http://127.0.0.1:18087/api/v1/auth/jwks
B19_RUNTIME_JWT_ISSUER=http://127.0.0.1:18087
B19_RUNTIME_JWT_JWKS_URI=http://127.0.0.1:18087/api/v1/auth/jwks
# B17 runtime-only Kafka test binding; static checks do not require a broker.
B17_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
# B18 runtime-only browser/API test matrix; values must point to approved local or staging fixtures.
B18_LEARNER_TEST_ORIGIN=http://127.0.0.1:18180
B18_ADMIN_TEST_ORIGIN=http://127.0.0.1:18181
B18_OFFICIAL_SITE_TEST_ORIGIN=http://127.0.0.1:18182
B18_MOBILE_TEST_ORIGIN=http://127.0.0.1:18183
B18_TEST_ACCOUNT_MATRIX=
B19_RUNTIME_ORIGIN=http://127.0.0.1:18070
B19_RUNTIME_ACCOUNT_MATRIX=
B19_RUNTIME_KAFKA_BOOTSTRAP=127.0.0.1:19092
B19_RUNTIME_MYSQL_DSN=
B19_GATEWAY_TEST_ORIGIN=http://127.0.0.1:18070
B19_TEST_ACCOUNT_MATRIX=
B19_BROWSER_EVIDENCE_DIR=
B19_DEVICE_EVIDENCE_DIR=
CORE_API_BIND_ADDRESS=127.0.0.1
CORE_API_PORT=18080
B3_PERSISTENCE_MODE=memory
LEARNER_WEB_DEV_PORT=18180
ADMIN_WEB_DEV_PORT=18181
OFFICIAL_SITE_DEV_PORT=18182
MOBILE_H5_DEV_PORT=18183
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
KAFKA_HOST_PORT=19092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
RABBITMQ_AMQP_HOST_PORT=15689
RABBITMQ_MANAGEMENT_HOST_PORT=15690

# MySQL 8.x
DATABASE_URL=jdbc:mysql://127.0.0.1:13306/yuxuexing?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
DATABASE_USERNAME=yuxuexing
DATABASE_PASSWORD=yuxuexing

# Redis
REDIS_URL=redis://127.0.0.1:16379

# Object storage (local MinIO by default)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=yuxuexing-local
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

# Phase 2 AI only: never commit real keys
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_TEXT=
AI_MODEL_REALTIME=

# Auth / sessions
AUTH_SECRET=change-me-in-local-only

# Product switches
ENABLE_AI=false
ENABLE_REALTIME_VOICE=false
ENABLE_PAYMENTS=false
ENABLE_COMMUNITY=false

# B20 Phase 1 release-Gate evidence; leave blank until approved isolated
# security/privacy/content/payment-sandbox/backup runners produce artifacts.
B20_SECURITY_SCAN_DIR=
B20_SBOM_REF=
B20_PRIVACY_EVIDENCE_DIR=
B20_CONTENT_RIGHTS_EVIDENCE_DIR=
B20_PAYMENT_SANDBOX_REF=
B20_BACKUP_RESTORE_EVIDENCE_DIR=
B20_GATE_EVIDENCE_INDEX=
B20_REQUIRE_RUNTIME=0
B20_RUNTIME_PRIVACY_EVIDENCE_REF=
B20_RUNTIME_AUDIT_REPLAY_EVIDENCE_REF=
B20_RUNTIME_CONTENT_EVIDENCE_REF=
B20_RUNTIME_OFFICIAL_PROJECTION_EVIDENCE_REF=
B20_RUNTIME_PAYMENT_SANDBOX=
B20_RUNTIME_PAYMENT_QUALIFICATION=
B20_RUNTIME_BACKUP_EVIDENCE_DIR=
B20_RUNTIME_RESTORE_EVIDENCE_DIR=
B20_RUNTIME_OBSERVABILITY_EVIDENCE=
B20_RUNTIME_EVIDENCE_INDEX=

# B21 pre-release evidence; keep empty until approved staging/RC runners
# produce signed artifacts and multi-party Go/No-Go records.
B21_REQUIRE_RUNTIME=0
# Deployment/staging evidence (empty until an approved isolated runner records it)
B21_K8S_CONTEXT=
B21_IMAGE_REGISTRY_EVIDENCE=
B21_SECRET_PROVIDER_EVIDENCE=
B21_STAGING_MIGRATION_EVIDENCE=
B21_NETWORK_POLICY_EVIDENCE=
B21_ROLLOUT_ROLLBACK_EVIDENCE=
# Observability/RC evidence (empty until the fixed candidate is actually exercised)
B21_RUNTIME_STAGING_ORIGIN=
B21_RUNTIME_OTEL_ENDPOINT=
B21_RUNTIME_ALERT_EVIDENCE=
B21_RUNTIME_RC_ARTIFACT_DIR=
B21_RUNTIME_SIGNATURE_EVIDENCE=
B21_RUNTIME_REGRESSION_EVIDENCE=
B21_RUNTIME_ROLLBACK_EVIDENCE=
# Go/No-Go and RC evidence index (empty until the required roles and artifacts are reviewed)
B21_RUNTIME_B20_GATE_EVIDENCE=
B21_RUNTIME_STAGING_RC=
B21_RUNTIME_RELEASE_WORKBENCH=
B21_RUNTIME_ARTIFACT_STORE=
B21_RUNTIME_SIGNOFF_INDEX=

# B22 production release/observation evidence; keep empty until B21 is accepted
# and approved production/maintenance runners create immutable, audited artifacts.
B22_REQUIRE_RUNTIME=0
B22_RUNTIME_B21_ACCEPTANCE_EVIDENCE_REF=
B22_RUNTIME_RELEASE_ARTIFACT_EVIDENCE_REF=
B22_RUNTIME_FOUR_PLATFORM_BINDING_EVIDENCE_REF=
B22_RUNTIME_HEALTH_SMOKE_EVIDENCE_REF=
B22_RUNTIME_CANARY_OBSERVATION_EVIDENCE_REF=
B22_RUNTIME_ROLLBACK_EVIDENCE_REF=
B22_RUNTIME_AUDIT_EVIDENCE_REF=
B22_DATA_RUNTIME_B21_GO_EVIDENCE=
B22_DATA_RUNTIME_SOURCE_REVISION=
B22_DATA_RUNTIME_ENVIRONMENT=
B22_DATA_RUNTIME_MIGRATION_EVIDENCE=
B22_DATA_RUNTIME_RECONCILIATION_EVIDENCE=
B22_DATA_RUNTIME_COMPATIBILITY_EVIDENCE=
B22_DATA_RUNTIME_ROLLBACK_EVIDENCE=
B22_DATA_RUNTIME_REPORT_INDEX=
B22_RUNTIME_B21_GATE_EVIDENCE=
B22_RUNTIME_PRODUCTION_OBSERVATION=
B22_RUNTIME_PRODUCTION_REPORT=
B22_RUNTIME_ARTIFACT_BINDING=
B22_RUNTIME_INCIDENT_AUDIT=
B22_RUNTIME_MAINTENANCE_SIGNOFF=
G_REQUIRE_RUNTIME=0
