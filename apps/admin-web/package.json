{
  "name": "@englishflow/admin-web",
  "version": "1.0.0",
  "private": true,
  "description": "语学星教研与运营管理后台 (Vue 3 + Element Plus)",
  "scripts": {
    "dev": "node ../../scripts/run-fixed-port.mjs admin-web-dev -- vite --host 127.0.0.1 --port 18181 --strictPort",
    "build": "vue-tsc && vite build",
    "test:b12": "node --test tests/b12-boundaries.test.mjs",
    "preview": "node ../../scripts/run-fixed-port.mjs admin-web-preview -- vite preview --host 127.0.0.1 --port 18191 --strictPort"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "element-plus": "^2.6.0",
    "@element-plus/icons-vue": "^2.3.0",
    "@englishflow/api-client": "workspace:*",
    "@englishflow/contracts": "workspace:*",
    "@englishflow/design-tokens": "workspace:*",
    "@englishflow/i18n": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "6.4.3",
    "vue-tsc": "^2.0.0"
  }
}
