{
  "name": "@englishflow/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "语学星移动客户端 (Vue 3 + uni-app)",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:app": "node ../../scripts/run-fixed-port.mjs mobile-app-dev -- uni -p app --host 127.0.0.1 --port 18184 --strictPort",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "node ../../scripts/run-fixed-port.mjs mobile-h5-dev -- uni -p h5 --host 127.0.0.1 --port 18183 --strictPort",
    "build:app": "uni build -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:h5": "uni build -p h5",
    "test:b10": "node --test tests/b10/*.test.mjs",
    "test:b11": "node --test tests/b11/*.test.mjs",
    "test:b12": "node --test tests/b12/*.test.mjs"
  },
  "dependencies": {
    "vue": "3.5.41",
    "pinia": "^2.1.0",
    "@englishflow/api-client": "workspace:*",
    "@englishflow/contracts": "workspace:*",
    "@englishflow/design-tokens": "workspace:*",
    "@englishflow/i18n": "workspace:*",
    "@englishflow/performance": "workspace:*"
  },
  "devDependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-4080720251125001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-4080720251125001",
    "@dcloudio/uni-h5": "3.0.0-alpha-4080720251125001",
    "@dcloudio/uni-components": "3.0.0-alpha-4080720251125001",
    "@dcloudio/types": "3.4.31",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/compiler-dom": "3.5.41",
    "@vue/reactivity": "3.5.41",
    "@vue/runtime-core": "3.5.41",
    "@vue/runtime-dom": "3.5.41",
    "@vue/shared": "3.5.41",
    "sass": "^1.77.0",
    "typescript": "^5.4.0",
    "vite": "5.2.8"
  }
}
