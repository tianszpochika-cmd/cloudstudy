# dependencies
node_modules/
.pnpm-store/
.yarn/

# build output
.next/
out/
dist/
build/
coverage/
.expo/
.turbo/
**/.turbo/
target/
**/target/
**/.nuxt/
**/.output/

# local config and secrets
.env
.env.*
!.env.example
*.local
secrets/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.workbuddy/
*.swp

# local data and logs
logs/*
!logs/.gitkeep
# Runtime/dev-server output lands at the repo root (fe-*.log, services-run*.log,
# docker-build*.log) and would otherwise show up as untracked forever. No *.log is
# currently tracked, so this only affects new runtime output; durable evidence goes
# into docs/ as .md or .json, not raw logs.
*.log
tmp/*
!tmp/.gitkeep
storage/raw/*
!storage/raw/.gitkeep
storage/processed/*
!storage/processed/.gitkeep

# generated artifacts
*.generated.*
*.lock.tmp
*.class
**/.compile-*/
**/.tmp-*compile*/
/evidence/p1r/m0/repo-fixtures/runtime/

# Python
__pycache__/
.venv/
.pytest_cache/

# mobile
android/.gradle/
android/app/build/
ios/Pods/
ios/build/
