      "B2PageResponse": { "description": "Cursor page", "content": { "application/json": { "schema": { "type": "object", "properties": { "page": { "type": "object" }, "items": { "type": "array", "items": { "type": "object" } } } } } } },
      "B2CheckpointResponse": { "description": "Checkpoint accepted", "content": { "application/json": { "schema": { "type": "object" } } } },
      "B2CompletionResponse": { "description": "Session completion", "content": { "application/json": { "schema": { "type": "object" } } } },
      "B2HeartbeatResponse": { "description": "Server clock", "content": { "application/json": { "schema": { "type": "object" } } } },
      "B2EventAccepted": { "description": "Metadata event accepted", "content": { "application/json": { "schema": { "type": "object" } } } },
      "B2SubmitAccepted": { "description": "Submit accepted", "content": { "application/json": { "schema": { "type": "object" } } } },
      "B2ReportProcessing": { "description": "Report is still generating", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B2ApiError" } } } },
      "B2PaperResponse": { "description": "Paper without answers", "content": { "application/json": { "schema": { "type": "object" } } } },
      "B2Conflict": { "description": "State or idempotency conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B2ApiError" } } } },
      "B2NotFound": { "description": "Not found in actor scope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B2ApiError" } } } },
      "B2Gone": { "description": "Not due or expired", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B2ApiError" } } } },
      "B2Unprocessable": { "description": "Invalid answer schema", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B2ApiError" } } } }
    }
  }
