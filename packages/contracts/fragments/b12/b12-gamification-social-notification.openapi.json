    "parameters": {
      "B12IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 192 } },
      "B12RoomId": { "name": "roomId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B12GrantId": { "name": "grantId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^grant_[A-Za-z0-9._:-]{8,127}$" } },
      "B12MessageId": { "name": "messageId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 160 } },
      "B12ReportId": { "name": "reportId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B12TaskId": { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B12PageCursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 256 } },
      "B12LeaderboardKind": { "name": "kind", "in": "query", "required": false, "schema": { "type": "string", "enum": ["FOCUS_MINUTES", "MASTERED_WORDS", "XP"] } },
      "B12LeaderboardPeriod": { "name": "period", "in": "query", "required": false, "schema": { "type": "string", "enum": ["DAY", "WEEK"] } },
      "B12OptionalRoomId": { "name": "roomId", "in": "query", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B12ModerationStatus": { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["OPEN", "REVIEWING", "RESOLVED", "DISMISSED"] } },
      "B12RecoveryStatus": { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "DLQ", "MANUAL_REVIEW"] } }
    },
    "responses": {
      "B12Unauthorized": { "description": "未认证", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12Error" } } } },
      "B12Forbidden": { "description": "主体、租户、资源所有权或策略不允许", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12Error" } } } },
      "B12NotFound": { "description": "资源不存在或对当前主体不可见", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12Error" } } } },
      "B12Conflict": { "description": "幂等、版本、席位或状态冲突", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12Error" } } } }
    },
    "schemas": {
      "B12Error": { "type": "object", "additionalProperties": false, "required": ["code", "retryable"], "properties": { "code": { "type": "string", "enum": ["unauthorized", "forbidden", "not_found", "conflict", "invalid_command", "feature_disabled", "lease_expired", "retry_exhausted", "policy_denied"] }, "retryable": { "type": "boolean" }, "requestId": { "type": "string", "maxLength": 128 } } },
      "B12GrowthSummary": { "type": "object", "additionalProperties": false, "required": ["subjectRef", "level", "serverScore", "streakDays", "currentSeason", "featureEnabled"], "properties": { "subjectRef": { "type": "string", "maxLength": 128 }, "level": { "type": "integer", "minimum": 1 }, "serverScore": { "type": "integer", "minimum": 0 }, "streakDays": { "type": "integer", "minimum": 0 }, "currentSeason": { "type": "string", "maxLength": 64 }, "featureEnabled": { "type": "boolean" } } },
      "B12LedgerEntry": { "type": "object", "additionalProperties": false, "required": ["entryId", "kind", "amount", "ruleVersion", "occurredAt", "sourceEventId"], "properties": { "entryId": { "type": "string", "maxLength": 128 }, "kind": { "type": "string", "enum": ["SCORE", "CURRENCY"] }, "amount": { "type": "integer", "minimum": 0 }, "ruleVersion": { "type": "string", "maxLength": 64 }, "occurredAt": { "type": "string", "format": "date-time" }, "sourceEventId": { "type": "string", "maxLength": 128 } } },
      "B12LedgerPage": { "type": "object", "additionalProperties": false, "required": ["items", "nextCursor", "conserved"], "properties": { "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/B12LedgerEntry" } }, "nextCursor": { "type": "string", "maxLength": 256 }, "conserved": { "type": "boolean" } } },
      "B12RewardGrant": { "type": "object", "additionalProperties": false, "required": ["grantId", "rewardCode", "state", "probabilityVersion", "issuedAt"], "properties": { "grantId": { "type": "string", "maxLength": 128 }, "rewardCode": { "type": "string", "maxLength": 96 }, "state": { "type": "string", "enum": ["AVAILABLE", "CLAIMED", "EXPIRED", "REVOKED"] }, "probabilityVersion": { "type": "string", "maxLength": 64 }, "issuedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time", "nullable": true } } },
      "B12RewardPage": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/B12RewardGrant" } } } },
      "B12RewardProbability": { "type": "object", "additionalProperties": false, "required": ["probabilityVersion", "tiers", "disclosedAt"], "properties": { "probabilityVersion": { "type": "string", "maxLength": 64 }, "tiers": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["tierCode", "basisPoints"], "properties": { "tierCode": { "type": "string", "maxLength": 64 }, "basisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 } } } }, "disclosedAt": { "type": "string", "format": "date-time" } } },
      "B12RewardClaimRequest": { "type": "object", "additionalProperties": false, "required": ["commandCode"], "properties": { "commandCode": { "type": "string", "enum": ["CLAIM"] } } },
      "B12RewardClaimResult": { "type": "object", "additionalProperties": false, "required": ["grantId", "state", "claimId", "replayed"], "properties": { "grantId": { "type": "string", "maxLength": 128 }, "state": { "type": "string", "enum": ["CLAIMED", "ALREADY_CLAIMED", "REJECTED"] }, "claimId": { "type": "string", "maxLength": 128 }, "replayed": { "type": "boolean" }, "outcomeCode": { "type": "string", "maxLength": 96, "nullable": true }, "probabilityVersion": { "type": "string", "maxLength": 64, "nullable": true } } },
      "B12TrustedCompletion": { "type": "object", "additionalProperties": false, "required": ["sourceService", "eventId", "traceId", "schemaVersion", "occurredAt", "subject", "aggregateId", "ruleVersion", "eventType"], "properties": { "sourceService": { "type": "string", "enum": ["learning-service", "assessment-service"] }, "eventId": { "type": "string", "maxLength": 200 }, "traceId": { "type": "string", "maxLength": 200 }, "schemaVersion": { "type": "string", "enum": ["v1", "1", "1.0", "1.0.0"] }, "occurredAt": { "type": "string", "format": "date-time" }, "subject": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "maxLength": 128 } } }] }, "aggregateId": { "type": "string", "maxLength": 200 }, "ruleVersion": { "type": "string", "maxLength": 80 }, "eventType": { "type": "string", "maxLength": 120 } } },
      "B12SettlementResult": { "type": "object", "additionalProperties": false, "required": ["eventId", "settlementState", "ledgerEntryId", "replayed"], "properties": { "eventId": { "type": "string", "maxLength": 128 }, "settlementState": { "type": "string", "enum": ["APPLIED", "DUPLICATE", "REJECTED"] }, "ledgerEntryId": { "type": "string", "maxLength": 128 }, "replayed": { "type": "boolean" } } },
      "B12RoomCommand": { "type": "object", "additionalProperties": false, "properties": { "clientEpoch": { "type": "integer", "minimum": 1 }, "leaseVersion": { "type": "integer", "minimum": 1 } } },
      "B12RoomState": { "type": "object", "additionalProperties": false, "required": ["roomId", "seatState", "leaseVersion", "visibleMemberCount"], "properties": { "roomId": { "type": "string", "maxLength": 128 }, "seatState": { "type": "string", "enum": ["ACTIVE", "DISCONNECTED", "RECOVERED", "EXPIRED", "LEFT"] }, "leaseVersion": { "type": "integer", "minimum": 1 }, "visibleMemberCount": { "type": "integer", "minimum": 0 } } },
      "B12FocusCommand": { "type": "object", "additionalProperties": false, "properties": { "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 180 }, "focusTagCode": { "type": "string", "enum": ["VOCABULARY", "LISTENING", "READING", "GRAMMAR", "SPEAKING", "WRITING"] }, "clientEventId": { "type": "string", "maxLength": 160 } } },
      "B12FocusUpdateCommand": { "type": "object", "additionalProperties": false, "required": ["focusId", "action"], "properties": { "focusId": { "type": "string", "maxLength": 128 }, "action": { "type": "string", "enum": ["PAUSE", "RESUME", "FINISH", "ABORT"] }, "clientEventId": { "type": "string", "maxLength": 160 } } },
      "B12FocusSession": { "type": "object", "additionalProperties": false, "required": ["focusId", "roomId", "seatIndex", "state", "durationMinutes", "startedAt"], "properties": { "focusId": { "type": "string", "maxLength": 128 }, "roomId": { "type": "string", "maxLength": 128 }, "seatIndex": { "type": "integer", "minimum": 1 }, "state": { "type": "string", "enum": ["FOCUSING", "PAUSED", "COMPLETE", "AUTO_RELEASED", "INVALID"] }, "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 180 }, "startedAt": { "type": "string", "format": "date-time" } } },
      "B12PresetInteraction": { "type": "object", "additionalProperties": false, "required": ["presetCode", "clientEventId"], "properties": { "presetCode": { "type": "string", "enum": ["CHEER_UP", "STUDY_TOGETHER", "CONGRATS", "TRY_AGAIN", "TONIGHT_20_MIN"] }, "targetSeatIndex": { "type": "integer", "minimum": 0 }, "clientEventId": { "type": "string", "maxLength": 160 } } },
      "B12InteractionResult": { "type": "object", "additionalProperties": false, "required": ["eventId", "roomId", "presetCode", "state", "deliveredAt"], "properties": { "eventId": { "type": "string", "maxLength": 128 }, "roomId": { "type": "string", "maxLength": 128 }, "presetCode": { "type": "string", "maxLength": 64 }, "targetSeatIndex": { "type": "integer", "minimum": 1 }, "state": { "type": "string", "enum": ["DELIVERED"] }, "deliveredAt": { "type": "string", "format": "date-time" } } },
      "B12LeaderboardEntry": { "type": "object", "additionalProperties": false, "required": ["rank", "displayMode", "score", "qualifiedUnits", "isSelf"], "properties": { "rank": { "type": "integer", "minimum": 1 }, "displayMode": { "type": "string", "enum": ["SELF", "NICKNAME", "ANONYMOUS", "DEIDENTIFIED"] }, "displayName": { "type": "string", "maxLength": 64, "nullable": true }, "score": { "type": "integer", "minimum": 0 }, "qualifiedUnits": { "type": "integer", "minimum": 0 }, "sourceWatermark": { "type": "string", "maxLength": 160, "nullable": true }, "isSelf": { "type": "boolean" }, "targetSeatIndex": { "type": "integer", "minimum": 1 } } },
      "B12Leaderboard": { "type": "object", "additionalProperties": false, "required": ["kind", "period", "periodStart", "periodEnd", "timeZone", "projectionState", "dataFreshness", "delayed", "snapshotVersion", "entries", "me", "sourceWatermark"], "properties": { "kind": { "type": "string", "enum": ["FOCUS_MINUTES", "MASTERED_WORDS", "XP"] }, "period": { "type": "string", "enum": ["DAY", "WEEK"] }, "periodStart": { "type": "string", "format": "date" }, "periodEnd": { "type": "string", "format": "date" }, "timeZone": { "type": "string", "maxLength": 64 }, "projectionState": { "type": "string", "enum": ["DELAYED", "PROVISIONAL", "PUBLISHED", "FROZEN"] }, "dataFreshness": { "type": "string", "enum": ["DELAYED", "CURRENT"] }, "delayed": { "type": "boolean" }, "asOf": { "type": "string", "format": "date-time", "nullable": true }, "snapshotVersion": { "type": "integer", "minimum": 0 }, "entries": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/B12LeaderboardEntry" } }, "me": { "type": "object", "additionalProperties": false, "required": ["present", "visibility"], "properties": { "present": { "type": "boolean" }, "visibility": { "type": "string", "maxLength": 32 }, "score": { "type": "integer", "minimum": 0 }, "qualifiedUnits": { "type": "integer", "minimum": 0 } } }, "sourceWatermark": { "type": "string", "maxLength": 160, "nullable": true }, "roomId": { "type": "string", "maxLength": 128 } } },
      "B12VisibilityCommand": { "type": "object", "additionalProperties": false, "properties": { "leaderboardVisibility": { "type": "string", "enum": ["NICKNAME", "ANONYMOUS", "OPT_OUT"] }, "roomVisibility": { "type": "string", "enum": ["PUBLIC", "ANONYMOUS", "PRIVATE"] } } },
      "B12Visibility": { "type": "object", "additionalProperties": false, "required": ["leaderboardVisibility", "roomVisibility", "updatedAt"], "properties": { "leaderboardVisibility": { "type": "string", "maxLength": 32 }, "roomVisibility": { "type": "string", "maxLength": 32 }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "B12ReportCommand": { "type": "object", "additionalProperties": false, "required": ["targetSeatIndex", "reasonCode", "clientEventId"], "properties": { "targetSeatIndex": { "type": "integer", "minimum": 1 }, "reasonCode": { "type": "string", "enum": ["SPAM", "HARASSMENT", "SENSITIVE_CONTENT", "IMPERSONATION", "OTHER"] }, "clientEventId": { "type": "string", "maxLength": 160 } } },
      "B12Report": { "type": "object", "additionalProperties": false, "required": ["reportId", "roomId", "targetSeatIndex", "reasonCode", "status", "reviewMode", "createdAt", "updatedAt", "clientEventId"], "properties": { "reportId": { "type": "string", "maxLength": 128 }, "roomId": { "type": "string", "maxLength": 128 }, "targetSeatIndex": { "type": "integer", "minimum": 1 }, "reasonCode": { "type": "string", "maxLength": 64 }, "status": { "type": "string", "enum": ["RECEIVED", "TRIAGED", "ACTIONED", "REJECTED", "APPEALED", "CLOSED"] }, "reviewMode": { "type": "string", "enum": ["MANUAL"] }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "clientEventId": { "type": "string", "maxLength": 160 }, "idempotentReplay": { "type": "boolean" } } },
      "B12TrustedSocialEvent": { "type": "object", "additionalProperties": false, "required": ["eventId", "traceId", "schemaVersion", "eventType", "sourceService", "subjectId", "occurredAt", "payload"], "properties": { "eventId": { "type": "string", "maxLength": 128 }, "traceId": { "type": "string", "maxLength": 128 }, "schemaVersion": { "type": "string", "maxLength": 64 }, "eventType": { "type": "string", "enum": ["learning.activity.v1", "learning.focus.qualified.v1", "learning.focus_completed.v1", "learning.mastery.reached.v1", "learning.mastery_reached.v1", "gamification.xp.ledger_posted.v1", "leaderboard.refreshed.v1", "leaderboard.frozen.v1"] }, "sourceService": { "type": "string", "enum": ["learning-service", "gamification-service", "workflow-service", "social-workflow"] }, "subjectId": { "type": "string", "maxLength": 128 }, "occurredAt": { "type": "string", "format": "date-time" }, "payload": { "type": "object", "additionalProperties": false } } },
      "B12NotificationTrustedEvent": { "type": "object", "additionalProperties": false, "required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "principalId"], "properties": { "eventId": { "type": "string", "maxLength": 128 }, "eventName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+\\.v[0-9]+$" }, "schema": { "type": "string", "maxLength": 64 }, "version": { "type": "integer", "minimum": 1 }, "occurredAt": { "type": "string", "format": "date-time" }, "aggregateType": { "type": "string", "maxLength": 64 }, "aggregateId": { "type": "string", "maxLength": 128 }, "actorId": { "type": "string", "maxLength": 128 }, "traceId": { "type": "string", "maxLength": 128 }, "requestId": { "type": "string", "maxLength": 128 }, "schemaVersion": { "type": "string", "maxLength": 64 }, "dedupeKey": { "type": "string", "maxLength": 255 }, "principalId": { "type": "string", "maxLength": 128 }, "templateId": { "type": "string", "maxLength": 96 }, "locale": { "type": "string", "maxLength": 20 }, "channel": { "type": "string", "enum": ["IN_APP", "PUSH", "EMAIL"] }, "notBefore": { "type": "string", "format": "date-time" }, "attributes": { "type": "object", "additionalProperties": { "type": "string" }, "maxProperties": 64 } } },
      "B12NotificationPreference": { "type": "object", "additionalProperties": false, "required": ["notificationType", "channel", "enabled", "locale", "version", "updatedAt"], "properties": { "notificationType": { "type": "string", "maxLength": 80 }, "channel": { "type": "string", "enum": ["IN_APP", "PUSH", "EMAIL"] }, "enabled": { "type": "boolean" }, "locale": { "type": "string", "maxLength": 20 }, "version": { "type": "integer", "minimum": 1 }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "B12NotificationPreferenceCommand": { "type": "object", "additionalProperties": false, "required": ["enabled", "locale"], "properties": { "enabled": { "type": "boolean" }, "locale": { "type": "string", "maxLength": 20 }, "expectedVersion": { "type": "integer", "minimum": 0 } } },
      "B12NotificationMessage": { "type": "object", "additionalProperties": false, "required": ["messageId", "notificationType", "channel", "title", "safeBody", "contentVersion", "createdAt", "read"], "properties": { "messageId": { "type": "string", "maxLength": 128 }, "notificationType": { "type": "string", "maxLength": 80 }, "channel": { "type": "string", "enum": ["IN_APP", "PUSH", "EMAIL"] }, "title": { "type": "string", "maxLength": 160 }, "safeBody": { "type": "string", "maxLength": 4000 }, "contentVersion": { "type": "string", "maxLength": 80 }, "createdAt": { "type": "string", "format": "date-time" }, "read": { "type": "boolean" } } },
      "B12EventReceipt": { "type": "object", "additionalProperties": false, "required": ["eventId", "state", "replayed"], "properties": { "eventId": { "type": "string", "maxLength": 128 }, "state": { "type": "string", "enum": ["ACCEPTED", "DUPLICATE", "REJECTED"] }, "replayed": { "type": "boolean" } } },
      "B12RetryCommand": { "type": "object", "additionalProperties": false, "required": ["taskId"], "properties": { "taskId": { "type": "string", "maxLength": 128 } } },
      "B12RetryResult": { "type": "object", "additionalProperties": false, "required": ["taskId", "status", "workflow", "nextAttemptAt"], "properties": { "taskId": { "type": "string", "maxLength": 128 }, "status": { "type": "string", "enum": ["DELAYED", "DELIVERED", "RETRY_SCHEDULED", "DEAD_LETTER", "CANCELLED", "TERMINAL"] }, "delivery": { "type": "object", "additionalProperties": false }, "workflow": { "type": "object", "additionalProperties": false, "required": ["taskId", "action", "aggregateType", "aggregateId", "state", "attempt", "maxAttempts", "nextRunAt", "updatedAt"], "properties": { "taskId": { "type": "string", "maxLength": 128 }, "action": { "type": "string", "maxLength": 64 }, "aggregateType": { "type": "string", "maxLength": 64 }, "aggregateId": { "type": "string", "maxLength": 128 }, "state": { "type": "string", "maxLength": 32 }, "attempt": { "type": "integer", "minimum": 0 }, "maxAttempts": { "type": "integer", "minimum": 1 }, "reasonCode": { "type": "string", "maxLength": 100, "nullable": true }, "nextRunAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } }, "reasonCode": { "type": "string", "maxLength": 100, "nullable": true }, "nextAttemptAt": { "type": "string", "format": "date-time", "nullable": true } } },
      "B12RecoveryCommand": { "type": "object", "additionalProperties": false, "required": ["taskId", "action", "reasonCode"], "properties": { "taskId": { "type": "string", "maxLength": 128 }, "action": { "type": "string", "enum": ["RETRY", "REPLAY", "CANCEL", "MANUAL_REVIEW"] }, "reasonCode": { "type": "string", "maxLength": 100 } } },
      "B12RecoveryResult": { "type": "object", "additionalProperties": false, "required": ["taskId", "action", "state", "reasonCode", "updatedAt"], "properties": { "taskId": { "type": "string", "maxLength": 128 }, "action": { "type": "string", "enum": ["RETRY", "REPLAY", "CANCEL", "MANUAL_REVIEW"] }, "state": { "type": "string", "maxLength": 32 }, "reasonCode": { "type": "string", "maxLength": 100 }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "B12ModerationCommand": { "type": "object", "additionalProperties": false, "required": ["commandCode"], "properties": { "commandCode": { "type": "string", "enum": ["START_REVIEW", "RESOLVE", "DISMISS", "ESCALATE"] } } },
      "B12ReportPage": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/B12Report" } } } },
      "B12RecoveryPage": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/B12RecoveryResult" } } } }
    }
  }
}
