      "post": { "tags": ["B12-Notification"], "operationId": "dispatchB12NotificationRetry", "security": [{ "B8WorkloadIdentity": [] }], "parameters": [{ "$ref": "#/components/parameters/B12IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12RetryCommand" } } } }, "x-idempotency": { "required": true, "strategy": "workflow-task-id-key", "replayBehavior": "return-current-delivery-state" }, "responses": { "200": { "description": "重试状态", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12RetryResult" } } } }, "401": { "$ref": "#/components/responses/B12Unauthorized" }, "403": { "$ref": "#/components/responses/B12Forbidden" }, "409": { "$ref": "#/components/responses/B12Conflict" } } }
    },
    "/internal/v1/notifications/recovery": {
      "post": { "tags": ["B12-Notification"], "operationId": "recoverB12NotificationTask", "security": [{ "B8WorkloadIdentity": [] }], "parameters": [{ "$ref": "#/components/parameters/B12IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12RecoveryCommand" } } } }, "x-idempotency": { "required": true, "strategy": "workflow-task-action-key", "replayBehavior": "return-original-recovery" }, "responses": { "200": { "description": "人工恢复状态", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12RecoveryResult" } } } }, "401": { "$ref": "#/components/responses/B12Unauthorized" }, "403": { "$ref": "#/components/responses/B12Forbidden" }, "409": { "$ref": "#/components/responses/B12Conflict" } } }
    },
    "/api/v1/admin/moderation/reports": {
      "get": { "tags": ["B12-Governance"], "operationId": "listB12ModerationReports", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B12ModerationStatus" }], "responses": { "200": { "description": "审核队列", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12ReportPage" } } } }, "401": { "$ref": "#/components/responses/B12Unauthorized" }, "403": { "$ref": "#/components/responses/B12Forbidden" } } }
    },
