{
  "openapi": "3.0.3",
  "info": {
    "title": "语学星 B12 Growth Social Notification API",
    "version": "1.0.0",
    "description": "B12 成长、学习社群、通知工作流和运营恢复的契约边界。XP、奖励、席位、通知和恢复事实均由服务端产生。"
  },
