      "get": { "tags": ["B12-Social"], "operationId": "getB12SocialReport", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B12ReportId" }], "responses": { "200": { "description": "当前主体可见的举报状态", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12Report" } } } }, "401": { "$ref": "#/components/responses/B12Unauthorized" }, "403": { "$ref": "#/components/responses/B12Forbidden" }, "404": { "$ref": "#/components/responses/B12NotFound" } } }
    },
