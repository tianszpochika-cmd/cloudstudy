      "post": { "tags": ["B12-Governance"], "operationId": "executeB12ModerationCommand", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B12ReportId" }, { "$ref": "#/components/parameters/B12IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12ModerationCommand" } } } }, "x-idempotency": { "required": true, "strategy": "report-command-key", "replayBehavior": "return-original-moderation-state" }, "responses": { "200": { "description": "审核操作结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12Report" } } } }, "401": { "$ref": "#/components/responses/B12Unauthorized" }, "403": { "$ref": "#/components/responses/B12Forbidden" }, "409": { "$ref": "#/components/responses/B12Conflict" } } }
    },
