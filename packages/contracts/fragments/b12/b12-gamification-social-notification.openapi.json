    },
    "/api/v1/social/rooms/{roomId}/disconnect": {
      "post": { "tags": ["B12-Social"], "operationId": "disconnectB12StudyRoom", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B12RoomId" }, { "$ref": "#/components/parameters/B12IdempotencyKey" }], "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12RoomCommand" } } } }, "x-idempotency": { "required": true, "strategy": "principal-room-command-key", "replayBehavior": "return-room-seat-state" }, "responses": { "200": { "description": "断线租约已标记", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B12RoomState" } } } }, "401": { "$ref": "#/components/responses/B12Unauthorized" }, "403": { "$ref": "#/components/responses/B12Forbidden" }, "409": { "$ref": "#/components/responses/B12Conflict" } } }
    },
