    "routeClassBindings": {
      "source": "routeRules[].authClass",
      "allClassesRequireNamedPolicy": true,
      "defaultReadClass": "AUTHENTICATED_READ",
      "defaultWriteClass": "AUTHENTICATED_WRITE",
      "adminPrefixClass": "HIGH_RISK_ADMIN",
      "unknownClassDecision": "DENY"
    },
    "correlation": {
      "requestId": { "header": "X-Request-Id", "sanitizeAndBound": true, "generateWhenMissingOrInvalid": true },
      "traceId": { "header": "X-Trace-Id", "sanitizeAndBound": true, "generateWhenMissingOrInvalid": true },
      "traceparent": { "standard": "W3C", "clientValueTrustedAsSecurityContext": false },
      "responseHeadersRequired": ["X-Request-Id", "X-Trace-Id"]
    },
    "idempotency": {
      "header": "Idempotency-Key",
      "persistentWritesRequired": true,
      "governanceSource": "#/x-p1r-api-governance/idempotency",
      "safeException": { "method": "POST", "path": "/api/v1/content/media/{mediaAssetId}/signed-access", "createsPersistentDomainFact": false }
    },
    "errors": {
      "401": "#/components/responses/ApiUnauthorized",
      "403": "#/components/responses/ApiForbidden",
      "429": "#/components/responses/ApiRateLimited",
      "500": "#/components/responses/ApiInternalError",
      "503": "#/components/responses/ApiServiceUnavailable",
      "504": "#/components/responses/ApiGatewayTimeout",
      "rateLimitedRetryAfterRequired": true,
      "authenticationAndAuthorizationDistinct": true
    },
    "audit": {
      "required": true,
      "sink": "audit-service",
      "allowedFields": ["occurredAt", "routeId", "method", "status", "requestId", "traceId", "subjectHash", "tenantHash", "clientProfile", "decision", "reasonCode", "latencyBucket"],
      "boundedFields": true,
      "redactedFields": ["Authorization", "Cookie", "Set-Cookie", "accessToken", "refreshToken", "password", "requestBody", "queryString", "rawAudio", "base64Audio", "uploadUrl", "accessUrl", "signedUrl", "objectUrl", "objectKey", "objectCredential", "transcript", "transcriptText", "subtitleText", "captionText", "paymentCredential"],
      "clientAuthorityFactsPersisted": false,
      "durableRuntimeEvidenceRequired": true
    },
    "directConnect": {
      "externalTrafficGatewayOnly": true,
      "publicDomainServicePorts": false,
      "ingressNetworkPolicyRequired": true,
      "serviceCredentialsRequired": true,
      "gatewayInternalPathDenyIsSufficient": false,
      "runtimeProbeRequired": true,
      "failureDecision": "DENY"
    },
    "m2RuntimeGaps": [
      { "id": "M2-GW-CSRF", "ownerTask": "P1R-M2-001", "status": "OPEN", "description": "WebFlux currently disables CSRF and lacks the exact Origin/Referer profile enforcement." },
      { "id": "M2-GW-PUBLIC-PATH", "ownerTask": "P1R-M2-001", "status": "OPEN", "description": "Verifier-disabled public-path handling is not proven to equal the canonical anonymous route set." },
      { "id": "M2-GW-RATE-LIMIT", "ownerTask": "P1R-M2-001", "status": "OPEN", "description": "Distributed rate limiting is disabled by default and needs Redis failure evidence." },
      { "id": "M2-GW-AUDIT", "ownerTask": "P1R-M2-001", "status": "OPEN", "description": "The bounded in-memory audit sink is not durable audit-service evidence." },
      { "id": "M2-GW-DIRECT-CONNECT", "ownerTask": "P1R-M2-001", "status": "OPEN", "description": "Application rejection of /internal does not prove domain service ports are network-isolated." },
      { "id": "M2-GW-RUNTIME-EVIDENCE", "ownerTask": "P1R-M2-001", "status": "OPEN", "description": "Real browser, JWKS rotation, cross-process and network-isolation evidence remains required." }
    ]
  }
}
