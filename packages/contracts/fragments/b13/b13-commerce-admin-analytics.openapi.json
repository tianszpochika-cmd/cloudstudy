      "B13RecomputeRequest": { "type": "object", "additionalProperties": false, "required": ["metricCode", "metricVersion", "windowStart", "windowEnd", "reasonCode"], "properties": { "metricCode": { "type": "string", "maxLength": 96 }, "metricVersion": { "type": "string", "maxLength": 32 }, "windowStart": { "type": "string", "format": "date-time" }, "windowEnd": { "type": "string", "format": "date-time" }, "reasonCode": { "type": "string", "maxLength": 96 } } },
      "B13RecomputeJob": { "type": "object", "additionalProperties": false, "required": ["jobId", "metricCode", "state", "replayed", "requestedAt"], "properties": { "jobId": { "type": "string", "maxLength": 128 }, "metricCode": { "type": "string", "maxLength": 96 }, "state": { "type": "string", "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED"] }, "replayed": { "type": "boolean" }, "requestedAt": { "type": "string", "format": "date-time" } } }
    }
  }
