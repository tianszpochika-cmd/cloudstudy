      "B13AdminCommandResult": { "type": "object", "additionalProperties": false, "required": ["commandId", "state", "approvalRequired", "auditRef", "domainFactsUntouched"], "properties": { "commandId": { "type": "string", "maxLength": 128 }, "state": { "type": "string", "enum": ["PENDING_APPROVAL", "CONFIRMED", "FORWARDED", "REJECTED", "COMPLETED"] }, "approvalRequired": { "type": "boolean" }, "auditRef": { "type": "string", "maxLength": 128 }, "domainFactsUntouched": { "type": "boolean", "const": true } } },
      "B13MetricProjection": { "type": "object", "additionalProperties": false, "required": ["metricCode", "metricVersion", "periodStart", "periodEnd", "value", "state", "generatedAt"], "properties": { "metricCode": { "type": "string", "maxLength": 96 }, "metricVersion": { "type": "string", "maxLength": 32 }, "periodStart": { "type": "string", "format": "date-time" }, "periodEnd": { "type": "string", "format": "date-time" }, "value": { "type": "number" }, "state": { "type": "string", "enum": ["READY", "STALE", "RECOMPUTING", "UNAVAILABLE"] }, "generatedAt": { "type": "string", "format": "date-time" } } },
