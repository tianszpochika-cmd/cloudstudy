        "x-authorization": {"requiredPermission": "privacy.export.owner-receipt.write", "defaultDecision": "DENY", "trustedFacts": ["trustedWorkloadIdentity", "serverDerivedOwnerService", "serverDerivedTenant", "pathExportId", "policyVersion"], "serviceSidePepRequired": true, "clientAuthority": "NONE"},
        "x-idempotency": {"required": true, "keyHeader": "Idempotency-Key", "strategy": "privacy-export-owner-receipt", "replayBehavior": "same workload, export and receipt digest return the original acknowledgement; a different digest is a conflict"},
        "parameters": [{"$ref": "#/components/parameters/M1017ExportId"}, {"$ref": "#/components/parameters/B1IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/M1017OwnerReceiptSubmission"}}}},
        "responses": {
          "202": {"description": "Owner receipt accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/M1017PrivacyExportEnvelope"}}}},
          "401": {"$ref": "#/components/responses/ApiUnauthorized"},
          "403": {"$ref": "#/components/responses/ApiForbidden"},
          "409": {"$ref": "#/components/responses/ApiConflict"},
          "422": {"$ref": "#/components/responses/ApiUnprocessableEntity"}
        }
      }
    },
    "/internal/v1/privacy/exports/{exportId}/recovery": {
      "post": {
        "tags": ["m1-017-privacy-lifecycle"],
        "summary": "Request a controlled privacy export recovery",
        "operationId": "recoverM1017PrivacyExport",
        "security": [{"B8ServiceIdentity": []}],
        "x-owner": "learner-service.privacy",
        "x-contract": {"task": "P1R-M1-017", "canonical": true, "maturity": "D2_CONTRACT_READY", "runtimeStatus": "NOT_RUNTIME_VERIFIED", "clientAuthority": "NONE"},
        "x-authorization": {"requiredPermission": "privacy.export.recovery.execute", "defaultDecision": "DENY", "trustedFacts": ["trustedWorkloadIdentity", "serverDerivedTenant", "pathExportId", "recoveryTask", "policyVersion"], "serviceSidePepRequired": true, "clientAuthority": "NONE"},
        "x-idempotency": {"required": true, "keyHeader": "Idempotency-Key", "strategy": "privacy-export-recovery", "replayBehavior": "same recovery task and action return the original acknowledgement"},
        "parameters": [{"$ref": "#/components/parameters/M1017ExportId"}, {"$ref": "#/components/parameters/B1IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/M1017PrivacyRecoveryCommand"}}}},
        "responses": {
          "202": {"description": "Recovery task accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/M1017PrivacyExportEnvelope"}}}},
          "401": {"$ref": "#/components/responses/ApiUnauthorized"},
          "403": {"$ref": "#/components/responses/ApiForbidden"},
          "409": {"$ref": "#/components/responses/ApiConflict"},
          "422": {"$ref": "#/components/responses/ApiUnprocessableEntity"}
        }
      }
    },
    "/api/v1/iam/account-deletions": {
      "post": {
        "tags": ["m1-017-privacy-lifecycle"],
        "summary": "Create a self-scoped account deletion request with a seven-day cooling-off period",
        "operationId": "createM1017AccountDeletionRequest",
        "security": [{"bearerAuth": []}],
        "x-owner": "iam-service",
        "x-contract": {"task": "P1R-M1-017", "canonical": true, "maturity": "D2_CONTRACT_READY", "runtimeStatus": "NOT_RUNTIME_VERIFIED", "clientAuthority": "NONE"},
        "x-authorization": {"requiredPermission": "iam.account.deletion.self", "defaultDecision": "DENY", "trustedFacts": ["verifiedPrincipal", "serverDerivedTenant", "reauthentication", "consent", "resourceOwner", "policyVersion"], "resourceOwner": "server-derived authenticated subject", "serviceSidePepRequired": true, "clientAuthority": "NONE"},
        "x-idempotency": {"required": true, "keyHeader": "Idempotency-Key", "strategy": "account-deletion-request", "replayBehavior": "same authenticated subject and request digest return the pending deletion request; a different digest is a conflict"},
        "parameters": [{"$ref": "#/components/parameters/B1IdempotencyKey"}],
