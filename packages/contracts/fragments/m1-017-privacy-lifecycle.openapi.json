        "x-authorization": {"requiredPermission": "iam.account.deletion.self.read", "defaultDecision": "DENY", "trustedFacts": ["verifiedPrincipal", "serverDerivedTenant", "resourceOwner", "policyVersion"], "resourceOwner": "server-derived deletion request subject", "serviceSidePepRequired": true, "clientAuthority": "NONE"},
        "parameters": [{"$ref": "#/components/parameters/M1017DeletionRequestId"}],
