        "tags": ["m1-017-privacy-lifecycle"],
        "summary": "Create a self-scoped privacy export request",
        "operationId": "createM1017PrivacyExport",
        "security": [{"bearerAuth": []}],
        "x-owner": "learner-service.privacy",
        "x-contract": {
          "task": "P1R-M1-017",
          "canonical": true,
          "maturity": "D2_CONTRACT_READY",
          "runtimeStatus": "NOT_RUNTIME_VERIFIED",
          "clientAuthority": "NONE"
        },
        "x-authorization": {
          "requiredPermission": "privacy.export.self",
          "defaultDecision": "DENY",
          "trustedFacts": ["verifiedPrincipal", "serverDerivedTenant", "reauthentication", "consent", "resourceOwner", "policyVersion"],
          "resourceOwner": "server-derived authenticated subject",
          "serviceSidePepRequired": true,
          "clientAuthority": "NONE"
        },
        "x-idempotency": {
          "required": true,
          "keyHeader": "Idempotency-Key",
          "strategy": "privacy-export-request",
          "replayBehavior": "same authenticated subject and request digest return the original export request; a different digest is a conflict"
        },
        "parameters": [{"$ref": "#/components/parameters/B1IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/M1017PrivacyExportRequest"}
            }
          }
        },
        "responses": {
          "202": {"description": "Privacy export request accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/M1017PrivacyExportEnvelope"}}}, "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }, "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" }, "X-API-Version": { "$ref": "#/components/headers/XApiVersion" } }},
          "401": {"$ref": "#/components/responses/ApiUnauthorized"},
          "403": {"$ref": "#/components/responses/ApiForbidden"},
          "409": {"$ref": "#/components/responses/ApiConflict"},
          "422": {"$ref": "#/components/responses/ApiUnprocessableEntity"}
        }
      }
    },
    "/api/v1/privacy/exports/{exportId}": {
      "get": {
        "tags": ["m1-017-privacy-lifecycle"],
        "summary": "Read the authenticated subject's privacy export status",
        "operationId": "getM1017PrivacyExportStatus",
