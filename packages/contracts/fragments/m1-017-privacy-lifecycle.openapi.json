        "x-authorization": {"requiredPermission": "privacy.export.self.read", "defaultDecision": "DENY", "trustedFacts": ["verifiedPrincipal", "serverDerivedTenant", "resourceOwner", "policyVersion"], "resourceOwner": "server-derived export subject", "serviceSidePepRequired": true, "clientAuthority": "NONE"},
        "parameters": [{"$ref": "#/components/parameters/M1017ExportId"}],
        "responses": {
          "200": {"description": "Current export status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/M1017PrivacyExportEnvelope"}}}, "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }, "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" }, "X-API-Version": { "$ref": "#/components/headers/XApiVersion" } }},
          "401": {"$ref": "#/components/responses/ApiUnauthorized"},
          "403": {"$ref": "#/components/responses/ApiForbidden"},
          "404": {"$ref": "#/components/responses/ApiNotFound"}
        }
      }
    },
    "/api/v1/privacy/exports/{exportId}/download": {
      "post": {
        "tags": ["m1-017-privacy-lifecycle"],
        "summary": "Issue a one-time, short-lived privacy export download grant",
        "operationId": "createM1017PrivacyExportDownloadGrant",
        "security": [{"bearerAuth": []}],
        "x-owner": "learner-service.privacy",
        "x-contract": {"task": "P1R-M1-017", "canonical": true, "maturity": "D2_CONTRACT_READY", "runtimeStatus": "NOT_RUNTIME_VERIFIED", "clientAuthority": "NONE"},
        "x-authorization": {"requiredPermission": "privacy.export.self.download", "defaultDecision": "DENY", "trustedFacts": ["verifiedPrincipal", "serverDerivedTenant", "reauthentication", "resourceOwner", "exportExpiry", "policyVersion"], "resourceOwner": "server-derived export subject", "serviceSidePepRequired": true, "clientAuthority": "NONE"},
        "x-idempotency": {"required": true, "keyHeader": "Idempotency-Key", "strategy": "privacy-export-download-grant", "replayBehavior": "same subject and ready export return the active one-time grant only while it remains valid"},
        "parameters": [{"$ref": "#/components/parameters/M1017ExportId"}, {"$ref": "#/components/parameters/B1IdempotencyKey"}],
        "responses": {
          "200": {"description": "One-time download grant", "headers": {"Cache-Control": {"schema": {"const": "no-store"}}, "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }, "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" }, "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/M1017PrivacyDownloadGrantEnvelope"}}}},
          "401": {"$ref": "#/components/responses/ApiUnauthorized"},
          "403": {"$ref": "#/components/responses/ApiForbidden"},
          "409": {"$ref": "#/components/responses/ApiConflict"},
          "410": {"description": "Export or its download window expired", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiErrorEnvelope"}}}}
        }
      }
    },
    "/api/v1/privacy/exports/{exportId}/receipt": {
