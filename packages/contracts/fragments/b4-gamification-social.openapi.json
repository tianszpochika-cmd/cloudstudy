{
  "openapi": "3.0.3",
  "info": {
    "title": "EnglishFlow B4 gamification and social API",
    "version": "4.0.0",
    "description": "B4 经验成长、六类学习游戏、Avatar、免费奖励箱、自习室、预设互动、通知和离线同步契约。Phase 1 只使用成人规则化学习事实，不启用 AI 判定或付费随机箱。"
  },
  "tags": [
    { "name": "b4-gamification", "description": "XP、Streak、任务、成就、星币、宝箱、收藏和赛季" },
    { "name": "b4-games", "description": "六类统一学习游戏会话和服务端判定" },
    { "name": "b4-avatar", "description": "Avatar、衣柜、学习空间与四档性能降级" },
    { "name": "b4-social", "description": "自习室、专注、预设互动和 WebSocket 握手" },
    { "name": "b4-infrastructure", "description": "通知、离线包和同步冲突处理" }
  ],
  "paths": {
