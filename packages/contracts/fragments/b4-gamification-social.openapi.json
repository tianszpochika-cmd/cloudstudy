    "/api/v1/gamification/seasons/{seasonId}/rewards": { "get": { "operationId": "listB4SeasonRewards", "tags": ["b4-gamification"], "parameters": [{ "$ref": "#/components/parameters/B4SeasonId" }], "responses": { "200": { "$ref": "#/components/responses/B4GenericResponse" } } } },
    "/api/v1/avatar/profile": { "get": { "operationId": "getB4AvatarProfile", "tags": ["b4-avatar"], "responses": { "200": { "$ref": "#/components/responses/B4GenericResponse" } } }, "put": { "operationId": "saveB4AvatarProfile", "tags": ["b4-avatar"], "x-idempotency": { "required": true, "strategy": "b4-avatar-profile", "keyHeader": "Idempotency-Key", "replayBehavior": "资源版本和渲染降级设置幂等保存" }, "parameters": [{ "$ref": "#/components/parameters/B4IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B4AvatarRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/B4GenericResponse" } } } },
    "/api/v1/avatar/items": { "get": { "operationId": "listB4AvatarItems", "tags": ["b4-avatar"], "responses": { "200": { "$ref": "#/components/responses/B4GenericResponse" } } } },
