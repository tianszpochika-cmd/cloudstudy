    "/api/v1/gamification/collection": { "get": { "operationId": "getB4Collection", "tags": ["b4-gamification"], "responses": { "200": { "$ref": "#/components/responses/B4GenericResponse" } } } },
    "/api/v1/gamification/catalog": { "get": { "operationId": "listB4Catalog", "tags": ["b4-gamification"], "responses": { "200": { "$ref": "#/components/responses/B4GenericResponse" } } } },
    "/api/v1/gamification/catalog/{catalogItemId}/redeem": { "post": { "operationId": "redeemB4CatalogItem", "tags": ["b4-gamification"], "x-idempotency": { "required": true, "strategy": "b4-catalog-redeem", "keyHeader": "Idempotency-Key", "replayBehavior": "星币消费和固定道具发放原子幂等" }, "parameters": [{ "$ref": "#/components/parameters/B4CatalogItemId" }, { "$ref": "#/components/parameters/B4IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/B4GenericResponse" }, "409": { "$ref": "#/components/responses/B4Conflict" } } } },
