  "components": {
    "parameters": {
      "B4IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 96 } },
      "B4IfMatch": { "name": "If-Match", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 96 } },
      "B4Cursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 128 } },
      "B4Limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "B4Id": { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/B4Id" } },
      "B4QuestId": { "name": "questId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 96 } },
      "B4AchievementCode": { "name": "achievementCode", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 96 } },
      "B4ChestGrantId": { "name": "chestGrantId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B4CatalogItemId": { "name": "catalogItemId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 96 } },
      "B4SeasonId": { "name": "seasonId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 96 } },
      "B4LoadoutId": { "name": "loadoutId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 96 } },
      "B4SessionId": { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B4RoomId": { "name": "roomId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 96 } },
      "B4FocusSessionId": { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B4RoomIdQuery": { "name": "roomId", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 96 } },
      "B4MessageId": { "name": "messageId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B4ReportId": { "name": "reportId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B4PackageId": { "name": "packageId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B4DownloadId": { "name": "downloadId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "B4EntityId": { "name": "entityId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "responses": {
      "B4GenericResponse": { "description": "B4 envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B4Envelope" } } } },
      "B4Conflict": { "description": "事实冲突或幂等冲突", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B4ErrorResponse" } } } }
    },
    "schemas": {
      "B4Id": { "type": "integer", "format": "int64", "minimum": 1 },
      "B4Envelope": { "type": "object", "required": ["requestId", "serverTime", "data"], "properties": { "requestId": { "type": "string" }, "serverTime": { "type": "string", "format": "date-time" }, "data": { "type": "object", "additionalProperties": true } } },
      "B4ErrorResponse": { "type": "object", "required": ["requestId", "error"], "properties": { "requestId": { "type": "string" }, "error": { "type": "object", "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" } } } } },
      "B4LearningEventRequest": { "type": "object", "additionalProperties": false, "required": ["sourceType", "sourceEventId"], "properties": { "sourceType": { "type": "string", "enum": ["LESSON_COMPLETE", "REVIEW_BATCH_COMPLETE", "READING_COMPLETE", "LISTENING_COMPLETE", "WRITING_SUBMISSION", "CHECKPOINT_PASS", "GAME_SESSION_QUALIFIED", "DAILY_GOAL_REACHED", "QUEST_COMPLETED", "ACHIEVEMENT_UNLOCKED", "STREAK_MILESTONE"] }, "sourceEventId": { "type": "string", "minLength": 8, "maxLength": 128 }, "resultCode": { "type": "string", "maxLength": 64 }, "ruleVersion": { "type": "string", "readOnly": true } } },
      "B4StreakSettingsRequest": { "type": "object", "additionalProperties": false, "required": ["timeZone"], "properties": { "timeZone": { "type": "string", "description": "IANA 时区，例如 Asia/Shanghai。" }, "weekendProtectionEnabled": { "type": "boolean" } } },
      "B4RescueRequest": { "type": "object", "additionalProperties": false, "properties": { "rescueMethod": { "type": "string", "enum": ["CARD", "CHALLENGE"] } } },
      "B4ShowcaseRequest": { "type": "object", "additionalProperties": false, "required": ["showcased"], "properties": { "showcased": { "type": "boolean" } } },
      "B4AvatarRequest": { "type": "object", "additionalProperties": false, "properties": { "resourceVersion": { "type": "string", "maxLength": 64 }, "renderMode": { "type": "string", "enum": ["3D", "2D_FALLBACK"] } } },
      "B4LoadoutRequest": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string", "maxLength": 120 }, "itemCodes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 96 } }, "resourceVersion": { "type": "string", "maxLength": 64 } } },
      "B4StudySpaceRequest": { "type": "object", "additionalProperties": false, "properties": { "renderMode": { "type": "string", "enum": ["3D", "2D_FALLBACK"] }, "placements": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["placementId", "itemCode"], "properties": { "placementId": { "type": "string" }, "itemCode": { "type": "string" }, "positionCode": { "type": "string" } } } } } },
      "B4GameSessionRequest": { "type": "object", "additionalProperties": false, "required": ["gameCode"], "properties": { "gameCode": { "type": "string", "enum": ["SENTENCE_TRAIN", "WORD_MATCH", "WORD_DEFENSE", "WORD_PUZZLE", "GRAMMAR_BLASTER", "CATCH_MEANING"] }, "contentVersionId": { "$ref": "#/components/schemas/B4Id" }, "performanceTier": { "type": "string", "enum": ["Ultra", "High", "Medium", "Performance"] } } },
      "B4GameEventRequest": { "type": "object", "additionalProperties": false, "required": ["eventId", "seq", "responseToken"], "properties": { "eventId": { "type": "string", "minLength": 8, "maxLength": 128 }, "seq": { "type": "integer", "minimum": 1 }, "itemCode": { "type": "string", "maxLength": 128 }, "responseToken": { "type": "string", "maxLength": 128 } } },
      "B4JoinRoomRequest": { "type": "object", "additionalProperties": false, "properties": { "seatPreference": { "type": "string", "maxLength": 32 } } },
      "B4FocusRequest": { "type": "object", "additionalProperties": false, "properties": { "action": { "type": "string", "enum": ["PAUSE", "RESUME", "COMPLETE", "AUTO_RELEASE", "HEARTBEAT"] }, "durationMinutes": { "type": "integer", "enum": [25, 45] }, "focusTagCode": { "type": "string", "maxLength": 64 }, "clientEventId": { "type": "string", "maxLength": 128 } } },
      "B4InteractionRequest": { "type": "object", "additionalProperties": false, "required": ["interactionCode"], "properties": { "interactionCode": { "type": "string", "enum": ["CHEER_UP", "STUDY_TOGETHER", "CONGRATS", "TRY_AGAIN", "TONIGHT_20_MIN"] }, "targetUserId": { "$ref": "#/components/schemas/B4Id" } } },
      "B4WsTicketRequest": { "type": "object", "additionalProperties": false, "properties": { "roomId": { "type": "string", "maxLength": 96 }, "deviceId": { "type": "string", "maxLength": 128 } } },
      "B4NotificationPreferencesRequest": { "type": "object", "additionalProperties": false, "properties": { "roomInteractions": { "type": "boolean" }, "focusReminders": { "type": "boolean" }, "system": { "type": "boolean" }, "doNotDisturb": { "type": "boolean" } } },
      "B4OfflineDownloadRequest": { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "type": "string", "enum": ["PAUSE", "RESUME", "PART_RECEIVED"] }, "partIndex": { "type": "integer", "minimum": 0 }, "etag": { "type": "string", "maxLength": 128 } } },
      "B4SyncRequest": { "type": "object", "additionalProperties": false, "required": ["clientBatchId", "events"], "properties": { "clientBatchId": { "type": "string", "minLength": 8, "maxLength": 128 }, "events": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["clientEventId", "eventType", "occurredAt"], "properties": { "clientEventId": { "type": "string" }, "eventType": { "type": "string" }, "occurredAt": { "type": "string", "format": "date-time" }, "entityId": { "type": "string" }, "entityVersion": { "type": "integer", "minimum": 0 } } } } } },
      "B4CheckpointRequest": { "type": "object", "additionalProperties": false, "required": ["entityVersion"], "properties": { "entityVersion": { "type": "integer", "minimum": 0 }, "deviceId": { "type": "string", "maxLength": 128 } } },
      "B4ReportRequest": { "type": "object", "additionalProperties": false, "required": ["reasonCode", "targetUserId"], "properties": { "reasonCode": { "type": "string", "enum": ["SPAM", "HARASSMENT", "SENSITIVE_CONTENT", "IMPERSONATION", "OTHER"] }, "targetUserId": { "$ref": "#/components/schemas/B4Id" }, "roomId": { "type": "string", "maxLength": 96 } } },
      "B4AppealRequest": { "type": "object", "additionalProperties": false, "required": ["appealCode"], "properties": { "appealCode": { "type": "string", "enum": ["FALSE_POSITIVE", "CONTEXT", "OTHER"] } } },
      "B4BlockRequest": { "type": "object", "additionalProperties": false, "required": ["targetUserId"], "properties": { "targetUserId": { "$ref": "#/components/schemas/B4Id" } } },
      "B4MuteRequest": { "type": "object", "additionalProperties": false, "required": ["targetUserId"], "properties": { "targetUserId": { "$ref": "#/components/schemas/B4Id" }, "durationSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 } } }
    }
  },
  "x-canonical-id-fields": {
    "userId": "#/components/schemas/B4Id", "questId": "#/components/schemas/B4Id", "achievementCode": "#/components/schemas/B4Id", "chestGrantId": "#/components/schemas/B4Id", "catalogItemId": "#/components/schemas/B4Id", "seasonId": "#/components/schemas/B4Id", "loadoutId": "#/components/schemas/B4Id", "sessionId": "#/components/schemas/B4Id", "roomId": "#/components/schemas/B4Id", "messageId": "#/components/schemas/B4Id", "packageId": "#/components/schemas/B4Id"
  }
}
