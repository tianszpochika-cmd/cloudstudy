  "components": {
    "parameters": {
      "B6IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "B6BuildId": {
        "name": "buildId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^b6-build-[a-z0-9-]+$"
        }
      },
      "B6RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^b6-[a-z0-9-]+-[a-z0-9-]+$"
        }
      },
      "B6ScanId": {
        "name": "scanId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^b6-security-[a-z0-9-]+$"
        }
      },
      "B6DrillId": {
        "name": "drillId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^b6-drill-[a-z0-9-]+$"
        }
      },
      "B6GateId": {
        "name": "gateId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^b6-gate-[a-z0-9-]+$"
        }
      }
    },
    "responses": {
      "B6GenericResponse": {
        "description": "B6 structured response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/B6Envelope"
            }
          }
        }
      },
      "B6NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/B6ErrorEnvelope"
            }
          }
        }
      },
      "B6Conflict": {
        "description": "State or idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/B6ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "B6Envelope": {
        "type": "object",
        "required": [
          "requestId",
          "data"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "B6ErrorEnvelope": {
        "x-superseded-by": "#/components/schemas/ApiErrorEnvelope",
        "description": "Compatibility error shape for existing platform-quality operations. New or migrated operations use ApiErrorEnvelope.",
        "type": "object",
        "required": [
          "requestId",
          "error"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/B6Error"
          }
        }
      },
      "B6Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "B6BuildRequest": {
        "type": "object",
        "required": [
          "platformCode",
          "buildVersion",
          "sourceRevision",
          "artifactRef",
          "artifactSha256",
          "artifactSizeBytes",
          "status"
        ],
        "properties": {
          "platformCode": {
            "type": "string",
            "enum": [
              "WEB",
              "H5",
              "ANDROID",
              "IOS",
              "IPAD",
              "WECHAT_MINI_PROGRAM",
              "WINDOWS_PWA"
            ]
          },
          "buildVersion": {
            "type": "string",
            "maxLength": 32
          },
          "sourceRevision": {
            "type": "string",
            "maxLength": 64
          },
          "artifactRef": {
            "type": "string",
            "maxLength": 255
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifactSizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "READY",
              "FAILED"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 24
          }
        }
      },
      "B6CompatibilityCheckRequest": {
        "type": "object",
        "required": [
          "buildId",
          "platformCode",
          "viewportCode",
          "orientation",
          "overflowCount",
          "keyboardReachable",
          "touchTargetFailures",
          "resultCode",
          "evidenceRef"
        ],
        "properties": {
          "buildId": {
            "type": "string"
          },
          "platformCode": {
            "type": "string"
          },
          "viewportCode": {
            "type": "string",
            "maxLength": 32
          },
          "orientation": {
            "type": "string",
            "enum": [
              "PORTRAIT",
              "LANDSCAPE",
              "BOTH"
            ]
          },
          "overflowCount": {
            "type": "integer",
            "minimum": 0
          },
          "keyboardReachable": {
            "type": "boolean"
          },
          "touchTargetFailures": {
            "type": "integer",
            "minimum": 0
          },
          "resultCode": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidenceRef": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "B6E2ERunRequest": {
        "type": "object",
        "required": [
          "scenarioCode",
          "surface",
          "platformCode",
          "sourceRevision",
          "status",
          "passedCount",
          "failedCount",
          "evidenceRef"
        ],
        "properties": {
          "scenarioCode": {
            "type": "string",
            "maxLength": 80
          },
          "surface": {
            "type": "string",
            "enum": [
              "ONBOARDING",
              "LEARNING_LOOP",
              "CONTENT_VISIBILITY",
              "COMMERCE"
            ]
          },
          "platformCode": {
            "type": "string"
          },
          "sourceRevision": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "SKIPPED"
            ]
          },
          "passedCount": {
            "type": "integer",
            "minimum": 0
          },
          "failedCount": {
            "type": "integer",
            "minimum": 0
          },
          "evidenceRef": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "B6SecurityScanRequest": {
        "type": "object",
        "required": [
          "scanType",
          "sourceRevision",
          "ruleVersion",
          "status",
          "criticalCount",
          "highCount",
          "mediumCount",
          "sensitiveFindingCount",
          "reportRef"
        ],
        "properties": {
          "scanType": {
            "type": "string",
            "enum": [
              "AUTHORIZATION",
              "DEPENDENCY",
              "SECRET",
              "PRIVACY",
              "CONTRACT"
            ]
          },
          "sourceRevision": {
            "type": "string",
            "maxLength": 64
          },
          "ruleVersion": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "criticalCount": {
            "type": "integer",
            "minimum": 0
          },
          "highCount": {
            "type": "integer",
            "minimum": 0
          },
