{
  "openapi": "3.0.3",
  "info": {
    "title": "EnglishFlow B6 platform, quality and release API",
    "version": "6.0.0",
    "description": "B6 cross-platform build, responsive/accessibility evidence, quality runs, observability, data recovery and release gate contracts. Device execution and real store publication remain test-stage activities."
  },
  "tags": [
    {
      "name": "b6-platform",
      "description": "跨端构建、设备矩阵、响应式、无障碍和性能预算"
    },
    {
      "name": "b6-quality",
      "description": "端到端、安全和可靠性质量运行记录"
    },
    {
      "name": "b6-observability",
      "description": "业务指标、告警和 requestId 关联看板"
    },
    {
      "name": "b6-data-reliability",
      "description": "备份、恢复、回滚和 RTO/RPO 演练记录"
    },
    {
      "name": "b6-release",
      "description": "发布候选和上线 Gate 评估"
    }
  ],
