  "components": {
    "schemas": {
      "B1AnyData": {
        "type": "object",
        "additionalProperties": true
      },
      "B1DeviceInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceId",
          "deviceType",
          "clientVersion"
        ],
        "x-sensitive-fields": [
          "deviceId"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "设备公开 ID 不得为硬件指纹原文；仅允许 hash/不可逆公开标识进入日志。"
          },
          "deviceType": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          },
          "clientVersion": {
            "type": "string"
          },
          "regionCode": {
            "type": "string"
          }
        }
      },
      "B1LogoutRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allDevices": {
            "type": "boolean"
          }
        }
      },
      "B1OnboardingProfileRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Legacy wire shape retained only for the B9 adapter; the request cannot establish identity, ownership, tenant, gate, consent, policy or server versions.",
        "x-compatibility-only": true,
        "x-p1r-b9-target-mapping": {
          "sourceField": "targetGoal",
          "dailyQuotaField": "dailyQuotaMinutes",
          "expectedStateVersionField": "expectedVersion",
          "missingOrUnknownDecision": "DENY_WITH_422",
          "dailyQuotaMinutes": [
            5,
            15,
            30,
            45
          ],
          "mappings": [
            {
              "legacyTargetGoal": "ZERO_BASIS",
              "goalCode": "FOUNDATION",
              "targetLevel": "A1"
            },
            {
              "legacyTargetGoal": "CET_4_6",
              "goalCode": "COLLEGE_CET",
              "targetLevel": "B1"
            },
            {
              "legacyTargetGoal": "POSTGRADUATE",
              "goalCode": "POSTGRADUATE_ENGLISH",
              "targetLevel": "B2"
            },
            {
              "legacyTargetGoal": "WORKPLACE_DAILY",
              "goalCode": "WORKPLACE_DAILY",
              "targetLevel": "B2"
            }
          ]
        },
        "x-forbidden-client-fields": [
          "principalId",
          "tenantId",
          "ownerId",
          "role",
          "permissions",
          "adultGate",
          "consent",
          "policyVersion",
          "contentRights",
          "profileVersion",
          "targetVersion",
          "preferenceVersion",
          "stateVersion"
        ],
        "required": [
          "targetGoal",
          "dailyQuotaMinutes"
        ],
        "properties": {
          "language": {
            "type": "string"
          },
          "targetGoal": {
            "type": "string",
            "enum": [
              "ZERO_BASIS",
              "CET_4_6",
              "POSTGRADUATE",
              "WORKPLACE_DAILY"
            ]
          },
          "examType": {
            "type": "string"
          },
          "dailyQuotaMinutes": {
            "type": "integer",
            "enum": [
              5,
              15,
              30,
              45
            ]
          },
          "preferenceTags": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          },
          "accentPreference": {
            "type": "string"
          },
          "customHomeLayout": {
            "type": "boolean"
          },
          "customHomeLayoutOrder": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "B1PlacementSkipRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fastTrackLevel": {
            "type": "string",
            "enum": [
              "ZERO_A1",
              "CET4_B1",
              "CET6_B2",
              "POSTGRAD_B2_PLUS"
            ]
          }
        }
      }
    }
  }
}
