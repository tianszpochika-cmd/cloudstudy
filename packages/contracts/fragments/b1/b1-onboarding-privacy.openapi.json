        "responses": {
          "200": {
            "description": "Placement session state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/B1AssessmentReadResponse"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/XTraceId"
              },
              "X-API-Version": {
                "$ref": "#/components/headers/XApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ApiForbidden"
          },
          "404": {
            "$ref": "#/components/responses/ApiNotFound"
          }
        }
      },
      "post": {
        "tags": [
          "b1-onboarding"
        ],
        "summary": "Start a deterministic placement session",
        "operationId": "startPlacementSession",
        "deprecated": true,
        "x-p1r-deprecation": {
          "deprecationAt": "2026-08-30T00:00:00Z",
          "sunsetAt": "UNSCHEDULED_UNTIL_DECLARED_REPLACEMENT_RUNTIME_GATE_ACCEPTED",
          "migrationLink": "/api/v1/assessment/placement/sessions"
        },
        "x-p1r-b10-placement-adapter": {
          "adapterOnly": true,
          "legacyWirePreserved": true,
          "canonicalOperationId": "createB10PlacementSession",
          "canonicalRoute": "/api/v1/assessment/placement/sessions",
          "serverDerivedBinding": "bodyless legacy start derives subject, tenant, eligibility, target and immutable placement pins on the server",
          "newCanonicalFactsFromLegacyPayload": "PROHIBITED",
          "runtimeStatus": "NOT_RUNTIME_VERIFIED"
        },
        "x-authorization": {
          "requiredPermission": "assessment.placement.session.create",
          "defaultDecision": "DENY",
          "trustedFacts": [
            "subject",
            "tenant",
            "adultGate",
            "phase",
            "contentRights",
            "entitlement",
            "resourceOwner",
            "policyVersion"
          ],
          "resourceOwner": "server-derived placement session owner",
          "serviceSidePepRequired": true,
          "legacyAuthorizationBypass": "PROHIBITED"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-b1-acceptance": [
          "B1-ASSESSMENT-VERSION-REPLAY",
          "B1-FIRST-DAY-E2E-READINESS"
        ],
        "x-idempotency": {
          "required": true,
          "strategy": "assessment-session",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "same user and assessment version returns the original session"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/B1IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Placement session started",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/B1AssessmentStartResponse"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/XTraceId"
              },
              "X-API-Version": {
                "$ref": "#/components/headers/XApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ApiForbidden"
          },
          "409": {
            "$ref": "#/components/responses/ApiConflict"
          },
          "422": {
            "$ref": "#/components/responses/ApiUnprocessableEntity"
          }
        }
      }
    },
    "/api/v1/assessment/placement/submit-step": {
      "post": {
        "tags": [
          "b1-onboarding"
        ],
        "summary": "Submit one placement item with replay-safe idempotency",
        "operationId": "submitPlacementStep",
        "deprecated": true,
        "x-p1r-deprecation": {
          "deprecationAt": "2026-08-30T00:00:00Z",
          "sunsetAt": "UNSCHEDULED_UNTIL_DECLARED_REPLACEMENT_RUNTIME_GATE_ACCEPTED",
          "migrationLink": "/api/v1/assessment/placement/sessions/{sessionId}/responses"
        },
        "x-p1r-b10-placement-adapter": {
          "adapterOnly": true,
          "legacyWirePreserved": true,
          "canonicalOperationId": "submitB10PlacementResponse",
          "canonicalRoute": "/api/v1/assessment/placement/sessions/{sessionId}/responses",
          "serverDerivedBinding": "legacy session and item context resolve to the canonical path and immutable server-owned assessment pins",
          "newCanonicalFactsFromLegacyPayload": "PROHIBITED",
          "runtimeStatus": "NOT_RUNTIME_VERIFIED"
        },
        "x-authorization": {
          "requiredPermission": "assessment.placement.response.submit",
          "defaultDecision": "DENY",
          "trustedFacts": [
            "subject",
            "tenant",
            "adultGate",
            "phase",
            "contentRights",
            "entitlement",
            "resourceOwner",
            "policyVersion"
          ],
          "resourceOwner": "server-derived placement session owner",
          "serviceSidePepRequired": true,
          "legacyAuthorizationBypass": "PROHIBITED"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-b1-acceptance": [
          "B1-ASSESSMENT-ITEM-IDEMPOTENCY",
          "B1-ASSESSMENT-DETERMINISM"
        ],
        "x-idempotency": {
          "required": true,
          "strategy": "assessment-session-item",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "same session, version, item and request hash returns the original score"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/B1IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/B1AssessmentStepRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item scored or session completed",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/B1AssessmentStepResponse"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/XTraceId"
              },
              "X-API-Version": {
                "$ref": "#/components/headers/XApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/ApiUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ApiForbidden"
          },
          "409": {
            "$ref": "#/components/responses/ApiConflict"
          },
          "422": {
            "$ref": "#/components/responses/ApiUnprocessableEntity"
          }
        }
      }
    },
    "/api/v1/privacy/export": {
      "post": {
        "tags": [
          "b1-privacy"
        ],
        "summary": "Create a self-scoped, masked privacy export",
        "operationId": "createPrivacyExport",
        "deprecated": true,
        "x-p1r-deprecation": {
          "deprecationAt": "2026-09-01T00:00:00Z",
          "sunsetAt": "UNSCHEDULED_UNTIL_DECLARED_REPLACEMENT_RUNTIME_GATE_ACCEPTED",
          "migrationLink": "/api/v1/privacy/exports"
        },
        "x-migration": {
          "canonicalOperationId": "createM1017PrivacyExport",
          "canonicalRoute": "/api/v1/privacy/exports",
          "adapterOnly": true,
          "legacyWirePreserved": true,
          "newCanonicalFactsFromLegacyPayload": "PROHIBITED",
          "runtimeStatus": "NOT_RUNTIME_VERIFIED"
        },
        "x-contract": {
          "canonical": false,
          "classification": "HISTORICAL_B1_ADAPTER_ONLY",
          "successorTask": "P1R-M1-017",
          "clientAuthority": "NONE"
        },
        "x-authorization": {
          "requiredPermission": "privacy.export.self",
          "defaultDecision": "DENY",
          "trustedFacts": [
            "verifiedPrincipal",
            "serverDerivedTenant",
            "reauthentication",
            "consent",
            "resourceOwner",
            "policyVersion"
          ],
          "resourceOwner": "server-derived authenticated subject",
          "serviceSidePepRequired": true,
          "clientAuthority": "NONE"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-b1-acceptance": [
          "B1-PRIVACY-EXPORT-MASKING",
          "B1-SCOPE-CROSS-TENANT-USER"
        ],
        "x-idempotency": {
          "required": true,
          "strategy": "privacy-export",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "same subject and policy returns the original export job"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/B1IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/B1PrivacyExportRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Export accepted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/B1PrivacyExportResponse"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/XTraceId"
              },
              "X-API-Version": {
                "$ref": "#/components/headers/XApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/ApiUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ApiForbidden"
          },
          "409": {
            "$ref": "#/components/responses/ApiConflict"
          }
        }
      }
    },
    "/api/v1/privacy/export/{exportId}": {
      "get": {
        "tags": [
          "b1-privacy"
        ],
        "summary": "Read own privacy export status with on-read expiry (M6-007 live)",
        "operationId": "readPrivacyExportStatus",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "exportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/privacy/export/{exportId}/download": {
      "get": {
        "tags": [
          "b1-privacy"
        ],
        "summary": "Fetch the download descriptor of a READY export (M6-007 live)",
        "operationId": "readPrivacyExportDownload",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "exportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "B1OnboardingBadRequest": {
        "description": "Invalid B1 request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/B1ErrorResponse"
            }
          }
        }
      },
      "B1OnboardingUnauthorized": {
        "description": "Missing or revoked credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/B1ErrorResponse"
            }
          }
        }
      },
      "B1OnboardingForbidden": {
        "description": "Scope or role denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/B1ErrorResponse"
            }
          }
        }
      },
      "B1OnboardingNotFound": {
        "description": "Resource not found in actor scope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/B1ErrorResponse"
            }
          }
        }
      },
      "B1OnboardingConflict": {
        "description": "Version, idempotency or session conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/B1ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "B1ErrorResponse": {
        "x-superseded-by": "#/components/schemas/ApiErrorEnvelope",
        "description": "Compatibility error shape for existing onboarding operations. New or migrated operations use ApiErrorEnvelope.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "traceId",
          "error"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "traceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "errorCode",
              "message",
              "retryable"
            ],
            "properties": {
              "errorCode": {
                "type": "string",
                "enum": [
                  "AUTH_REQUIRED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "B1AssessmentReadResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "status": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "contentVersionId": {
            "type": "string"
          },
          "currentQuestion": {},
          "nextQuestion": {},
          "report": {},
          "isCompleted": {
            "type": "boolean"
          }
        }
      },
      "B1AssessmentStartResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "assessmentVersionId",
          "questionId",
          "rulesVersion"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "assessmentVersionId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "questionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "rulesVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "B1AssessmentStepRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "assessmentVersionId",
          "questionId",
          "answer",
          "timeSpentSec"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "assessmentVersionId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "questionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "只接受答案键，不保存答案原文"
          },
          "timeSpentSec": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          }
        }
      },
      "B1AssessmentStepResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attemptId",
          "questionId",
          "scoreBucket",
          "deduplicated"
        ],
        "properties": {
          "attemptId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "questionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "scoreBucket": {
            "type": "string",
            "enum": [
              "ZERO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "FULL",
              "WITHHELD"
            ]
          },
          "deduplicated": {
            "type": "boolean"
          }
        }
      },
      "B1DeviceListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "devices"
        ],
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/B1Device"
            }
          }
        }
      },
      "B1Device": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceId",
          "sessionId",
          "status",
          "lastActiveAt"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "pattern": "^dev_[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$"
          },
          "sessionId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "REVOKED"
            ]
          },
          "lastActiveAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "B1KickoutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceId",
          "reasonCode"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "pattern": "^dev_[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$"
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "KICKED",
              "RISK_FREEZE",
              "ADMIN"
            ]
          }
        }
      },
      "B1PrivacyExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policyName",
          "reauthenticationRef"
        ],
        "properties": {
          "policyName": {
            "type": "string",
            "enum": [
              "learner-self"
            ]
          },
          "reauthenticationRef": {
            "type": "string",
            "pattern": "^reauth_[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
          }
        }
      },
      "B1PrivacyExportResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exportId",
          "status",
          "redactionPolicy"
        ],
        "properties": {
          "exportId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "READY",
              "FAILED"
            ]
          },
          "redactionPolicy": {
            "type": "string",
            "const": "learner-self"
          }
        }
      }
    }
  }
}
