{
  "tags": [
    {
      "name": "b1-onboarding",
      "description": "B1 deterministic placement and first-day readiness"
    },
    {
      "name": "b1-privacy",
      "description": "B1 device and self-scoped privacy operations"
    }
  ],
  "paths": {
    "/api/v1/assessment/placement/start": {
      "get": {
        "tags": [
          "b1-onboarding"
        ],
        "summary": "Read the learner's current placement session",
        "operationId": "readPlacementSession",
        "deprecated": true,
        "x-p1r-deprecation": {
          "deprecationAt": "2026-08-30T00:00:00Z",
          "sunsetAt": "UNSCHEDULED_UNTIL_DECLARED_REPLACEMENT_RUNTIME_GATE_ACCEPTED",
          "migrationLink": "/api/v1/assessment/placement/sessions/{sessionId}"
        },
        "x-p1r-b10-placement-adapter": {
          "adapterOnly": true,
          "legacyWirePreserved": true,
          "canonicalOperationId": "getB10PlacementSession",
          "canonicalRoute": "/api/v1/assessment/placement/sessions/{sessionId}",
          "serverDerivedBinding": "legacy query sessionId or current self-scoped session resolves to canonical path sessionId",
