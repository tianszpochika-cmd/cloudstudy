{
  "openapi": "3.0.3",
  "info": { "title": "语学星 B11 Media Notification Offline API", "version": "1.0.0", "description": "B11 media authorization, notification, offline recovery and B3 compatibility boundary." },
  "tags": [
    { "name": "B11-Media", "description": "媒体元数据、manifest、访问授权和撤回" },
    { "name": "B11-Notification", "description": "通知偏好、消息和已读状态" },
    { "name": "B11-Offline", "description": "离线变更、cursor、冲突和恢复" },
    { "name": "B11-Compatibility", "description": "B3 legacy read/shadow compatibility" }
  ],
  "paths": {
    "/api/v1/media/assets/{assetId}": {
      "get": { "tags": ["B11-Media"], "operationId": "getB11MediaAsset", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11AssetId" }], "responses": { "200": { "description": "媒体元数据", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaAsset" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" }, "404": { "$ref": "#/components/responses/B11NotFound" } } }
    },
    "/api/v1/media/assets/{assetId}/manifest": {
      "get": { "tags": ["B11-Media"], "operationId": "getB11MediaManifest", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11AssetId" }], "responses": { "200": { "description": "不可变媒体 manifest", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaManifest" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" }, "410": { "description": "媒体版权或版本已撤回" } } }
    },
    "/api/v1/media/assets/{assetId}/signed-url": {
      "post": { "tags": ["B11-Media"], "operationId": "createB11MediaAccess", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11AssetId" }, { "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaAccessRequest" } } } }, "x-idempotency": { "required": true, "strategy": "tenant-principal-request-hash", "replayBehavior": "return-original-until-expiry" }, "responses": { "200": { "description": "短时访问引用", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11SignedMediaUrl" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" }, "409": { "$ref": "#/components/responses/B11Conflict" }, "410": { "description": "媒体授权已撤回或过期" } } }
    },
    "/api/v1/media/assets/{assetId}/content": {
      "get": { "tags": ["B11-Media"], "operationId": "streamB11MediaContent", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11AssetId" }, { "$ref": "#/components/parameters/B11Range" }], "responses": { "206": { "description": "Range 元数据和短时内容引用", "headers": { "Content-Range": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaContentRange" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" }, "416": { "description": "Range 越界或格式不支持" }, "410": { "description": "媒体已撤回" } } }
    },
    "/api/v1/learning/media-progress": {
      "put": { "tags": ["B11-Media"], "operationId": "updateB11MediaProgress", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaProgressRequest" } } } }, "x-contract": { "owner": "learning-service", "writeModel": "b3_learning_interaction", "tenantAndOwner": "server-derived from verified JWT" }, "x-idempotency": { "required": true, "strategy": "media-asset-position-client-event", "replayBehavior": "return-first-durable-media-progress" }, "responses": { "200": { "description": "媒体进度已写入 learning-service owner schema", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaProgressReceipt" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" }, "409": { "$ref": "#/components/responses/B11Conflict" } } }
    },
    "/internal/v1/media/assets/{assetId}/revoke": {
      "post": { "tags": ["B11-Media"], "operationId": "revokeB11MediaAsset", "security": [{ "B8WorkloadIdentity": [] }], "parameters": [{ "$ref": "#/components/parameters/B11AssetId" }, { "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaRevocation" } } } }, "x-idempotency": { "required": true, "strategy": "asset-version-idempotency-key", "replayBehavior": "return-revocation-fact" }, "responses": { "202": { "description": "撤回事实已接受" }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" } } }
    },
    "/internal/v1/compatibility/b11/media-assets/{assetId}": {
      "get": { "tags": ["B11-Compatibility"], "operationId": "getB11MediaCompatibility", "security": [{ "B8WorkloadIdentity": [] }], "parameters": [{ "$ref": "#/components/parameters/B11AssetId" }], "responses": { "200": { "description": "B3 legacy read/shadow 摘要", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaCompatibility" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" } } }
    },
    "/internal/v1/compatibility/b11/media-assets/reconciliations": {
      "post": { "tags": ["B11-Compatibility"], "operationId": "createB11MediaReconciliation", "security": [{ "B8WorkloadIdentity": [] }], "parameters": [{ "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaCompatibility" } } } }, "x-idempotency": { "required": true, "strategy": "legacy-ref-hash-idempotency-key", "replayBehavior": "return-reconciliation-fact" }, "responses": { "202": { "description": "对账已接受" }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" } } }
    },
    "/internal/v1/compatibility/b11/media-assets/{assetId}/migrations": {
      "post": { "tags": ["B11-Compatibility"], "operationId": "createB11MediaMigration", "security": [{ "B8WorkloadIdentity": [] }], "parameters": [{ "$ref": "#/components/parameters/B11AssetId" }, { "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MediaMigration" } } } }, "x-idempotency": { "required": true, "strategy": "asset-version-idempotency-key", "replayBehavior": "return-migration-fact" }, "responses": { "202": { "description": "迁移已接受" }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" } } }
    },
    "/api/v1/settings/notifications": {
      "get": { "tags": ["B11-Notification"], "operationId": "getB11NotificationPreference", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "当前主体偏好", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11NotificationPreference" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" } } },
      "put": { "tags": ["B11-Notification"], "operationId": "updateB11NotificationPreference", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11NotificationPreference" } } } }, "x-idempotency": { "required": true, "strategy": "preference-version-idempotency-key", "replayBehavior": "return-new-version" }, "responses": { "200": { "description": "更新后的偏好", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11NotificationPreference" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "409": { "$ref": "#/components/responses/B11Conflict" } } }
    },
    "/api/v1/messages": {
      "get": { "tags": ["B11-Notification"], "operationId": "listB11Messages", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "当前主体消息", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11MessagePage" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" } } }
    },
    "/api/v1/messages/{messageId}/read": {
      "post": { "tags": ["B11-Notification"], "operationId": "markB11MessageRead", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11MessageId" }, { "$ref": "#/components/parameters/B11IdempotencyKey" }], "x-idempotency": { "required": true, "strategy": "message-id-principal-idempotency-key", "replayBehavior": "return-read-fact" }, "responses": { "204": { "description": "已读事实已记录" }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "404": { "$ref": "#/components/responses/B11NotFound" } } }
    },
    "/api/v1/sync/changes": {
      "post": { "tags": ["B11-Offline"], "operationId": "enqueueB11SyncChanges", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11SyncEnqueueRequest" } } } }, "x-idempotency": { "required": true, "strategy": "client-event-id-idempotency-key", "replayBehavior": "return-accepted-and-conflicts" }, "responses": { "200": { "description": "同步回执", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11SyncReceipt" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" }, "409": { "$ref": "#/components/responses/B11Conflict" }, "507": { "description": "设备存储不足" } } },
      "get": { "tags": ["B11-Offline"], "operationId": "listB11SyncChanges", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "增量同步事实", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11SyncReceipt" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" } } }
    },
    "/api/v1/sync/cursor": {
      "get": { "tags": ["B11-Offline"], "operationId": "getB11SyncCursor", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "同步 cursor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11VectorClock" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" } } },
      "put": { "tags": ["B11-Offline"], "operationId": "updateB11SyncCursor", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11VectorClock" } } } }, "x-idempotency": { "required": true, "strategy": "cursor-version-idempotency-key", "replayBehavior": "return-cursor" }, "responses": { "200": { "description": "更新后的 cursor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11VectorClock" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "409": { "$ref": "#/components/responses/B11Conflict" } } }
    },
    "/api/v1/sync/conflicts": {
      "get": { "tags": ["B11-Offline"], "operationId": "listB11SyncConflicts", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "未解决冲突", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11SyncConflictPage" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" } } }
    },
    "/api/v1/sync/conflicts/{conflictId}/recovery": {
      "post": { "tags": ["B11-Offline"], "operationId": "recoverB11SyncConflict", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11ConflictId" }, { "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11SyncRecovery" } } } }, "x-idempotency": { "required": true, "strategy": "conflict-id-recovery-key", "replayBehavior": "return-recovery-state" }, "responses": { "202": { "description": "恢复任务已接受" }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" }, "409": { "$ref": "#/components/responses/B11Conflict" } } }
    },
    "/internal/v1/compatibility/b11/offline": {
      "post": { "tags": ["B11-Compatibility"], "operationId": "createB11OfflineCompatibility", "security": [{ "B8WorkloadIdentity": [] }], "parameters": [{ "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11OfflineCompatibility" } } } }, "x-idempotency": { "required": true, "strategy": "legacy-event-hash-idempotency-key", "replayBehavior": "return-compatibility-fact" }, "responses": { "202": { "description": "兼容记录已接受" }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" } } }
    },
    "/api/v1/multimodal/recordings": {
      "post": { "tags": ["B11-Media"], "operationId": "createB11Recording", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11RecordingMetadata" } } } }, "x-idempotency": { "required": true, "strategy": "recording-id-client-event-id", "replayBehavior": "return-recording-reference" }, "responses": { "202": { "description": "录音元数据已接受", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11RecordingMetadata" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" } } }
    },
    "/api/v1/speaking/shadowing/completions": {
      "post": { "tags": ["B11-Media"], "operationId": "updateB11ShadowingCompletion", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/B11IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11ShadowingCompletionRequest" } } } }, "x-contract": { "owner": "learning-service", "writeModel": "b3_learning_interaction", "aiScoring": "disabled in Phase 1" }, "x-idempotency": { "required": true, "strategy": "shadowing-source-segment-client-event", "replayBehavior": "return-first-durable-shadowing-completion" }, "responses": { "200": { "description": "跟读完成事实已写入 learning-service owner schema", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11ShadowingCompletionReceipt" } } } }, "401": { "$ref": "#/components/responses/B11Unauthorized" }, "403": { "$ref": "#/components/responses/B11Forbidden" }, "409": { "$ref": "#/components/responses/B11Conflict" } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }, "B8WorkloadIdentity": { "type": "http", "scheme": "bearer", "bearerFormat": "OIDC workload identity" } },
    "parameters": {
      "B11AssetId": { "name": "assetId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^med_[A-Za-z0-9._:-]{8,127}$" } },
      "B11MessageId": { "name": "messageId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^msg_[A-Za-z0-9._:-]{8,127}$" } },
      "B11ConflictId": { "name": "conflictId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^conf_[A-Za-z0-9._:-]{8,127}$" } },
      "B11IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 192 } },
      "B11Range": { "name": "Range", "in": "header", "required": false, "schema": { "type": "string", "pattern": "^bytes=(\\d*-\\d*)$" }, "description": "只支持单一 bytes Range；越界返回 416。" }
    },
    "responses": {
      "B11Unauthorized": { "description": "未认证", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11Error" } } } },
      "B11Forbidden": { "description": "默认拒绝的租户、主体、版权或策略访问", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11Error" } } } },
      "B11NotFound": { "description": "不存在或对当前主体不可见", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11Error" } } } },
      "B11Conflict": { "description": "幂等、版本或冲突恢复拒绝", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B11Error" } } } }
    },
    "schemas": {
      "B11Error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string", "enum": ["unauthorized", "forbidden", "not_found", "conflict", "rights_revoked", "range_invalid", "storage_full"] }, "message": { "type": "string", "maxLength": 256 }, "retryable": { "type": "boolean" } } },
      "B11CanonicalInt64Id": { "type": "integer", "format": "int64", "minimum": 1 },
      "B11Range": { "type": "object", "additionalProperties": false, "required": ["start", "endInclusive", "totalBytes"], "properties": { "start": { "type": "integer", "format": "int64", "minimum": 0 }, "endInclusive": { "type": "integer", "format": "int64", "minimum": 0 }, "totalBytes": { "type": "integer", "format": "int64", "minimum": 1 } } },
      "B11MediaAsset": { "type": "object", "additionalProperties": false, "required": ["assetId", "contentVersionId", "mediaType", "mimeType", "checksumSha256", "byteLength", "assetVersion", "rightsStatus", "storageStatus"], "properties": { "assetId": { "type": "string", "pattern": "^med_[A-Za-z0-9._:-]{8,127}$" }, "contentVersionId": { "$ref": "#/components/schemas/B11CanonicalInt64Id" }, "mediaType": { "type": "string", "maxLength": 32 }, "mimeType": { "type": "string", "maxLength": 96 }, "checksumSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$", "description": "只传校验摘要；媒体对象不在 API 响应中。" }, "byteLength": { "type": "integer", "format": "int64", "minimum": 0 }, "durationMs": { "type": "integer", "format": "int64", "minimum": 0 }, "assetVersion": { "type": "integer", "format": "int64", "minimum": 1 }, "rightsStatus": { "type": "string", "enum": ["PUBLISHED", "RESTRICTED", "EXPIRED", "REVOKED"] }, "storageStatus": { "type": "string", "enum": ["PROCESSING", "READY", "FAILED", "REVOKED", "DELETED"] } } },
      "B11MediaManifest": { "type": "object", "additionalProperties": false, "required": ["assetId", "assetVersion", "manifestHash", "contentVersionId", "items"], "properties": { "assetId": { "type": "string", "pattern": "^med_[A-Za-z0-9._:-]{8,127}$" }, "assetVersion": { "type": "integer", "minimum": 1 }, "manifestHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "contentVersionId": { "$ref": "#/components/schemas/B11CanonicalInt64Id" }, "items": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/components/schemas/B11MediaManifestItem" } } } },
      "B11MediaManifestItem": { "type": "object", "additionalProperties": false, "required": ["segmentId", "renditionId", "startMs", "endMs", "segmentHash"], "properties": { "segmentId": { "type": "string", "maxLength": 128 }, "renditionId": { "type": "string", "maxLength": 128 }, "startMs": { "type": "integer", "minimum": 0 }, "endMs": { "type": "integer", "minimum": 1 }, "segmentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } } },
      "B11MediaAccessRequest": { "type": "object", "additionalProperties": false, "required": ["renditionId", "contentVersionId"], "properties": { "renditionId": { "type": "string", "maxLength": 128 }, "contentVersionId": { "$ref": "#/components/schemas/B11CanonicalInt64Id" } } },
      "B11SignedMediaUrl": { "type": "object", "additionalProperties": false, "required": ["assetId", "renditionId", "reference", "expiresAt", "checksumSha256"], "properties": { "assetId": { "type": "string", "maxLength": 128 }, "renditionId": { "type": "string", "maxLength": 128 }, "reference": { "type": "string", "format": "uri", "maxLength": 2048, "description": "短时授权引用；不得写入日志或事件。" }, "expiresAt": { "type": "string", "format": "date-time" }, "checksumSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } } },
      "B11MediaContentRange": { "type": "object", "additionalProperties": false, "required": ["assetId", "renditionId", "range", "reference", "expiresAt"], "properties": { "assetId": { "type": "string", "maxLength": 128 }, "renditionId": { "type": "string", "maxLength": 128 }, "range": { "$ref": "#/components/schemas/B11Range" }, "reference": { "type": "string", "format": "uri", "maxLength": 2048 }, "expiresAt": { "type": "string", "format": "date-time" } } },
      "B11MediaRevocation": { "type": "object", "additionalProperties": false, "required": ["reasonCode", "expectedAssetVersion", "rightsStatus"], "properties": { "reasonCode": { "type": "string", "maxLength": 64 }, "expectedAssetVersion": { "type": "integer", "minimum": 1 }, "rightsStatus": { "type": "string", "const": "REVOKED" } } },
      "B11MediaMigration": { "type": "object", "additionalProperties": false, "required": ["legacyManifestHash", "targetManifestHash", "domainFactsUntouched"], "properties": { "legacyManifestHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "targetManifestHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "domainFactsUntouched": { "type": "boolean", "const": true } } },
      "B11NotificationPreference": { "type": "object", "additionalProperties": false, "required": ["enabledChannels", "learningReminders", "marketing", "version", "expectedVersion"], "properties": { "enabledChannels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["IN_APP", "EMAIL", "PUSH"] } }, "learningReminders": { "type": "boolean" }, "marketing": { "type": "boolean" }, "version": { "type": "integer", "minimum": 1 }, "expectedVersion": { "type": "integer", "minimum": 1 } } },
      "B11Message": { "type": "object", "additionalProperties": false, "required": ["messageId", "templateKey", "templateVersion", "locale", "channel", "dedupeKey", "createdAt", "read"], "properties": { "messageId": { "type": "string", "maxLength": 128 }, "templateKey": { "type": "string", "maxLength": 128 }, "templateVersion": { "type": "string", "maxLength": 32 }, "locale": { "type": "string", "maxLength": 16 }, "channel": { "type": "string", "enum": ["IN_APP", "EMAIL", "PUSH"] }, "dedupeKey": { "type": "string", "maxLength": 192 }, "createdAt": { "type": "string", "format": "date-time" }, "read": { "type": "boolean" } } },
      "B11MessagePage": { "type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": { "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/B11Message" } }, "nextCursor": { "type": "string", "maxLength": 128 } } },
      "B11VectorClock": { "type": "object", "additionalProperties": false, "required": ["cursor", "vector", "version"], "properties": { "cursor": { "type": "string", "maxLength": 128 }, "vector": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }, "version": { "type": "integer", "minimum": 0 } } },
      "B11SyncChange": { "type": "object", "additionalProperties": false, "required": ["clientEventId", "clientSeq", "entityType", "entityId", "entityVersion", "operation", "payloadHash", "contentVersion", "occurredAt"], "properties": { "clientEventId": { "type": "string", "minLength": 8, "maxLength": 128 }, "clientSeq": { "type": "integer", "minimum": 1 }, "entityType": { "type": "string", "maxLength": 64 }, "entityId": { "type": "string", "maxLength": 128 }, "entityVersion": { "type": "integer", "minimum": 1 }, "operation": { "type": "string", "enum": ["UPSERT", "DELETE", "APPEND"] }, "payloadHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$", "description": "只传 hash，不传离线原文。" }, "contentVersion": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "integer", "minimum": 1 }] }, "occurredAt": { "type": "string", "format": "date-time" } } },
