      "B11SyncReceipt": { "type": "object", "additionalProperties": false, "required": ["nextCursor", "acceptedEventIds", "conflicts"], "properties": { "nextCursor": { "type": "string", "maxLength": 128 }, "acceptedEventIds": { "type": "array", "items": { "type": "string", "maxLength": 128 } }, "conflicts": { "type": "array", "items": { "$ref": "#/components/schemas/B11SyncConflict" } } } },
      "B11SyncConflict": { "type": "object", "additionalProperties": false, "required": ["conflictId", "clientEventId", "entityId", "localVersion", "serverVersion", "resolutionCode", "reason"], "properties": { "conflictId": { "type": "string", "maxLength": 128 }, "clientEventId": { "type": "string", "maxLength": 128 }, "entityId": { "type": "string", "maxLength": 128 }, "localVersion": { "type": "integer", "minimum": 1 }, "serverVersion": { "type": "integer", "minimum": 1 }, "resolutionCode": { "type": "string", "enum": ["SERVER_VERSION_WINS", "CLIENT_RETRY_REQUIRED", "MANUAL_RECOVERY"] }, "reason": { "type": "string", "maxLength": 256 } } },
