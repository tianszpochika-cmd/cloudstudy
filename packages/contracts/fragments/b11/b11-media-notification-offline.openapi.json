      "B11ShadowingCompletionReceipt": { "type": "object", "additionalProperties": false, "required": ["sourceSegmentId", "contentVersion", "status", "aiScoringAvailable", "source"], "properties": { "recordingId": { "type": "string", "nullable": true, "maxLength": 128 }, "sourceSegmentId": { "type": "string", "maxLength": 128 }, "contentVersion": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "integer", "minimum": 1 }] }, "status": { "type": "string", "const": "RECORDED" }, "aiScoringAvailable": { "type": "boolean", "const": false }, "source": { "type": "string", "const": "mysql" } } },
      "B11MediaCompatibility": { "type": "object", "additionalProperties": false, "required": ["legacyRefHash", "targetRefHash", "readOnly", "domainFactsUntouched"], "properties": { "legacyRefHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "targetRefHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "readOnly": { "type": "boolean", "const": true }, "domainFactsUntouched": { "type": "boolean", "const": true } } },
      "B11OfflineCompatibility": { "type": "object", "additionalProperties": false, "required": ["legacyEventHash", "targetEventHash", "readOnly", "domainFactsUntouched"], "properties": { "legacyEventHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "targetEventHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "readOnly": { "type": "boolean", "const": true }, "domainFactsUntouched": { "type": "boolean", "const": true } } }
