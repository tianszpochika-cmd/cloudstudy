      "B11MediaProgressRequest": { "type": "object", "additionalProperties": false, "required": ["assetId", "positionMs", "durationMs", "contentVersion", "entityVersion", "clientEventId"], "properties": { "assetId": { "type": "string", "maxLength": 128 }, "sessionId": { "type": "string", "nullable": true, "maxLength": 128 }, "positionMs": { "type": "integer", "minimum": 0 }, "durationMs": { "type": "integer", "minimum": 0 }, "contentVersion": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "integer", "minimum": 1 }] }, "entityVersion": { "type": "integer", "minimum": 0 }, "clientEventId": { "type": "string", "minLength": 8, "maxLength": 128 } } },
      "B11MediaProgressReceipt": { "type": "object", "additionalProperties": false, "required": ["assetId", "positionMs", "durationMs", "entityVersion", "status", "source"], "properties": { "assetId": { "type": "string", "maxLength": 128 }, "sessionId": { "type": "string", "nullable": true, "maxLength": 128 }, "positionMs": { "type": "integer", "minimum": 0 }, "durationMs": { "type": "integer", "minimum": 0 }, "entityVersion": { "type": "integer", "minimum": 0 }, "status": { "type": "string", "const": "RECORDED" }, "source": { "type": "string", "const": "mysql" } } },
