{
  "x-b8-idp-integration": {
    "mode": "standard-oidc-adapter",
    "protocol": "OIDC/OAuth2.1",
    "role": "relying-party-and-product-iam-control-plane",
    "authorizationResponseType": "code",
    "pkceMethod": "S256",
    "registrationLogin": {
      "mechanism": "idp-hosted",
      "entryPoint": "/api/v1/auth/oidc/{provider}/authorization/start",
      "intentParameter": "intent",
      "intents": ["login", "register"],
      "localCredentials": false
    },
    "state": {
      "generatedBy": "iam-service",
      "storedWith": "authorization-transaction",
      "singleUse": true,
      "clientSupplied": false
    },
    "nonce": {
      "generatedBy": "iam-service",
      "boundTo": "authorization-transaction-and-id-token",
      "singleUse": true,
      "clientSupplied": false
    },
    "tokenOwnership": {
      "issuer": "approved-external-oidc-idp",
      "iamMintsAccessTokens": false,
      "iamMintsRefreshTokens": false,
      "iamExposesTokenEndpoint": false,
      "refresh": "provider-adapter-only"
    },
    "productionProvider": "pending-G-IDP",
    "testDouble": "standard-oidc-provider-adapter",
    "selfHostedTokenServer": false,
    "note": "G-IDP 未批准前只实现适配器、契约和测试替身；不在平台内实现 OIDC 协议、Token Endpoint、Token 签发或 JWKS 服务。"
  },
  "x-b8-compatibility": {
    "strategy": "canonical-iam-routes-with-legacy-auth-compatibility",
    "legacyRoutes": [
      {
        "legacy": "/api/v1/auth/refresh",
        "canonical": "/api/v1/iam/session/refresh",
        "strategy": "兼容期双路由；旧客户端继续使用旧 operationId，新客户端迁移到 iam-service owner 的 canonical operation。"
      },
      {
        "legacy": "/api/v1/auth/logout",
        "canonical": "/api/v1/iam/session/logout",
        "strategy": "兼容期保留旧路径，不覆盖 B1 定义；两者共享撤销事实和相同错误语义。"
      },
      {
        "legacy": "/api/v1/auth/sessions/{sessionId}/revoke",
        "canonical": "/api/v1/iam/sessions/{sessionId}/revoke",
        "strategy": "兼容期保留旧路径；服务端按已验证 principal 重新计算 session owner。"
      }
    ]
  },
  "tags": [
    { "name": "b8-auth", "description": "标准 OIDC/OAuth 2.1 适配、会话轮换和撤销" },
    { "name": "b8-iam", "description": "principal、设备、成人 Gate 和 consent 事实" },
    { "name": "b8-security", "description": "统一登录后鉴权、服务侧决策和 fail-closed 语义" },
    { "name": "b8-compliance", "description": "Phase 1 成人年龄 Gate 和最小化合规同意" }
  ],
  "paths": {
    "/api/v1/auth/oidc/{provider}/authorization/start": {
      "get": {
        "tags": ["b8-auth"],
        "operationId": "startB8OidcAuthorization",
        "summary": "Start IdP-hosted registration or login with authorization code + PKCE; state, nonce and verifier are server-generated",
        "security": [],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "idpGate": "G-IDP" },
        "parameters": [
          { "$ref": "#/components/parameters/B8Provider" },
          { "$ref": "#/components/parameters/B8RedirectUri" },
          { "$ref": "#/components/parameters/B8AuthIntent" },
          { "$ref": "#/components/parameters/B8ReturnTo" },
          { "$ref": "#/components/parameters/B8UiLocale" },
          { "$ref": "#/components/parameters/B8Theme" }
        ],
        "responses": {
          "200": {
            "description": "Redirect URL and short-lived authorization transaction",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8AuthorizationStartResponse" } } }
          },
          "400": { "$ref": "#/components/responses/B8BadRequest" },
          "503": { "$ref": "#/components/responses/B8IdpUnavailable" }
        }
      }
    },
    "/api/v1/auth/oidc/{provider}/callback": {
      "get": {
        "tags": ["b8-auth"],
        "operationId": "completeB8OidcBrowserCallback",
        "summary": "Receive the standard OIDC browser redirect and consume its one-time authorization transaction",
        "security": [],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "idpGate": "G-IDP", "callback": "browser-redirect" },
        "x-callback-semantics": {
          "success": "code plus state",
          "providerError": "error plus state; no principal or session is created",
          "pkce": "server retrieves the verifier from the state-bound transaction",
          "nonce": "server verifies the ID-token nonce against the state-bound transaction",
          "replay": "state is atomically consumed once; replay is a conflict and never creates a second session"
        },
        "parameters": [
          { "$ref": "#/components/parameters/B8Provider" },
          { "$ref": "#/components/parameters/B8CallbackCode" },
          { "$ref": "#/components/parameters/B8State" },
          { "$ref": "#/components/parameters/B8OidcCallbackError" },
          { "$ref": "#/components/parameters/B8OidcCallbackErrorDescription" },
          { "$ref": "#/components/parameters/B8OidcCallbackErrorUri" }
        ],
        "responses": {
          "303": {
            "description": "Successful callback; redirect only to the server-allowlisted return path and establish the provider-backed session",
            "headers": {
              "Location": { "$ref": "#/components/headers/B8CallbackLocation" },
              "Set-Cookie": { "$ref": "#/components/headers/B8SessionCookie" }
            }
          },
          "400": { "$ref": "#/components/responses/B8BadRequest" },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8PolicyDenied" },
          "409": { "$ref": "#/components/responses/B8Conflict" },
          "503": { "$ref": "#/components/responses/B8IdpUnavailable" }
        }
      },
      "post": {
        "tags": ["b8-auth"],
        "operationId": "exchangeB8OidcCallback",
        "summary": "Compatibility JSON callback; exchange the code only after server-side state, nonce and PKCE verification",
        "security": [],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "idpGate": "G-IDP", "callback": "native-json-compatibility" },
        "x-idempotency": {
          "required": true,
          "strategy": "oidc-callback-exchange",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "同一授权事务只允许一次成功交换；重放进入 session_revoked 或 replay_detected 语义，不返回第二个有效会话。"
        },
        "parameters": [
          { "$ref": "#/components/parameters/B8Provider" },
          { "$ref": "#/components/parameters/B8IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8OidcCallbackRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Principal mapped and provider-backed session established; IAM never mints tokens, but the provider-issued access/refresh credentials may be relayed in this TLS-only JSON compatibility response so browser clients can call the Gateway",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8OidcCallbackResponse" } } }
          },
          "400": { "$ref": "#/components/responses/B8BadRequest" },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8PolicyDenied" },
          "409": { "$ref": "#/components/responses/B8Conflict" },
          "503": { "$ref": "#/components/responses/B8IdpUnavailable" }
        }
      }
    },
    "/api/v1/iam/session/refresh": {
      "post": {
        "tags": ["b8-auth"],
        "operationId": "refreshB8IamSession",
        "summary": "Rotate an external IdP refresh credential through the provider adapter; IAM does not mint tokens",
        "security": [],
        "x-contract": {
          "domain": "iam",
          "owner": "iam-service",
          "phase": "P1",
          "tokenIssuer": "approved-external-oidc-idp",
          "iamTokenServer": false,
          "refreshMechanism": "provider-adapter-only"
        },
        "x-idempotency": {
          "required": false,
          "strategy": "refresh-token-rotation",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "旧 refresh credential 只能触发一次轮换；重放撤销整条会话族。"
        },
        "parameters": [ { "$ref": "#/components/parameters/B8IdempotencyKeyOptional" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8SessionRefreshRequest" } } }
        },
        "responses": {
          "200": {
            "description": "External IdP-issued credentials after provider-side rotation; IAM only records the session rotation and never self-mints a token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8SessionTokenResponse" } } }
          },
          "400": { "$ref": "#/components/responses/B8BadRequest" },
          "401": { "$ref": "#/components/responses/B8SessionRefreshUnauthorized" },
          "403": { "$ref": "#/components/responses/B8PolicyDenied" },
          "409": { "$ref": "#/components/responses/B8Conflict" },
          "429": { "$ref": "#/components/responses/B8RateLimited" },
          "503": { "$ref": "#/components/responses/B8IdpUnavailable" }
        }
      }
    },
    "/api/v1/iam/session/logout": {
      "post": {
        "tags": ["b8-auth"],
        "operationId": "logoutB8IamSession",
        "summary": "Revoke the current verified session",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1" },
        "x-idempotency": {
          "required": true,
          "strategy": "session-logout",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "重复登出返回同一撤销事实，不泄露会话状态。"
        },
        "parameters": [ { "$ref": "#/components/parameters/B8IdempotencyKey" } ],
        "responses": {
          "200": {
            "description": "Current session revoked",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8SessionRevocationResponse" } } }
          },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8Forbidden" },
          "409": { "$ref": "#/components/responses/B8Conflict" }
        }
      }
    },
    "/api/v1/iam/sessions/{sessionId}/revoke": {
      "post": {
        "tags": ["b8-iam"],
        "operationId": "revokeB8IamSession",
        "summary": "Revoke an owned device session after server-side owner evaluation",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "ownerFact": "server-derived" },
        "x-idempotency": {
          "required": true,
          "strategy": "session-revocation",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "同一 principal 对同一 session 的重复撤销返回同一撤销事实。"
        },
        "parameters": [
          { "$ref": "#/components/parameters/B8SessionId" },
          { "$ref": "#/components/parameters/B8IdempotencyKey" }
        ],
        "responses": {
          "200": {
            "description": "Session revoked",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8SessionRevocationResponse" } } }
          },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8Forbidden" },
          "404": { "$ref": "#/components/responses/B8NotFound" }
        }
      }
    },
    "/api/v1/iam/principal/me": {
      "get": {
        "tags": ["b8-iam"],
        "operationId": "getB8CurrentPrincipal",
        "summary": "Read the server-mapped principal and Gate/consent status",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "principalSource": "verified-token-and-iam-facts" },
        "responses": {
          "200": {
            "description": "Current principal",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8PrincipalResponse" } } }
          },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8Forbidden" }
        }
      }
    },
    "/api/v1/iam/devices": {
      "get": {
        "tags": ["b8-iam"],
        "operationId": "listB8IamDevices",
        "summary": "List devices and sessions owned by the verified principal",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "ownerFact": "server-derived" },
        "responses": {
          "200": {
            "description": "Self-scoped device list",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8DeviceListResponse" } } }
          },
          "401": { "$ref": "#/components/responses/B8Unauthorized" }
        }
      }
    },
    "/api/v1/iam/permissions": {
      "get": {
        "tags": ["b8-security"],
        "operationId": "getB8IamPermissions",
        "summary": "Read server-derived roles and permissions for the current principal",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "principalSource": "verified-token-and-iam-facts", "default": "deny" },
        "responses": {
          "200": {
            "description": "Current authorization facts",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8PermissionsResponse" } } }
          },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8Forbidden" }
        }
      }
    },
    "/api/v1/iam/devices/{deviceId}/kickout": {
      "post": {
        "tags": ["b8-iam"],
        "operationId": "kickoutB8IamDevice",
        "summary": "Kick out a device session after server-side principal ownership check",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "ownerFact": "server-derived" },
        "x-idempotency": {
          "required": true,
          "strategy": "device-kickout",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "重复踢出返回同一设备撤销事实。"
        },
        "parameters": [
          { "$ref": "#/components/parameters/B8DeviceId" },
          { "$ref": "#/components/parameters/B8IdempotencyKey" }
        ],
        "responses": {
          "200": {
            "description": "Device session revoked",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8SessionRevocationResponse" } } }
          },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8Forbidden" },
          "404": { "$ref": "#/components/responses/B8NotFound" }
        }
      }
    },
    "/api/v1/iam/adult-gate": {
      "post": {
        "tags": ["b8-compliance"],
        "operationId": "evaluateB8AdultGate",
        "summary": "Evaluate Phase 1 adult access without creating minor or guardian facts",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "minorFacts": "forbidden", "decisionSource": "server" },
        "x-idempotency": {
          "required": true,
          "strategy": "adult-gate-evaluation",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "同一 principal 和 policy version 的重复 Gate 请求返回同一决定。"
        },
        "parameters": [ { "$ref": "#/components/parameters/B8IdempotencyKey" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8AdultGateRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Adult Gate decision",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8AdultGateResponse" } } }
          },
          "400": { "$ref": "#/components/responses/B8BadRequest" },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8AdultGateRequired" }
        }
      }
    },
    "/api/v1/iam/consents": {
      "get": {
        "tags": ["b8-compliance"],
        "operationId": "listB8IamConsents",
        "summary": "Read current principal consent versions",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1" },
        "responses": {
          "200": {
            "description": "Self-scoped consent state",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ConsentListResponse" } } }
          },
          "401": { "$ref": "#/components/responses/B8Unauthorized" }
        }
      },
      "put": {
        "tags": ["b8-compliance"],
        "operationId": "updateB8IamConsent",
        "summary": "Record an explicit consent decision",
        "security": [ { "bearerAuth": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "principalSource": "verified-token" },
        "x-idempotency": {
          "required": true,
          "strategy": "consent-update",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "同一 consent version 的重复决定幂等；撤回不删除历史审计事实。"
        },
        "parameters": [ { "$ref": "#/components/parameters/B8IdempotencyKey" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ConsentUpdateRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Consent updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8Consent" } } }
          },
          "400": { "$ref": "#/components/responses/B8BadRequest" },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8ConsentRequired" },
          "409": { "$ref": "#/components/responses/B8Conflict" }
        }
      }
    },
    "/api/v1/auth/oidc/{provider}/metadata": {
      "get": {
        "tags": ["b8-auth"],
        "operationId": "getB8OidcProviderMetadata",
        "summary": "Read metadata through the standard OIDC provider adapter",
        "security": [],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "idpGate": "G-IDP" },
        "parameters": [ { "$ref": "#/components/parameters/B8Provider" } ],
        "responses": {
          "200": {
            "description": "Provider metadata; no client secret or token server is exposed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8OidcProviderMetadata" } } }
          },
          "404": { "$ref": "#/components/responses/B8NotFound" },
          "503": { "$ref": "#/components/responses/B8IdpUnavailable" }
        }
      }
    },
    "/api/v1/auth/oidc/{provider}/jwks": {
      "get": {
        "tags": ["b8-auth"],
        "operationId": "getB8OidcProviderJwks",
        "summary": "Read provider signing keys through the JWKS adapter seam",
        "security": [],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "idpGate": "G-IDP", "rotation": "supported" },
        "parameters": [ { "$ref": "#/components/parameters/B8Provider" } ],
        "responses": {
          "200": {
            "description": "Public signing keys only",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8JwksResponse" } } }
          },
          "404": { "$ref": "#/components/responses/B8NotFound" },
          "503": { "$ref": "#/components/responses/B8IdpUnavailable" }
        }
      }
    },
    "/internal/v1/iam/authorization/decisions": {
      "post": {
        "tags": ["b8-security"],
        "operationId": "decideB8Authorization",
        "summary": "Evaluate a versioned IAM policy for a trusted workload",
        "security": [ { "B8WorkloadIdentity": [] } ],
        "x-contract": { "domain": "iam", "owner": "iam-service", "phase": "P1", "pep": "service-side", "default": "deny", "failMode": "closed" },
        "x-idempotency": {
          "required": false,
          "strategy": "policy-decision",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "短期决策缓存按 decision fingerprint 去重，不把 Kafka 当 RPC。"
        },
        "parameters": [ { "$ref": "#/components/parameters/B8IdempotencyKeyOptional" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8AuthorizationDecisionRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Allow or deny decision with policy version",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8AuthorizationDecisionResponse" } } }
          },
          "401": { "$ref": "#/components/responses/B8Unauthorized" },
          "403": { "$ref": "#/components/responses/B8PolicyDenied" },
          "503": { "$ref": "#/components/responses/B8PolicyDenied" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "B8WorkloadIdentity": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "OIDC workload identity",
        "description": "仅供服务到服务调用；由受信 workload identity/mTLS 校验，不能由浏览器或客户端伪造。"
      }
    },
    "parameters": {
      "B8Provider": {
        "name": "provider",
        "in": "path",
        "required": true,
        "description": "已登记的标准 OIDC provider adapter 名称；不是 Token Server 地址。",
        "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }
      },
      "B8RedirectUri": {
        "name": "redirectUri",
        "in": "query",
        "required": true,
        "description": "必须匹配服务端登记的 redirect URI，客户端不能把任意地址注入回调。",
        "schema": { "type": "string", "format": "uri", "maxLength": 512 }
      },
      "B8AuthIntent": {
        "name": "intent",
        "in": "query",
        "required": false,
        "description": "仅用于选择 IdP 托管的登录或注册入口；不改变 OIDC 授权协议，也不接受本地凭据。",
        "schema": { "type": "string", "enum": ["login", "register"], "default": "login" }
      },
      "B8ReturnTo": {
        "name": "returnTo",
        "in": "query",
        "required": false,
        "description": "受控的相对返回路径；服务端只接受已登记的学习端深链，不把它当作授权事实。",
        "schema": { "type": "string", "pattern": "^/(?!/).{0,511}$" }
      },
      "B8UiLocale": {
        "name": "uiLocale",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{1,3})?$", "maxLength": 16 }
      },
      "B8Theme": {
        "name": "theme",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "enum": ["light", "dark", "system", "high-contrast"] }
      },
      "B8CodeChallenge": {
        "name": "codeChallenge",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      },
      "B8CodeChallengeMethod": {
        "name": "codeChallengeMethod",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "const": "S256" }
      },
      "B8State": {
        "name": "state",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "minLength": 16, "maxLength": 256 }
      },
      "B8Nonce": {
        "name": "nonce",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "minLength": 16, "maxLength": 256 }
      },
      "B8CallbackCode": {
        "name": "code",
        "in": "query",
        "required": false,
        "description": "一次性 authorization code；只在 provider 未返回 error 时出现，服务端不得持久化。",
        "schema": { "type": "string", "minLength": 16, "maxLength": 2048 }
      },
      "B8OidcCallbackError": {
        "name": "error",
        "in": "query",
        "required": false,
        "description": "OIDC/OAuth provider 返回的标准错误码；服务端只映射为安全错误 envelope，不回显 provider 原文。",
        "schema": {
          "type": "string",
          "enum": ["access_denied", "account_selection_required", "consent_required", "interaction_required", "invalid_request", "invalid_scope", "login_required", "server_error", "temporarily_unavailable", "unauthorized_client", "unsupported_response_type"]
        }
      },
      "B8OidcCallbackErrorDescription": {
        "name": "error_description",
        "in": "query",
        "required": false,
        "description": "不可信的 provider 描述；仅供内部诊断，禁止原样返回、日志记录或作为授权事实。",
        "schema": { "type": "string", "maxLength": 512 }
      },
      "B8OidcCallbackErrorUri": {
        "name": "error_uri",
        "in": "query",
        "required": false,
        "description": "provider 错误文档地址；不得作为本地 redirect 或跳转目标。",
        "schema": { "type": "string", "format": "uri", "maxLength": 2048 }
      },
      "B8IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "服务端按已验证 principal/session 作用域绑定请求哈希；不能携带授权事实。",
        "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
      },
      "B8IdempotencyKeyOptional": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
      },
      "B8SessionId": {
        "name": "sessionId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/B8SessionId" }
      },
      "B8DeviceId": {
        "name": "deviceId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/B8DeviceId" }
      }
    },
    "headers": {
      "B8CallbackLocation": {
        "description": "只允许跳转到服务端登记的 returnTo/redirect URI；不得包含 code、state、access token 或 refresh token。",
        "schema": { "type": "string", "format": "uri", "maxLength": 2048 }
      },
      "B8SessionCookie": {
        "description": "可选的 provider-backed、HttpOnly、Secure、SameSite 会话 cookie；不表示 IAM 是 OAuth/OIDC Token Server。",
        "schema": { "type": "string", "maxLength": 4096 }
      }
    },
    "responses": {
      "B8BadRequest": {
        "description": "Malformed or invalid authentication request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8Unauthorized": {
        "description": "Missing, invalid or expired authentication; error.code=unauthorized",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8SessionRefreshUnauthorized": {
        "description": "Refresh credential is missing, invalid, expired or already used; error.code is unauthorized or session_revoked and HTTP status is 401",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8Forbidden": {
        "description": "Authenticated principal is not allowed; error.code=forbidden",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8AdultGateRequired": {
        "description": "Phase 1 adult Gate rejected or incomplete; error.code=adult_gate_required",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8ConsentRequired": {
        "description": "Required consent is missing or withdrawn; error.code=consent_required",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8SessionRevoked": {
        "description": "Session is revoked or refresh replay was detected; error.code=session_revoked",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8PolicyDenied": {
        "description": "Policy decision denied or policy service failed closed; error.code=policy_denied",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8Conflict": {
        "description": "Authentication transaction or idempotency conflict",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8NotFound": {
        "description": "Resource or registered provider not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8RateLimited": {
        "description": "Rate limit exceeded",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      },
      "B8IdpUnavailable": {
        "description": "Standard external IdP adapter, discovery, token exchange, refresh or JWKS is unavailable; return HTTP 503 with error.code=idp_unavailable and retryable=true; no fallback token server is used",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/B8ErrorEnvelope" } } }
      }
    },
    "schemas": {
      "B8ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "traceId", "error"],
        "properties": {
          "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
          "traceId": { "type": "string", "minLength": 8, "maxLength": 128 },
          "error": { "$ref": "#/components/schemas/B8Error" }
        }
      },
      "B8Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["invalid_request", "unauthorized", "forbidden", "adult_gate_required", "consent_required", "session_revoked", "policy_denied", "idp_unavailable", "conflict", "not_found", "rate_limited"]
          },
          "message": { "type": "string", "minLength": 1, "maxLength": 256, "description": "安全、可本地化的非敏感提示；不得回显 Token、IdP 原文或策略秘密。" },
          "retryable": { "type": "boolean" },
          "policyVersion": { "type": "string", "maxLength": 64 },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "maxProperties": 8,
            "description": "仅允许安全、可本地化的诊断字段；不得包含 token、IdP 原文、claims、密钥或策略秘密。"
          }
        }
      },
      "B8AuthorizationStartResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorizationUrl", "transactionId", "provider", "expiresAt"],
        "properties": {
          "authorizationUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
          "transactionId": { "type": "string", "pattern": "^oidc_tx_[A-Za-z0-9._:-]{15,127}$" },
          "provider": { "type": "string", "maxLength": 32 },
          "expiresAt": { "type": "string", "format": "date-time" },
          "intent": { "type": "string", "enum": ["login", "register"] }
        }
      },
      "B8OidcCallbackRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "redirectUri"],
        "properties": {
          "code": { "type": "string", "minLength": 16, "maxLength": 2048, "description": "成功回调中的一次性 authorization code；服务端只向外部标准 IdP adapter 转发，不持久化。与 error 互斥。" },
          "state": { "type": "string", "minLength": 16, "maxLength": 256 },
          "redirectUri": { "type": "string", "format": "uri", "maxLength": 512 },
          "error": { "type": "string", "enum": ["access_denied", "account_selection_required", "consent_required", "interaction_required", "invalid_request", "invalid_scope", "login_required", "server_error", "temporarily_unavailable", "unauthorized_client", "unsupported_response_type"] },
          "errorDescription": { "type": "string", "maxLength": 512, "description": "不可信 provider 文本；服务端不得原样回显或持久化。" },
          "errorUri": { "type": "string", "format": "uri", "maxLength": 2048, "description": "provider 文档地址；不是 redirect 目标。" }
        },
        "x-callback-validation": {
          "successShape": ["code", "state", "redirectUri"],
          "errorShape": ["error", "state", "redirectUri"],
          "mutuallyExclusive": ["code", "error"],
          "stateBoundTransaction": true,
          "codeVerifierFromServerTransaction": true,
          "nonceFromServerTransaction": true
        }
      },
      "B8OidcCallbackResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session", "principal", "adultGate", "consentState"],
        "properties": {
          "session": { "$ref": "#/components/schemas/B8SessionEstablishedResponse" },
          "principal": { "$ref": "#/components/schemas/B8PrincipalResponse" },
          "adultGate": { "$ref": "#/components/schemas/B8AdultGateResponse" },
          "consentState": { "$ref": "#/components/schemas/B8ConsentState" }
        }
      },
      "B8SessionEstablishedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "deviceId", "provider", "status", "establishedAt"],
        "description": "Product session fact created after the external IdP verifies the authorization code and ID token. Any credential fields are provider-issued relay values, never IAM-minted values; they are not persisted or logged by IAM.",
        "x-sensitive-fields": ["accessToken", "refreshToken"],
        "properties": {
          "sessionId": { "$ref": "#/components/schemas/B8SessionId" },
          "deviceId": { "$ref": "#/components/schemas/B8DeviceId" },
          "provider": { "type": "string", "maxLength": 32 },
          "status": { "type": "string", "const": "ACTIVE" },
          "establishedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "accessToken": { "type": "string", "minLength": 32, "maxLength": 8192, "description": "Provider-issued access token; TLS relay only; must never be stored or written to logging by IAM." },
          "refreshToken": { "type": "string", "minLength": 32, "maxLength": 4096, "description": "Provider-issued refresh token; TLS relay only; IAM stores only a digest for rotation and must never store or log the plaintext token." },
          "accessTokenExpiresAt": { "type": "string", "format": "date-time" },
          "tokenType": { "type": "string", "const": "Bearer" },
          "issuer": { "type": "string", "format": "uri", "maxLength": 512 }
        }
      },
      "B8SessionRefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refreshToken"],
        "x-sensitive-fields": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string", "minLength": 32, "maxLength": 4096, "description": "外部标准 OIDC IdP 签发的敏感 Refresh Token；只经 TLS 传输，IAM 只通过 provider adapter 轮换并保存 hash，禁止本地 Token Endpoint、日志、事件和普通持久化明文。" }
        }
      },
      "B8SessionTokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accessToken", "refreshToken", "expiresIn", "refreshExpiresIn", "sessionId"],
        "x-sensitive-fields": ["accessToken", "refreshToken"],
        "x-token-ownership": {
          "issuer": "approved-external-oidc-idp",
          "mintedByIam": false,
          "transport": "provider-adapter",
          "noLocalTokenEndpoint": true
        },
        "properties": {
          "accessToken": { "type": "string", "minLength": 32, "maxLength": 8192, "description": "外部标准 OIDC IdP 签发的 Access Token；IAM 不签发、不改写，客户端只经 TLS 接收并放入受控短期存储，禁止日志和事件。" },
          "refreshToken": { "type": "string", "minLength": 32, "maxLength": 4096, "description": "外部标准 OIDC IdP 签发的 Refresh Token；IAM 只经 provider adapter 轮换并保存 hash，禁止本地 Token Endpoint、日志、事件和数据库明文。" },
          "expiresIn": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "refreshExpiresIn": { "type": "integer", "minimum": 1, "maximum": 2592000 },
          "deviceId": { "$ref": "#/components/schemas/B8DeviceId" },
          "sessionId": { "$ref": "#/components/schemas/B8SessionId" },
          "tokenType": { "type": "string", "const": "Bearer" },
          "issuer": { "type": "string", "format": "uri", "maxLength": 512 }
        }
      },
      "B8SessionRevocationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "status", "revokedAt"],
        "properties": {
          "sessionId": { "$ref": "#/components/schemas/B8SessionId" },
          "status": { "type": "string", "const": "REVOKED" },
          "revokedAt": { "type": "string", "format": "date-time" }
        }
      },
      "B8PrincipalResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalId", "subjectType", "provider", "status", "adultGate", "consentState"],
        "properties": {
          "principalId": { "type": "string", "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$" },
          "subjectType": { "type": "string", "const": "ADULT_LEARNER" },
          "provider": { "type": "string", "maxLength": 32 },
          "status": { "type": "string", "enum": ["ACTIVE", "RESTRICTED", "REVOKED"] },
          "adultGate": { "$ref": "#/components/schemas/B8AdultGateResponse" },
          "consentState": { "$ref": "#/components/schemas/B8ConsentState" },
          "policyVersion": { "type": "string", "maxLength": 64 }
        }
      },
      "B8PermissionsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalId", "roles", "permissions", "adultGate"],
        "properties": {
          "principalId": { "type": "string", "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$" },
          "roles": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "permissions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
          "adultGate": { "$ref": "#/components/schemas/B8AdultGateResponse" },
          "policyVersion": { "type": "string", "maxLength": 64 }
        }
      },
      "B8Device": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceId", "sessionId", "platform", "status", "lastActiveAt", "current"],
        "properties": {
          "deviceId": { "$ref": "#/components/schemas/B8DeviceId" },
          "sessionId": { "$ref": "#/components/schemas/B8SessionId" },
          "platform": { "type": "string", "enum": ["ANDROID", "IOS", "WEB", "PWA", "MINIAPP"] },
          "status": { "type": "string", "enum": ["ACTIVE", "REVOKED", "RISK_REVIEW"] },
          "lastActiveAt": { "type": "string", "format": "date-time" },
          "current": { "type": "boolean" }
        }
      },
      "B8DeviceListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "total"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/B8Device" } },
          "total": { "type": "integer", "minimum": 0 }
        }
      },
      "B8AdultGateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["birthYear", "policyVersion", "adultDeclaration"],
        "properties": {
          "birthYear": { "type": "integer", "minimum": 1900, "maximum": 2100, "description": "最小化年龄输入；仅作为待核验声明，不能成为客户端直接授权事实。服务端按当前日期、策略和证据决定。" },
          "policyVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "adultDeclaration": { "type": "boolean", "const": true, "description": "用户声明，不等价于服务端 Gate 通过。" }
        }
      },
      "B8AdultGateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "policyVersion", "evaluatedAt"],
        "properties": {
          "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
          "policyVersion": { "type": "string", "maxLength": 64 },
          "evaluatedAt": { "type": "string", "format": "date-time" },
          "retryAllowed": { "type": "boolean" }
        }
      },
      "B8Consent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consentType", "consentVersion", "decision", "updatedAt"],
        "properties": {
          "consentType": { "type": "string", "enum": ["TERMS", "PRIVACY", "ADULT_LEARNING", "PRODUCT_ANALYTICS"] },
          "consentVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "decision": { "type": "string", "enum": ["ACCEPTED", "WITHDRAWN"] },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "B8ConsentState": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required", "accepted", "version"],
        "properties": {
          "required": { "type": "boolean" },
          "accepted": { "type": "boolean" },
          "version": { "type": "string", "maxLength": 64 }
        }
      },
      "B8ConsentListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/B8Consent" } }
        }
      },
      "B8ConsentUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consentType", "consentVersion", "decision"],
        "properties": {
          "consentType": { "type": "string", "enum": ["TERMS", "PRIVACY", "ADULT_LEARNING", "PRODUCT_ANALYTICS"] },
          "consentVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "decision": { "type": "string", "enum": ["ACCEPTED", "WITHDRAWN"] }
        }
      },
      "B8OidcProviderMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuer", "authorizationEndpoint", "jwksUri", "codeChallengeMethods"],
        "x-oidc-discovery": {
          "source": "external-provider-adapter",
          "serverSideOnly": true,
          "tokenEndpointOwnedBy": "external-oidc-idp"
        },
        "properties": {
          "issuer": { "type": "string", "format": "uri", "maxLength": 512 },
          "authorizationEndpoint": { "type": "string", "format": "uri", "maxLength": 1024 },
          "tokenEndpoint": { "type": "string", "format": "uri", "maxLength": 1024 },
          "jwksUri": { "type": "string", "format": "uri", "maxLength": 1024 },
          "userinfoEndpoint": { "type": "string", "format": "uri", "maxLength": 1024 },
          "codeChallengeMethods": { "type": "array", "items": { "type": "string", "const": "S256" }, "minItems": 1 },
          "codeChallengeMethodsSupported": { "type": "array", "items": { "type": "string", "const": "S256" }, "minItems": 1 },
          "responseTypesSupported": { "type": "array", "items": { "type": "string", "const": "code" }, "minItems": 1 },
          "grantTypesSupported": { "type": "array", "items": { "type": "string", "enum": ["authorization_code", "refresh_token"] }, "minItems": 1 },
          "scopes": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "contains": { "const": "openid" } },
          "scopesSupported": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "contains": { "const": "openid" } },
          "subjectTypesSupported": { "type": "array", "items": { "type": "string", "const": "public" }, "minItems": 1 },
          "idTokenSigningAlgValuesSupported": { "type": "array", "items": { "type": "string", "enum": ["RS256", "RS384", "RS512"] }, "minItems": 1 }
        }
      },
      "B8JwksResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keys"],
        "x-jwks-source": "external-oidc-idp",
        "x-jwks-boundary": "public-signing-keys-only; never expose private key material",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kid", "kty", "use", "alg", "n", "e"],
              "properties": {
                "kid": { "type": "string", "maxLength": 128 },
                "kty": { "type": "string", "const": "RSA" },
                "use": { "type": "string", "const": "sig" },
                "alg": { "type": "string", "enum": ["RS256", "RS384", "RS512"] },
                "n": { "type": "string", "maxLength": 4096 },
                "e": { "type": "string", "maxLength": 16 }
              }
            }
          }
        }
      },
      "B8AuthorizationDecisionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "resourceType", "resourceId", "phase"],
        "description": "只提交待判定的动作和资源上下文；subject、tenant、owner、role、permission 和 consent 事实由验证后的 workload/principal 与服务端事实派生。",
        "properties": {
          "action": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,95}$" },
          "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,95}$" },
          "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "phase": { "type": "string", "enum": ["P1", "P2", "P3"] },
          "contentRights": { "type": "string", "enum": ["PUBLISHED", "LICENSED", "INTERNAL", "UNKNOWN"] },
          "deviceTrust": { "type": "string", "enum": ["TRUSTED", "STANDARD", "RISK_REVIEW", "UNKNOWN"] },
          "consentRequirement": { "type": "string", "enum": ["NONE", "TERMS", "PRIVACY", "ADULT_LEARNING", "PRODUCT_ANALYTICS"] }
        },
        "x-server-derived-authorization-facts": ["subject", "tenant", "owner", "role", "permission", "consent", "policyVersion"]
      },
      "B8AuthorizationDecisionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decisionId", "decision", "reasonCode", "policyVersion", "evaluatedAt"],
        "properties": {
          "decisionId": { "type": "string", "pattern": "^dec_[A-Za-z0-9._:-]{15,127}$" },
          "decision": { "type": "string", "enum": ["ALLOW", "DENY"] },
          "reasonCode": { "type": "string", "enum": ["ALLOWED", "POLICY_DENIED", "ADULT_GATE_REQUIRED", "CONSENT_REQUIRED", "SESSION_REVOKED", "CONTEXT_MISSING", "POLICY_UNAVAILABLE"] },
          "policyVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "evaluatedAt": { "type": "string", "format": "date-time" },
          "cacheUntil": { "type": "string", "format": "date-time" }
        }
      },
