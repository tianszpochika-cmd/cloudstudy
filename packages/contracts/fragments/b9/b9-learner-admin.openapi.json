{
  "tags": [
    {
      "name": "b9-learner-admin",
      "description": "Single-tenant control-plane reads and governed commands on learner-owned facts"
    }
  ],
  "paths": {
    "/api/v1/admin/learners/search": {
      "get": {
        "tags": ["b9-learner-admin"],
        "summary": "Search learner subjects (owned profiles only)",
        "operationId": "listAdminLearnerSubjects",
        "security": [{ "bearerAuth": [] }],
        "x-contract": {
          "owner": "learner-service",
          "caller": "admin-web",
          "readOnly": true,
          "fieldFiltering": "subject ids only; no contact PII crosses this boundary (identity lives in IAM)"
        },
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/PageSize" },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "maxLength": 128 },
            "description": "Subject substring match; empty lists recent subjects."
          }
        ],
        "responses": {
          "200": {
            "description": "Learner subject list",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiCursorPageEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/AdminLearnerSubject" },
                          "maxItems": 100
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" },
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }
            }
          },
          "401": { "$ref": "#/components/responses/ApiUnauthorized" },
          "403": { "$ref": "#/components/responses/ApiForbidden" }
        },
        "x-pagination": {
          "mode": "cursor",
          "cursorParameter": "#/components/parameters/Cursor",
          "pageSizeParameter": "#/components/parameters/PageSize",
          "responseMeta": "#/components/schemas/ApiCursorPageMeta"
        }
      }
    },
    "/api/v1/admin/learners/{subjectId}/profile": {
      "get": {
        "tags": ["b9-learner-admin"],
        "summary": "Read one learner profile with goal, preferences and first-day projection",
        "operationId": "getAdminLearnerProfile",
        "security": [{ "bearerAuth": [] }],
        "x-contract": {
          "owner": "learner-service",
          "caller": "admin-web",
          "readOnly": true,
          "fieldFiltering": "owned profile facts; no IAM identity or contact data"
        },
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 128 }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner profile detail",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiSuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/AdminLearnerProfile" } }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" },
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }
            }
          },
          "401": { "$ref": "#/components/responses/ApiUnauthorized" },
          "403": { "$ref": "#/components/responses/ApiForbidden" },
          "404": { "$ref": "#/components/responses/ApiNotFound" }
        }
      }
    },
    "/api/v1/admin/learners/{subjectId}/commands": {
      "post": {
        "tags": ["b9-learner-admin"],
        "summary": "Governed learner commands (SET_GOAL, UPDATE_PREFERENCES)",
        "operationId": "sendAdminLearnerCommand",
        "security": [{ "bearerAuth": [] }],
        "x-contract": {
          "owner": "learner-service",
          "caller": "admin-web",
          "readOnly": false,
          "fieldFiltering": "subject from path; actor/tenant from verified JWT; same outbox facts as learner-owned writes"
        },
        "x-idempotency": {
          "required": true,
          "strategy": "learner-admin-command",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "same subject, command and request hash returns the original mutation result"
        },
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 128 }
          },
          { "$ref": "#/components/parameters/B9IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminLearnerCommandRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Learner command accepted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiSuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/AdminLearnerCommandAccepted" } }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" },
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }
            }
          },
          "401": { "$ref": "#/components/responses/ApiUnauthorized" },
          "403": { "$ref": "#/components/responses/ApiForbidden" },
          "404": { "$ref": "#/components/responses/ApiNotFound" },
          "409": { "$ref": "#/components/responses/ApiConflict" }
        }
      }
    },
    "/api/v1/admin/learners/{subjectId}/plans": {
      "get": {
        "tags": ["b9-learner-admin"],
        "summary": "Read one learner plan with SRS overview",
        "operationId": "getAdminLearnerPlans",
        "security": [{ "bearerAuth": [] }],
        "x-contract": {
          "owner": "learning-service",
          "caller": "admin-web",
          "readOnly": true,
          "fieldFiltering": "plan rows and aggregate SRS counts; no score fabrication"
        },
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 128 }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner plan detail",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiSuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "type": "object" } }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" },
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }
            }
          },
          "401": { "$ref": "#/components/responses/ApiUnauthorized" },
          "403": { "$ref": "#/components/responses/ApiForbidden" },
          "404": { "$ref": "#/components/responses/ApiNotFound" }
        }
      }
    },
    "/api/v1/admin/learners/{subjectId}/srs": {
      "get": {
        "tags": ["b9-learner-admin"],
        "summary": "Read one learner due SRS queue",
        "operationId": "getAdminLearnerSrs",
        "security": [{ "bearerAuth": [] }],
        "x-contract": {
          "owner": "learning-service",
          "caller": "admin-web",
          "readOnly": true,
          "fieldFiltering": "due SRS rows only; intervals and mastery stay server-computed"
        },
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 128 }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner SRS detail",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiSuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "type": "object" } }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" },
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }
            }
          },
          "401": { "$ref": "#/components/responses/ApiUnauthorized" },
          "403": { "$ref": "#/components/responses/ApiForbidden" },
          "404": { "$ref": "#/components/responses/ApiNotFound" }
        }
      }
    },
    "/api/v1/admin/learners/{subjectId}/learning-commands": {
      "post": {
        "tags": ["b9-learner-admin"],
        "summary": "Governed learning recovery commands (RESET_SRS_ITEM)",
        "operationId": "sendAdminLearningCommand",
        "security": [{ "bearerAuth": [] }],
        "x-contract": {
          "owner": "learning-service",
          "caller": "admin-web",
          "readOnly": false,
          "fieldFiltering": "subject and item from path/body; SM2 reset values are server constants, never client input"
        },
        "x-idempotency": {
          "required": true,
          "strategy": "learning-admin-command",
          "keyHeader": "Idempotency-Key",
          "replayBehavior": "same subject, item and key returns the original reset result"
        },
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 128 }
          },
          { "$ref": "#/components/parameters/B9IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminLearningCommandRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Learning command accepted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiSuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "type": "object" } }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" },
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }
            }
          },
          "401": { "$ref": "#/components/responses/ApiUnauthorized" },
          "403": { "$ref": "#/components/responses/ApiForbidden" },
          "404": { "$ref": "#/components/responses/ApiNotFound" },
          "409": { "$ref": "#/components/responses/ApiConflict" }
        }
      }
    },
    "/api/v1/admin/learners/{subjectId}/assessments": {
      "get": {
        "tags": ["b9-learner-admin"],
        "summary": "Read one learner assessment summary (answers never cross this boundary)",
        "operationId": "getAdminLearnerAssessments",
        "security": [{ "bearerAuth": [] }],
        "x-contract": {
          "owner": "assessment-service",
          "caller": "admin-web",
          "readOnly": true,
          "fieldFiltering": "session/report/mistake summaries; answers, evidence payloads and hashes stay inside assessment-service"
        },
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 128 }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner assessment summary",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiSuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "type": "object" } }
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "X-Trace-Id": { "$ref": "#/components/headers/XTraceId" },
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }
            }
          },
          "401": { "$ref": "#/components/responses/ApiUnauthorized" },
          "403": { "$ref": "#/components/responses/ApiForbidden" },
          "404": { "$ref": "#/components/responses/ApiNotFound" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminLearnerSubject": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subjectId", "tenantId"],
        "properties": {
          "subjectId": { "type": "string", "maxLength": 128 },
          "tenantId": { "type": "string", "maxLength": 128 }
        }
      },
      "AdminLearnerProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "subjectId"],
        "properties": {
          "subjectId": { "type": "string", "maxLength": 128 },
          "profile": { "type": "object" },
          "firstDay": { "type": "object" }
        }
      },
      "AdminLearnerCommandRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "expectedStateVersion"],
        "properties": {
          "command": { "type": "string", "enum": ["SET_GOAL", "UPDATE_PREFERENCES"] },
          "expectedStateVersion": { "$ref": "#/components/schemas/B9StateVersion" },
          "goalType": { "type": "string", "enum": ["FOUNDATION", "CET_4_6", "POSTGRADUATE", "WORKPLACE", "LANGUAGE_CERT"], "description": "Phase 1 adult goals. CET_4_6 is the historical English-exam goal (retained for compatibility); LANGUAGE_CERT is the converged language-exam goal carrying examName/language (B4)." },
          "dailyMinutes": { "type": "integer", "enum": [5, 15, 30, 45] },
          "targetDate": { "type": "string", "maxLength": 32 },
          "startingLevel": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
          "examName": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Exam name for LANGUAGE_CERT goals (e.g. DELF-B2, JLPT-N2); required with goalType=LANGUAGE_CERT, rejected otherwise." },
          "language": { "type": "string", "minLength": 2, "maxLength": 16, "description": "BCP-47 exam language for LANGUAGE_CERT goals (e.g. fr-FR, de-DE); required with goalType=LANGUAGE_CERT, rejected otherwise." },
          "uiLocale": { "type": "string", "maxLength": 16 },
          "contentLocale": { "type": "string", "maxLength": 16 },
          "themeMode": { "type": "string", "enum": ["LIGHT", "DARK", "SYSTEM", "HIGH_CONTRAST"] },
          "timezone": { "type": "string", "maxLength": 64 },
          "reducedMotion": { "type": "boolean" }
        },
        "x-command-field-policy": {
          "SET_GOAL": {
            "required": ["goalType", "dailyMinutes"],
            "allowed": ["command", "expectedStateVersion", "goalType", "dailyMinutes", "targetDate", "startingLevel", "examName", "language"]
          },
          "UPDATE_PREFERENCES": {
            "required": ["uiLocale", "contentLocale", "themeMode", "timezone"],
            "allowed": ["command", "expectedStateVersion", "uiLocale", "contentLocale", "themeMode", "timezone", "reducedMotion"]
          }
        }
      },
      "AdminLearnerCommandAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "subjectId", "profileVersion", "status"],
        "properties": {
          "command": { "type": "string", "enum": ["SET_GOAL", "UPDATE_PREFERENCES"] },
          "subjectId": { "type": "string", "maxLength": 128 },
          "profileVersion": { "$ref": "#/components/schemas/B9StateVersion" },
          "replayed": { "type": "boolean" },
          "adminSubject": { "type": "string", "maxLength": 128 },
          "status": { "type": "string", "enum": ["ACCEPTED"] }
        }
      },
      "AdminLearningCommandRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "itemId"],
        "properties": {
          "command": { "type": "string", "enum": ["RESET_SRS_ITEM"] },
          "itemId": { "type": "string", "maxLength": 128 },
          "reasonCode": { "type": "string", "maxLength": 96 }
        }
      }
    }
  }
}
