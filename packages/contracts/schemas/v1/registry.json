    "platform.event.dlq-record.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/event-dlq-record.v1.schema.json",
      "title": "Immutable dead-letter record",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dlqRecordId",
        "eventId",
        "rootEventId",
        "eventName",
        "aggregateType",
        "aggregateId",
        "aggregateVersion",
        "schemaVersion",
        "dedupeKey",
        "requestId",
        "traceId",
        "topic",
        "partitionKey",
        "payloadDigest",
        "consumerGroup",
        "failureCode",
        "attempt",
        "failedAt",
        "recoveryState",
        "auditId"
      ],
      "properties": {
        "dlqRecordId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "rootEventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,95}\\.v[1-9][0-9]*$"
        },
        "dedupeKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,255}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{7,127}$"
        },
        "traceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "consumerGroup": {
          "type": "string",
          "pattern": "^cg\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
        },
        "failureCode": {
