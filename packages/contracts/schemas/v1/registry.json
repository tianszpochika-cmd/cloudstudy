{
  "registryVersion": "1.0.0",
  "schema": "platform.json-schema.registry.v1",
  "schemas": {
    "platform.contract.health.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/contract-health.v1.schema.json",
      "title": "Platform contract health",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "traceId", "status"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "traceId": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ok", "degraded"] }
      }
    },
    "platform.api.envelope.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/api-envelope.v1.schema.json",
      "title": "Canonical public API envelope",
      "description": "P1R-M1-001 canonical public API success, cursor-page and error envelope used by every active /api/v1 operation. Domain schemas are nested only as operation-specific data payloads.",
      "type": "object",
      "anyOf": [
        { "$ref": "#/$defs/successEnvelope" },
        { "$ref": "#/$defs/cursorPageEnvelope" },
        { "$ref": "#/$defs/errorEnvelope" }
      ],
      "$defs": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{7,127}$",
          "minLength": 8,
          "maxLength": 128
        },
        "traceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "traceId",
            "apiVersion",
            "schemaVersion",
            "serverTime"
          ],
          "properties": {
            "requestId": { "$ref": "#/$defs/requestId" },
            "traceId": { "$ref": "#/$defs/traceId" },
            "apiVersion": { "const": "v1" },
            "schemaVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "serverTime": { "type": "string", "format": "date-time" }
          }
        },
        "cursorPageMeta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "traceId",
            "apiVersion",
            "schemaVersion",
            "serverTime",
            "hasMore",
            "pageSize"
          ],
          "properties": {
            "requestId": { "$ref": "#/$defs/requestId" },
            "traceId": { "$ref": "#/$defs/traceId" },
            "apiVersion": { "const": "v1" },
            "schemaVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "serverTime": { "type": "string", "format": "date-time" },
            "nextCursor": {
              "type": ["string", "null"],
              "minLength": 8,
              "maxLength": 512
            },
            "snapshotAt": { "type": ["string", "null"], "format": "date-time" },
            "hasMore": { "type": "boolean" },
            "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["errorCode", "message", "retryable"],
          "properties": {
            "errorCode": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR",
                "AUTH_REQUIRED",
                "AUTH_INVALID_REFRESH_TOKEN",
                "AUTH_REFRESH_TOKEN_EXPIRED",
                "AUTH_REFRESH_TOKEN_REVOKED",
                "AUTH_REFRESH_REUSE_DETECTED",
                "AUTH_DEVICE_MISMATCH",
                "AUTH_IDENTITY_BOUND_OTHER",
                "FORBIDDEN",
                "NOT_FOUND",
                "CONFLICT",
                "IDEMPOTENCY_REQUIRED",
                "IDEMPOTENCY_CONFLICT",
                "IDEMPOTENCY_KEY_REUSED",
                "VERSION_CONFLICT",
                "CONTENT_NOT_PUBLISHED",
                "SYNC_CONFLICT",
                "EVENT_EXPIRED",
                "RATE_LIMITED",
                "FEATURE_DISABLED",
                "SERVICE_UNAVAILABLE",
                "INTERNAL_ERROR"
              ]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 },
            "retryable": { "type": "boolean" },
            "details": {
              "type": "object",
              "description": "Only safe, structured client-action data. It never contains credentials, raw answers, raw media, payment callbacks or protected identity data.",
              "additionalProperties": true
            }
          }
        },
        "successEnvelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data", "meta"],
          "properties": {
            "data": {},
            "meta": { "$ref": "#/$defs/meta" }
          }
        },
        "cursorPageEnvelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data", "meta"],
          "properties": {
            "data": {},
            "meta": { "$ref": "#/$defs/cursorPageMeta" }
          }
        },
        "errorEnvelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["error", "meta"],
          "properties": {
            "error": { "$ref": "#/$defs/error" },
            "meta": { "$ref": "#/$defs/meta" }
          }
        }
      }
    },
    "iam.auth.event-envelope.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/iam/auth-event-envelope.v1.schema.json",
      "title": "IAM auditable event envelope",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "traceId",
        "schemaVersion",
        "aggregateId",
        "dedupeKey",
        "payload"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,63}\\.v[0-9]+$"
        },
        "aggregateId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dedupeKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,255}$"
        },
        "payload": { "type": "object" }
      }
    },
    "iam.authorization.decision.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/iam/authorization-decision.v1.schema.json",
      "title": "IAM authorization decision request",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "resourceType", "resourceId", "phase"],
      "properties": {
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,95}$" },
        "resourceType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._:-]{1,95}$"
        },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "phase": { "type": "string", "enum": ["P1", "P2", "P3"] },
        "contentRights": {
          "type": "string",
          "enum": ["PUBLISHED", "LICENSED", "INTERNAL", "UNKNOWN"]
        },
        "deviceTrust": {
          "type": "string",
          "enum": ["TRUSTED", "STANDARD", "RISK_REVIEW", "UNKNOWN"]
        },
        "consentRequirement": {
          "type": "string",
          "enum": [
            "NONE",
            "TERMS",
            "PRIVACY",
            "ADULT_LEARNING",
            "PRODUCT_ANALYTICS"
          ]
        }
      },
      "x-server-derived-authorization-facts": [
        "subject",
        "tenant",
        "owner",
        "role",
        "permission",
        "consent",
        "policyVersion"
      ]
    },
    "iam.security.error.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/iam/security-error.v1.schema.json",
      "title": "IAM security error envelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "traceId", "code"],
      "properties": {
        "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "traceId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "code": {
          "type": "string",
          "enum": [
            "unauthorized",
            "forbidden",
            "adult_gate_required",
            "consent_required",
            "session_revoked",
            "policy_denied"
          ]
        },
        "retryable": { "type": "boolean" },
        "policyVersion": { "type": "string", "maxLength": 64 }
      }
    },
    "platform.event.reliability-context.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/event-reliability-context.v1.schema.json",
      "title": "Owner-local event reliability context",
      "description": "D2 record attached at the owner Outbox boundary without changing the accepted v1 wire event catalog.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "rootEventId",
        "causationEventId",
        "eventName",
        "aggregateType",
        "aggregateId",
        "aggregateVersion",
        "schemaVersion",
        "requestId",
        "traceId",
        "dedupeKey"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "rootEventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "causationEventId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            },
            { "type": "null" }
          ]
        },
        "eventName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$"
        },
        "aggregateType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,95}$"
        },
        "aggregateId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "aggregateVersion": { "type": "integer", "minimum": 0 },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,95}\\.v[1-9][0-9]*$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{7,127}$"
        },
        "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "dedupeKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,255}$"
        }
      }
    },
    "platform.event.publish-receipt.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/event-publish-receipt.v1.schema.json",
      "title": "Outbox publish receipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "outboxId",
        "producerService",
        "eventId",
        "rootEventId",
        "aggregateId",
        "aggregateVersion",
        "schemaVersion",
        "topic",
        "partitionKey",
        "attempt",
        "state",
        "failureCode",
        "recordedAt"
      ],
      "properties": {
        "receiptId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "outboxId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "producerService": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+-service$"
        },
        "eventId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "rootEventId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "aggregateId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "aggregateVersion": { "type": "integer", "minimum": 0 },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,95}\\.v[1-9][0-9]*$"
        },
        "topic": {
          "type": "string",
          "pattern": "^platform\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
        },
        "partitionKey": { "const": "aggregateId" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
        "state": { "type": "string", "enum": ["PUBLISHED", "DLQ"] },
        "failureCode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "CONFLICT_RETRYABLE",
                "FORBIDDEN",
                "OWNER_MISMATCH",
                "RETRY_BUDGET_EXHAUSTED",
                "SCHEMA_INVALID",
                "STALE_VERSION",
                "TEMPORARY_UNAVAILABLE",
                "TIMEOUT",
                "UNKNOWN_FAILURE"
              ]
            },
            { "type": "null" }
          ]
        },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "PUBLISHED" } },
            "required": ["state"]
          },
          "then": { "properties": { "failureCode": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "state": { "const": "DLQ" } },
            "required": ["state"]
          },
          "then": { "properties": { "failureCode": { "type": "string" } } }
        }
      ]
    },
    "platform.event.consumer-effect-receipt.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/event-consumer-effect-receipt.v1.schema.json",
      "title": "Consumer domain effect and deduplication receipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "consumerGroup",
        "consumerService",
        "eventId",
        "rootEventId",
        "dedupeKey",
        "aggregateId",
        "aggregateVersion",
        "schemaVersion",
        "effectType",
        "effectId",
        "attempt",
        "outcome",
        "auditRef",
        "processedAt"
      ],
      "properties": {
        "receiptId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "consumerGroup": {
          "type": "string",
          "pattern": "^cg\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
        },
        "consumerService": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+-service$"
        },
        "eventId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "rootEventId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "dedupeKey": { "type": "string", "minLength": 8, "maxLength": 256 },
        "aggregateId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "aggregateVersion": { "type": "integer", "minimum": 0 },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,95}\\.v[1-9][0-9]*$"
        },
        "effectType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._:-]{1,95}$"
        },
        "effectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
        "outcome": {
          "type": "string",
          "enum": ["APPLIED", "DUPLICATE_SKIPPED"]
        },
        "auditRef": { "type": "string", "minLength": 8, "maxLength": 128 },
        "processedAt": { "type": "string", "format": "date-time" }
      }
    },
    "platform.event.dlq-record.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/event-dlq-record.v1.schema.json",
      "title": "Immutable dead-letter record",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dlqRecordId",
        "eventId",
        "rootEventId",
        "aggregateId",
        "aggregateVersion",
        "schemaVersion",
        "dedupeKey",
        "requestId",
        "traceId",
        "consumerGroup",
        "failureCode",
        "attempt",
        "failedAt",
        "recoveryState"
      ],
      "properties": {
        "dlqRecordId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "eventId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "rootEventId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "aggregateId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "aggregateVersion": { "type": "integer", "minimum": 0 },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,95}\\.v[1-9][0-9]*$"
        },
        "dedupeKey": { "type": "string", "minLength": 8, "maxLength": 256 },
        "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "traceId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "consumerGroup": {
          "type": "string",
          "pattern": "^cg\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
        },
        "failureCode": {
          "type": "string",
          "enum": [
            "CONFLICT_RETRYABLE",
            "FORBIDDEN",
            "OWNER_MISMATCH",
            "RETRY_BUDGET_EXHAUSTED",
            "SCHEMA_INVALID",
            "STALE_VERSION",
            "TEMPORARY_UNAVAILABLE",
            "TIMEOUT",
            "UNKNOWN_FAILURE"
          ]
        },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
        "failedAt": { "type": "string", "format": "date-time" },
        "recoveryState": {
          "type": "string",
          "enum": [
            "OPEN",
            "REPLAY_REQUESTED",
            "REPLAY_APPROVED",
            "REPLAYING",
            "RESOLVED",
            "MANUAL_RECOVERY_REQUIRED"
          ]
        }
      }
    },
    "platform.event.replay-request.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/event-replay-request.v1.schema.json",
      "title": "Approved event replay request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replayRunId",
        "sourceDlqRecordId",
        "sourceEventId",
        "rootEventId",
        "consumerGroup",
        "requestedByRef",
        "approvedByRef",
        "reasonCode",
        "mode",
        "state",
        "requestedAt",
        "approvedAt",
        "auditRef"
      ],
      "properties": {
        "replayRunId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "sourceDlqRecordId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "sourceEventId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "rootEventId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "consumerGroup": {
          "type": "string",
          "pattern": "^cg\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
        },
        "requestedByRef": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "approvedByRef": { "type": "string", "minLength": 8, "maxLength": 128 },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "mode": {
          "type": "string",
          "enum": ["SINGLE_EVENT", "ORDERED_AGGREGATE_RANGE"]
        },
        "state": { "const": "APPROVED" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "auditRef": { "type": "string", "minLength": 8, "maxLength": 128 }
      }
    },
    "platform.workflow.recovery-task.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/workflow-recovery-task.v1.schema.json",
      "title": "Workflow manual recovery task",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "sourceBusinessId",
        "sagaId",
        "currentStage",
        "retryCount",
        "lastErrorCode",
        "nextAction",
        "ownerService",
        "status",
        "approvalState",
        "auditRef",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "taskId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "sourceBusinessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sagaId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "currentStage": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 5 },
        "lastErrorCode": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
            { "type": "null" }
          ]
        },
        "nextAction": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "ownerService": { "const": "workflow-service" },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "AWAITING_APPROVAL",
            "APPROVED",
            "EXECUTING",
            "RESOLVED",
            "REJECTED",
            "ESCALATED"
          ]
        },
        "approvalState": {
          "type": "string",
          "enum": ["NOT_REQUESTED", "PENDING", "APPROVED", "REJECTED"]
        },
        "auditRef": { "type": "string", "minLength": 8, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "platform.workflow.recovery-closure-receipt.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/workflow-recovery-closure-receipt.v1.schema.json",
      "title": "Manual recovery closure receipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "taskId",
        "sagaId",
        "sourceBusinessId",
        "closureOutcome",
        "domainReceiptRefs",
        "auditRef",
        "closedByRef",
        "closedAt"
      ],
      "properties": {
        "receiptId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "taskId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "sagaId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "sourceBusinessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "closureOutcome": {
          "type": "string",
          "enum": [
            "RECOVERED",
            "COMPENSATED",
            "REJECTED_WITH_REASON",
            "ESCALATED"
          ]
        },
