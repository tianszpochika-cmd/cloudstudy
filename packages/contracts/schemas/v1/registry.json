    "platform.event.outbox-record.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.englishflow.local/platform/event-outbox-record.v1.schema.json",
      "title": "Owner-local transactional Outbox record",
      "description": "D2 storage contract. Payload remains governed by the event-specific catalog schema; this schema does not claim that a runtime row exists.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outboxId",
        "ownerService",
        "eventId",
        "rootEventId",
        "causationEventId",
        "eventName",
        "aggregateType",
        "aggregateId",
        "aggregateVersion",
        "schemaVersion",
        "requestId",
        "traceId",
        "dedupeKey",
        "topic",
        "partitionKey",
        "payload",
        "payloadDigest",
        "state",
        "attempt",
        "leaseOwner",
        "leaseExpiresAt",
        "nextAttemptAt",
        "lastFailureCode",
        "createdAt",
        "updatedAt",
        "publishedAt"
      ],
      "properties": {
        "outboxId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "ownerService": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+-service$"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "rootEventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "causationEventId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$"
        },
        "aggregateType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,95}$"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,95}\\.v[1-9][0-9]*$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{7,127}$"
        },
        "traceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "dedupeKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,255}$"
        },
        "topic": {
          "type": "string",
          "pattern": "^platform\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
        },
        "partitionKey": {
          "const": "aggregateId"
        },
        "payload": {
          "type": "object",
          "description": "Validated against the event-specific payloadSchema before the owner transaction commits."
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "type": "string",
          "enum": ["PENDING", "PUBLISHING", "PUBLISHED", "RETRY_WAIT", "DLQ"]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "leaseOwner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "leaseExpiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextAttemptAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastFailureCode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "CONFLICT_RETRYABLE",
                "FORBIDDEN",
                "OWNER_MISMATCH",
                "RETRY_BUDGET_EXHAUSTED",
                "SCHEMA_INVALID",
                "STALE_VERSION",
                "TEMPORARY_UNAVAILABLE",
                "TIMEOUT",
                "UNKNOWN_FAILURE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PENDING"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "attempt": {
                "const": 0
              },
              "leaseOwner": {
                "type": "null"
              },
              "leaseExpiresAt": {
                "type": "null"
              },
              "nextAttemptAt": {
                "type": "null"
              },
              "lastFailureCode": {
                "type": "null"
              },
              "publishedAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "PUBLISHING"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "leaseOwner": {
                "type": "string"
              },
              "leaseExpiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "nextAttemptAt": {
                "type": "null"
              },
              "publishedAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "PUBLISHED"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "leaseOwner": {
                "type": "null"
              },
              "leaseExpiresAt": {
                "type": "null"
              },
              "nextAttemptAt": {
                "type": "null"
              },
              "lastFailureCode": {
                "type": "null"
              },
              "publishedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "RETRY_WAIT"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "leaseOwner": {
                "type": "null"
              },
              "leaseExpiresAt": {
                "type": "null"
              },
              "nextAttemptAt": {
                "type": "string",
                "format": "date-time"
              },
              "lastFailureCode": {
                "type": "string"
              },
              "publishedAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "DLQ"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "leaseOwner": {
                "type": "null"
              },
              "leaseExpiresAt": {
                "type": "null"
              },
              "nextAttemptAt": {
                "type": "null"
              },
              "lastFailureCode": {
                "type": "string"
              },
              "publishedAt": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
