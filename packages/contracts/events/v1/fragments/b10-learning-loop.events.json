    "B10LearningReviewScheduledV2": {
      "$id": "platform.events.learning.review.scheduled.v2.payload",
      "type": "object",
      "additionalProperties": false,
      "x-p1r-cross-field-invariants": [
        "repairWorkflowState=DELAY_VERIFY_D1 => reasonCodes contains D1_VERIFICATION",
        "repairWorkflowState=DELAY_VERIFY_D7 => reasonCodes contains D7_VERIFICATION",
        "repairWorkflowState=MASTERED => masteryStage in [MASTERED,CONSOLIDATED] and reasonCodes contains D7_VERIFICATION",
        "repairWorkflowState=REOPENED => masteryStage=LEARNING and reasonCodes contains D1_VERIFICATION or D7_VERIFICATION or CATCH_UP_PROTECTION",
        "repairWorkflowState in [REVIEW_QUEUE,LEARNING] has no cross-state coupling; srsStage, repairWorkflowState and masteryStage remain independent",
        "reasonCodes are unique and sorted by Unicode code-point ascending"
      ],
      "required": [
        "tenantId",
        "principalId",
        "queueItemId",
        "logicalItemId",
        "queueVersion",
        "srsStage",
        "repairWorkflowState",
        "masteryStage",
        "sourceAssessmentEventId",
        "sourceItemAssessmentId",
        "algorithmVersion",
        "timePolicyVersion",
        "contentPin",
        "dueLocalDate",
        "dueAt",
        "timezoneId",
        "reasonCodes",
        "scheduledAt"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "principalId": {
          "type": "string",
          "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$"
        },
        "queueItemId": {
          "type": "string",
          "pattern": "^rq_[A-Za-z0-9._:-]{8,127}$"
        },
        "logicalItemId": {
          "type": "string",
          "pattern": "^li_[A-Za-z0-9._:-]{8,127}$"
        },
        "queueVersion": {
          "type": "integer",
          "minimum": 1
        },
        "srsStage": {
          "type": "string",
          "enum": [
            "NEW",
            "LEARNING",
            "MASTERED",
            "CONSOLIDATED"
          ]
        },
        "repairWorkflowState": {
          "type": "string",
          "enum": [
            "REVIEW_QUEUE",
            "LEARNING",
            "DELAY_VERIFY_D1",
            "DELAY_VERIFY_D7",
            "MASTERED",
            "REOPENED"
          ]
        },
        "masteryStage": {
          "type": "string",
          "enum": [
            "NEW",
            "LEARNING",
            "MASTERED",
            "CONSOLIDATED"
          ]
        },
        "sourceAssessmentEventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "sourceItemAssessmentId": {
          "type": "string",
          "pattern": "^aitm_[A-Za-z0-9._:-]{8,127}$"
        },
        "algorithmVersion": {
          "type": "string",
          "enum": [
            "SM2_Q03_V1"
          ]
        },
        "timePolicyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "contentPin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentVersionId",
            "contentEpoch",
            "snapshotId",
            "snapshotHash"
          ],
          "properties": {
            "contentVersionId": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "contentEpoch": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "snapshotId": {
              "type": "string",
              "pattern": "^snap_[A-Za-z0-9._:-]{8,127}$"
            },
            "snapshotHash": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          }
        },
        "dueLocalDate": {
          "type": "string",
          "format": "date"
        },
        "dueAt": {
          "type": "string",
          "format": "date-time"
        },
        "timezoneId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+./-]{0,127}$"
        },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 19,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "RESUME_SESSION",
              "SUBMISSION_CONFIRMATION",
              "D1_VERIFICATION",
              "D7_VERIFICATION",
              "DUE_TODAY",
              "OVERDUE_HIGH_RISK",
              "RECENT_MISTAKE",
              "REPEATED_ERROR_CATEGORY",
              "GOAL_FOUNDATION",
              "GOAL_COLLEGE_CET",
              "GOAL_POSTGRADUATE_ENGLISH",
              "GOAL_WORKPLACE_DAILY",
              "PLAN_CHECKPOINT",
              "NEW_CORE",
              "SKILL_ROTATION",
              "CATCH_UP_PROTECTION",
              "MANUAL_LEGAL_COURSE",
              "GOAL_LIGHT_ITEM_UNAVAILABLE",
              "CONTENT_ESTIMATE_UNSCHEDULABLE"
            ]
          }
        },
        "scheduledAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "oneOf": [
        {
          "title": "D1_VERIFICATION_QUEUE",
          "properties": {
            "repairWorkflowState": {
              "enum": [
                "DELAY_VERIFY_D1"
              ]
            },
            "reasonCodes": {
              "contains": {
                "enum": [
                  "D1_VERIFICATION"
                ]
              }
            }
          }
        },
        {
          "title": "D7_VERIFICATION_QUEUE",
          "properties": {
            "repairWorkflowState": {
              "enum": [
                "DELAY_VERIFY_D7"
              ]
            },
            "reasonCodes": {
              "contains": {
                "enum": [
                  "D7_VERIFICATION"
                ]
              }
            }
          }
        },
        {
          "title": "MASTERED_REPAIR_QUEUE",
          "properties": {
            "repairWorkflowState": {
              "enum": [
                "MASTERED"
              ]
            },
            "masteryStage": {
              "enum": [
                "MASTERED",
                "CONSOLIDATED"
              ]
            },
            "reasonCodes": {
              "contains": {
                "enum": [
                  "D7_VERIFICATION"
                ]
              }
            }
          }
        },
        {
          "title": "REOPENED_REPAIR_QUEUE",
          "properties": {
            "repairWorkflowState": {
              "enum": [
                "REOPENED"
              ]
            },
            "masteryStage": {
              "enum": [
                "LEARNING"
              ]
            },
            "reasonCodes": {
              "contains": {
                "enum": [
                  "D1_VERIFICATION",
                  "D7_VERIFICATION",
                  "CATCH_UP_PROTECTION"
                ]
              }
            }
          }
        },
        {
          "title": "ACTIVE_REVIEW_QUEUE",
          "properties": {
            "repairWorkflowState": {
              "enum": [
                "REVIEW_QUEUE",
                "LEARNING"
              ]
            }
          }
        }
      ]
    },
    "B10LearningReportReadyV1": {
      "$id": "platform.events.learning.report.ready.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "x-p1r-cross-field-invariants": [
        "totalCorrect + totalMistakes = totalItems",
        "scoreBucket=FULL => totalMistakes=0; scoreBucket=ZERO => totalCorrect=0"
      ],
      "required": [
        "tenantId",
        "principalId",
        "reportId",
        "attemptId",
        "sessionId",
        "contentCode",
        "contentVersionId",
        "scoreBucket",
        "totalItems",
        "totalCorrect",
        "totalMistakes",
        "completedAt"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reportId": {
          "type": "string",
          "pattern": "^rpt_[A-Za-z0-9._:-]{8,127}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^aatm_[A-Za-z0-9._:-]{8,127}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^asess_[A-Za-z0-9._:-]{8,127}$"
        },
        "contentCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contentVersionId": {
          "type": "integer",
          "minimum": 1
        },
        "scoreBucket": {
          "type": "string",
          "enum": [
            "FULL",
            "PARTIAL",
            "ZERO"
          ]
        },
        "totalItems": {
          "type": "integer",
          "minimum": 0
        },
        "totalCorrect": {
          "type": "integer",
          "minimum": 0
        },
        "totalMistakes": {
          "type": "integer",
          "minimum": 0
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
