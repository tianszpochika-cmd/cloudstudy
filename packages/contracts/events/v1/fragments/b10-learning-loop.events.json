{
  "events": [
    {
      "eventName": "assessment.item.assessed.v2",
      "domain": "assessment",
      "version": 2,
      "schema": "assessment.event.v2",
      "aggregateType": "assessment_item",
      "aggregateIdField": "itemAssessmentId",
      "x-envelope-required": [
        "eventId",
        "eventName",
        "schema",
        "version",
        "occurredAt",
        "aggregateType",
        "aggregateId",
        "actorId",
        "traceId",
        "requestId",
        "schemaVersion",
        "dedupeKey",
        "payload"
      ],
      "payloadSchema": {
        "$ref": "#/payloadSchemas/B10AssessmentItemAssessedV2"
      },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "publish assessment.item.assessed.v3",
        "consumerRule": "assessment-service 是单题可信 outcome 的不可变 source；消费者按 itemAssessmentId、rulePin.assessmentVersion 与 outcomeDigest 幂等，reasonTrace 按 ruleCode、reasonCode、evidenceRef 升序解释；不接收原始作答、答案 key、规则正文、音频或客户端权限事实。"
      }
    },
    {
      "eventName": "learning.mastery.projected.v2",
      "domain": "learning",
      "version": 2,
      "schema": "learning.event.v2",
      "aggregateType": "mastery_projection",
      "aggregateIdField": "projectionId",
      "x-envelope-required": [
        "eventId",
        "eventName",
        "schema",
        "version",
        "occurredAt",
        "aggregateType",
        "aggregateId",
        "actorId",
        "traceId",
        "requestId",
        "schemaVersion",
        "dedupeKey",
        "payload"
      ],
      "payloadSchema": {
        "$ref": "#/payloadSchemas/B10LearningMasteryProjectedV2"
      },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "publish learning.mastery.projected.v3",
        "consumerRule": "learning-service 是 mastery projection 的唯一写 owner；消费者按 masteryEpochId、projectionVersion 与 evidenceDigest 幂等，evidenceLocalDates 按 ISO local date 升序、reasonTrace 按 ruleCode、reasonCode、evidenceRef 升序解释，三套状态只读且不得反向写入 SRS 或 repair。"
      }
    },
    {
      "eventName": "learning.review.scheduled.v2",
      "domain": "learning",
      "version": 2,
      "schema": "learning.event.v2",
      "aggregateType": "learning_review_queue",
      "aggregateIdField": "queueItemId",
      "x-envelope-required": [
        "eventId",
        "eventName",
        "schema",
        "version",
        "occurredAt",
        "aggregateType",
        "aggregateId",
        "actorId",
        "traceId",
        "requestId",
        "schemaVersion",
        "dedupeKey",
        "payload"
      ],
      "payloadSchema": {
        "$ref": "#/payloadSchemas/B10LearningReviewScheduledV2"
      },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "publish learning.review.scheduled.v3",
        "consumerRule": "learning-service 只发布已由服务端算法、内容 pin 与时区规则确定的队列事实；消费者按 queueItemId、queueVersion 幂等，reasonCodes 按 Unicode code-point 升序解释，不能以客户端时间或状态改写 dueAt。"
      }
    },
    {
      "eventName": "learning.report.ready.v1",
      "domain": "learning",
      "version": 1,
      "schema": "learning.event.v1",
      "aggregateType": "learning_report",
      "aggregateIdField": "reportId",
      "x-envelope-required": [
        "eventId",
        "eventName",
        "schema",
        "version",
        "occurredAt",
        "aggregateType",
        "aggregateId",
        "actorId",
        "traceId",
        "requestId",
        "schemaVersion",
        "dedupeKey",
        "payload"
      ],
      "payloadSchema": {
        "$ref": "#/payloadSchemas/B10LearningReportReadyV1"
      },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "publish learning.report.ready.v2",
        "consumerRule": "assessment-service is the sole writer of immutable reports; consumers are idempotent by reportId and must not reinterpret scoreBucket without rulePin.assessmentVersion. No raw answers, answer keys, rule text, audio or client-side facts are accepted."
      }
    }
  ],
  "payloadSchemas": {
    "B10AssessmentItemAssessedV2": {
      "$id": "platform.events.assessment.item.assessed.v2.payload",
      "type": "object",
      "additionalProperties": false,
      "x-p1r-cross-field-invariants": [
        "objectivePolicyPin is an assessment-service server-predeclared proof; policyVersion and policyDigest identify the immutable legal practice policy",
        "objectiveOutcome=NO_OBJECTIVE_EXPECTED => objectivePolicyPin.objectiveExpected=false and objectivePolicyPin.practiceType in [SPEAKING_SELF_RATING,WRITING_SELF_RATING,ACTIVE_RECALL_SELF_RATING]",
        "objectiveOutcome!=NO_OBJECTIVE_EXPECTED => objectivePolicyPin.objectiveExpected=true and objectivePolicyPin.practiceType=OBJECTIVE_ASSESSMENT",
        "NO_OBJECTIVE_EXPECTED is legal only when objectiveNumerator=0, objectiveDenominator=0, objectiveCorrect=false and guessSignal=false"
      ],
      "required": [
        "tenantId",
        "principalId",
        "itemAssessmentId",
        "attemptId",
        "sessionId",
        "logicalItemId",
        "contentPin",
        "rulePin",
        "reportPin",
        "objectivePolicyPin",
        "objectiveOutcome",
        "objectiveNumerator",
        "objectiveDenominator",
        "objectiveCorrect",
        "guessSignal",
        "semanticErrorCategory",
        "mappingVersion",
        "verificationStage",
        "reasonTrace",
        "outcomeDigest",
        "assessmentFactWatermark",
        "assessedAt"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "principalId": {
          "type": "string",
          "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$"
        },
        "itemAssessmentId": {
          "type": "string",
          "pattern": "^aitm_[A-Za-z0-9._:-]{8,127}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^aatm_[A-Za-z0-9._:-]{8,127}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^asess_[A-Za-z0-9._:-]{8,127}$"
        },
        "logicalItemId": {
          "type": "string",
          "pattern": "^li_[A-Za-z0-9._:-]{8,127}$"
        },
        "contentPin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentVersionId",
            "contentEpoch",
            "snapshotId",
            "snapshotHash"
          ],
          "properties": {
            "contentVersionId": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "contentEpoch": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "snapshotId": {
              "type": "string",
              "pattern": "^snap_[A-Za-z0-9._:-]{8,127}$"
            },
            "snapshotHash": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          }
        },
        "rulePin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answerRuleSetVersion",
            "answerRuleVersion",
            "ruleDigest",
            "completionRuleVersion",
            "assessmentVersion"
          ],
          "properties": {
            "answerRuleSetVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "answerRuleVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "ruleDigest": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "completionRuleVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "assessmentVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            }
          }
        },
        "reportPin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reportId",
            "reportVersion",
            "reportRuleVersion",
            "reportStatus",
            "reportDigest",
            "asOf"
          ],
          "properties": {
            "reportId": {
              "type": "string",
              "pattern": "^rpt_[A-Za-z0-9._:-]{8,127}$"
            },
            "reportVersion": {
              "type": "integer",
              "minimum": 1
            },
            "reportRuleVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "reportStatus": {
              "type": "string",
              "enum": [
                "READY",
                "PARTIAL",
                "FAILED"
              ]
            },
            "reportDigest": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "asOf": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "objectivePolicyPin": {
          "type": "object",
          "additionalProperties": false,
          "description": "Assessment-service server-predeclared proof that determines whether an item is objective-scored. Clients cannot create, override or widen this pin.",
          "required": [
            "practiceType",
            "objectiveExpected",
            "policyVersion",
            "policyDigest"
          ],
          "properties": {
            "practiceType": {
              "type": "string",
              "enum": [
                "OBJECTIVE_ASSESSMENT",
                "SPEAKING_SELF_RATING",
                "WRITING_SELF_RATING",
                "ACTIVE_RECALL_SELF_RATING"
              ]
            },
            "objectiveExpected": {
              "type": "boolean"
            },
            "policyVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "policyDigest": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          }
        },
        "objectiveOutcome": {
          "type": "string",
          "enum": [
            "CORRECT_VERIFIED",
            "INCORRECT",
            "UNANSWERED",
            "REVEALED_BEFORE_ANSWER",
            "GUESSED",
            "NO_OBJECTIVE_EXPECTED"
          ]
        },
        "objectiveNumerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "objectiveDenominator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "objectiveCorrect": {
          "type": "boolean"
        },
        "guessSignal": {
          "type": "boolean"
        },
        "semanticErrorCategory": {
          "type": "string",
          "enum": [
            "KNOWLEDGE_GAP",
            "MEMORY_FUZZY",
            "CONFUSABLE",
            "RULE_CONCEPT",
            "LISTENING_DISCRIMINATION",
            "READING_COMPREHENSION",
            "SPELLING_OR_STRUCTURE",
            "CARELESS_OR_OMISSION",
            "TIME_INSUFFICIENT",
            "UNCLASSIFIED"
          ]
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "verificationStage": {
          "type": "string",
          "enum": [
            "NONE",
            "IMMEDIATE_REPAIR",
            "D1",
            "D7"
          ]
        },
        "reasonTrace": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleCode",
              "ruleVersion",
              "category",
              "reasonCode",
              "evidenceRef"
            ],
            "properties": {
              "ruleCode": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
              },
              "ruleVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "category": {
                "type": "string",
                "enum": [
                  "KNOWLEDGE_GAP",
                  "MEMORY_FUZZY",
                  "CONFUSABLE",
                  "RULE_CONCEPT",
                  "LISTENING_DISCRIMINATION",
                  "READING_COMPREHENSION",
                  "SPELLING_OR_STRUCTURE",
                  "CARELESS_OR_OMISSION",
                  "TIME_INSUFFICIENT",
                  "UNCLASSIFIED"
                ]
              },
              "reasonCode": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
              },
              "evidenceRef": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]{3,191}$"
              }
            }
          }
        },
        "outcomeDigest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "assessmentFactWatermark": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "assessedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "oneOf": [
        {
          "properties": {
            "objectivePolicyPin": {
              "properties": {
                "objectiveExpected": {
                  "enum": [
                    true
                  ]
                },
                "practiceType": {
                  "enum": [
                    "OBJECTIVE_ASSESSMENT"
                  ]
                }
              }
            },
            "objectiveOutcome": {
              "const": "CORRECT_VERIFIED"
            },
            "objectiveNumerator": {
              "const": 1
            },
            "objectiveDenominator": {
              "const": 1
            },
            "objectiveCorrect": {
              "const": true
            },
            "guessSignal": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "objectivePolicyPin": {
              "properties": {
                "objectiveExpected": {
                  "enum": [
                    true
                  ]
                },
                "practiceType": {
                  "enum": [
                    "OBJECTIVE_ASSESSMENT"
                  ]
                }
              }
            },
            "objectiveOutcome": {
              "const": "INCORRECT"
            },
            "objectiveNumerator": {
              "const": 0
            },
            "objectiveDenominator": {
              "const": 1
            },
            "objectiveCorrect": {
              "const": false
            },
            "guessSignal": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "objectivePolicyPin": {
              "properties": {
                "objectiveExpected": {
                  "enum": [
                    true
                  ]
                },
                "practiceType": {
                  "enum": [
                    "OBJECTIVE_ASSESSMENT"
                  ]
                }
              }
            },
            "objectiveOutcome": {
              "const": "UNANSWERED"
            },
            "objectiveNumerator": {
              "const": 0
            },
            "objectiveDenominator": {
              "const": 1
            },
            "objectiveCorrect": {
              "const": false
            },
            "guessSignal": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "objectivePolicyPin": {
              "properties": {
                "objectiveExpected": {
                  "enum": [
                    true
                  ]
                },
                "practiceType": {
                  "enum": [
                    "OBJECTIVE_ASSESSMENT"
                  ]
                }
              }
            },
            "objectiveOutcome": {
              "const": "REVEALED_BEFORE_ANSWER"
            },
            "objectiveNumerator": {
              "const": 0
            },
            "objectiveDenominator": {
              "const": 1
            },
            "objectiveCorrect": {
              "const": false
            },
            "guessSignal": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "objectivePolicyPin": {
              "properties": {
                "objectiveExpected": {
                  "enum": [
                    true
                  ]
                },
                "practiceType": {
                  "enum": [
                    "OBJECTIVE_ASSESSMENT"
                  ]
                }
              }
            },
            "objectiveOutcome": {
              "const": "GUESSED"
            },
            "objectiveNumerator": {
              "const": 1
            },
            "objectiveDenominator": {
              "const": 1
            },
            "objectiveCorrect": {
              "const": true
            },
            "guessSignal": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "objectivePolicyPin": {
              "properties": {
                "objectiveExpected": {
                  "enum": [
                    true
                  ]
                },
                "practiceType": {
                  "enum": [
                    "OBJECTIVE_ASSESSMENT"
                  ]
                }
              }
            },
            "objectiveOutcome": {
              "const": "GUESSED"
            },
            "objectiveNumerator": {
              "const": 0
            },
            "objectiveDenominator": {
              "const": 1
            },
            "objectiveCorrect": {
              "const": false
            },
            "guessSignal": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "objectivePolicyPin": {
              "properties": {
                "objectiveExpected": {
                  "enum": [
                    false
                  ]
                },
                "practiceType": {
                  "enum": [
                    "SPEAKING_SELF_RATING",
                    "WRITING_SELF_RATING",
                    "ACTIVE_RECALL_SELF_RATING"
                  ]
                }
              }
            },
            "objectiveOutcome": {
              "const": "NO_OBJECTIVE_EXPECTED"
            },
            "objectiveNumerator": {
              "const": 0
            },
            "objectiveDenominator": {
              "const": 0
            },
            "objectiveCorrect": {
              "const": false
            },
            "guessSignal": {
              "const": false
            }
          }
        }
      ]
    },
    "B10LearningMasteryProjectedV2": {
      "$id": "platform.events.learning.mastery.projected.v2.payload",
      "type": "object",
      "additionalProperties": false,
      "x-p1r-cross-field-invariants": [
        "masteryStageAfter=MASTERED => d7Gate.result=PASSED and d7Gate.reasonCode=D7_PASSED and evidenceCount=3 and evidenceLocalDates.length=3 and aggregateScore>=85",
        "masteryStageAfter=CONSOLIDATED => d7Gate.result=PASSED and d7Gate.reasonCode=D7_PASSED and evidenceCount=3 and evidenceLocalDates.length=3 and aggregateScore>=95 and latestEffectiveQuality=3 and latestGuessSignal=false",
        "evidenceCount=length(evidenceLocalDates); evidenceLocalDates are unique and sorted by ISO local date ascending",
        "reasonTrace is sorted by Unicode code-point tuple (ruleCode,reasonCode,evidenceRef) ascending"
      ],
      "required": [
        "tenantId",
        "principalId",
        "projectionId",
        "logicalItemId",
        "sourceAssessmentEventId",
        "sourceItemAssessmentId",
        "contentPin",
        "masteryStageBefore",
        "masteryStageAfter",
        "evidenceCount",
        "evidenceDigest",
        "evidenceLocalDates",
        "d7Gate",
        "aggregateScore",
        "latestEffectiveQuality",
        "latestGuessSignal",
        "masteryEpochId",
        "masteryEpochVersion",
        "projectionVersion",
        "masteryRuleVersion",
        "masteryFactWatermark",
        "reasonTrace",
        "projectedAt"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "principalId": {
          "type": "string",
          "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$"
        },
        "projectionId": {
          "type": "string",
          "pattern": "^mp_[A-Za-z0-9._:-]{8,127}$"
        },
        "logicalItemId": {
          "type": "string",
          "pattern": "^li_[A-Za-z0-9._:-]{8,127}$"
        },
        "sourceAssessmentEventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "sourceItemAssessmentId": {
          "type": "string",
          "pattern": "^aitm_[A-Za-z0-9._:-]{8,127}$"
        },
        "contentPin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentVersionId",
            "contentEpoch",
            "snapshotId",
            "snapshotHash"
          ],
          "properties": {
            "contentVersionId": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "contentEpoch": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "snapshotId": {
              "type": "string",
              "pattern": "^snap_[A-Za-z0-9._:-]{8,127}$"
            },
            "snapshotHash": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          }
        },
        "masteryStageBefore": {
          "type": "string",
          "enum": [
            "NEW",
            "LEARNING",
            "MASTERED",
            "CONSOLIDATED"
          ]
        },
        "masteryStageAfter": {
          "type": "string",
          "enum": [
            "NEW",
            "LEARNING",
            "MASTERED",
            "CONSOLIDATED"
          ]
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "evidenceLocalDates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "d7Gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "reasonCode"
          ],
          "properties": {
            "result": {
              "type": "string",
              "enum": [
                "NOT_DUE",
                "NOT_PASSED",
                "PASSED",
                "FAILED"
              ]
            },
            "reasonCode": {
              "type": "string",
              "enum": [
                "D7_NOT_DUE",
                "D7_NOT_PASSED",
                "D7_PASSED",
                "D7_FAILED",
                "MASTERY_GATE_NOT_MET"
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "result": {
                  "const": "NOT_DUE"
                },
                "reasonCode": {
                  "const": "D7_NOT_DUE"
                }
              }
            },
            {
              "properties": {
                "result": {
                  "const": "NOT_PASSED"
                },
                "reasonCode": {
                  "const": "D7_NOT_PASSED"
                }
              }
            },
            {
              "properties": {
                "result": {
                  "const": "NOT_PASSED"
                },
                "reasonCode": {
                  "const": "MASTERY_GATE_NOT_MET"
                }
              }
            },
            {
              "properties": {
                "result": {
                  "const": "PASSED"
                },
                "reasonCode": {
                  "const": "D7_PASSED"
                }
              }
            },
            {
              "properties": {
                "result": {
                  "const": "FAILED"
                },
                "reasonCode": {
                  "const": "D7_FAILED"
                }
              }
            }
          ]
        },
        "aggregateScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "latestEffectiveQuality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "latestGuessSignal": {
          "type": "boolean"
        },
        "masteryEpochId": {
          "type": "string",
          "pattern": "^mep_[A-Za-z0-9._:-]{8,127}$"
        },
        "masteryEpochVersion": {
          "type": "integer",
          "minimum": 1
        },
        "projectionVersion": {
          "type": "integer",
          "minimum": 1
        },
        "masteryRuleVersion": {
          "type": "string",
