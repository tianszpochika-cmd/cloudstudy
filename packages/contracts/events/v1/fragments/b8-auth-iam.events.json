{
  "events": [
    {
      "eventName": "auth.account.registered.v1",
      "domain": "auth",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_account",
      "aggregateIdField": "principalId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/AuthAccountRegistered" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 auth.account.registered.v2",
        "consumerRule": "只记录本地账号建立后的最小身份事实；密码、Access Token、Refresh Token 和原始凭证不进入事件。"
      }
    },
    {
      "eventName": "auth.login.succeeded.v1",
      "domain": "auth",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_session",
      "aggregateIdField": "sessionId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/AuthLoginSucceeded" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 auth.login.succeeded.v2",
        "consumerRule": "只消费本地账号登录后建立的 principal/session 结果；不传播密码、Access Token、Refresh Token 或原始凭证。"
      }
    },
    {
      "eventName": "auth.principal.mapped.v1",
      "domain": "auth",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_principal",
      "aggregateIdField": "principalId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/AuthPrincipalMapped" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 auth.principal.mapped.v2",
        "consumerRule": "按 principalId 幂等；只消费映射状态和版本，不传播密码或原始凭证。"
      }
    },
    {
      "eventName": "auth.session.rotated.v1",
      "domain": "auth",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_session",
      "aggregateIdField": "sessionId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/AuthSessionRotated" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 auth.session.rotated.v2",
        "consumerRule": "按 rotationId 去重；payload 不含 access/refresh token。"
      }
    },
    {
      "eventName": "auth.session.replay_detected.v1",
      "domain": "auth",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_session",
      "aggregateIdField": "sessionId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/AuthSessionReplayDetected" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 auth.session.replay_detected.v2",
        "consumerRule": "安全消费者按 sessionId、detectionId 和 dedupeKey 去重，并保持撤销 fail-closed。"
      }
    },
    {
      "eventName": "auth.device.revoked.v1",
      "domain": "auth",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_device",
      "aggregateIdField": "deviceId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/AuthDeviceRevoked" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 auth.device.revoked.v2",
        "consumerRule": "设备、WebSocket 和通知消费者按 deviceId/sessionId 幂等撤销。"
      }
    },
    {
      "eventName": "iam.session.revoked.v1",
      "domain": "iam",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_session",
      "aggregateIdField": "sessionId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/IamSessionRevoked" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 iam.session.revoked.v2",
        "consumerRule": "按 sessionId 和 dedupeKey 幂等撤销；撤销事实不能被外部系统恢复，payload 不含任何 Token。"
      }
    },
    {
      "eventName": "auth.consent.updated.v1",
      "domain": "auth",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_consent",
      "aggregateIdField": "consentId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/AuthConsentUpdated" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 auth.consent.updated.v2",
        "consumerRule": "只传 consent type/version/decision；撤回和更新事实可审计、可重放。"
      }
    },
    {
      "eventName": "auth.adult_gate.rejected.v1",
      "domain": "auth",
      "version": 1,
      "schema": "iam.auth.event.v1",
      "aggregateType": "iam_adult_gate",
      "aggregateIdField": "decisionId",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/AuthAdultGateRejected" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 auth.adult_gate.rejected.v2",
        "consumerRule": "拒绝事件不传出生日期、年龄原值或 K12 主体事实。"
      }
    },
    {
      "eventName": "iam.policy.version_changed.v1",
      "domain": "iam",
      "version": 1,
      "schema": "iam.security.event.v1",
      "aggregateType": "iam_policy",
      "aggregateIdField": "policyName",
      "x-envelope-required": ["eventId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "payloadSchema": { "$ref": "#/payloadSchemas/IamPolicyVersionChanged" },
      "compatibility": {
        "strategy": "additive",
        "breakingChange": "发布 iam.policy.version_changed.v2",
        "consumerRule": "PEP/PDP 按 policyVersion 选择策略包；未知版本默认拒绝。"
      }
    }
  ],
  "payloadSchemas": {
    "AuthAccountRegistered": {
      "$id": "platform.events.auth.account.registered.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "accountStatus", "registeredAt"],
      "properties": {
        "principalId": { "type": "string", "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$" },
        "accountStatus": { "type": "string", "const": "ACTIVE" },
        "registeredAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuthLoginSucceeded": {
      "$id": "platform.events.auth.login.succeeded.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "sessionId", "deviceId", "authMethod", "loggedInAt"],
      "properties": {
        "principalId": { "type": "string", "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$" },
        "sessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$" },
        "deviceId": { "type": "string", "pattern": "^dev_[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$" },
        "authMethod": { "type": "string", "const": "PASSWORD" },
        "loggedInAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuthPrincipalMapped": {
      "$id": "platform.events.auth.principal.mapped.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "mappingStatus", "adultGateStatus", "mappedAt"],
      "properties": {
        "principalId": { "type": "string", "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$" },
        "mappingStatus": { "type": "string", "enum": ["CREATED", "LINKED", "REJECTED"] },
        "adultGateStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "mappedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuthSessionRotated": {
      "$id": "platform.events.auth.session.rotated.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "rotationId", "deviceId", "sessionGeneration", "rotatedAt"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$" },
        "rotationId": { "type": "string", "pattern": "^rot_[A-Za-z0-9._:-]{15,127}$" },
        "deviceId": { "type": "string", "pattern": "^dev_[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$" },
        "sessionGeneration": { "type": "integer", "minimum": 1 },
        "rotatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuthSessionReplayDetected": {
      "$id": "platform.events.auth.session.replay_detected.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "deviceId", "detectionId", "detectionCode", "revocationStatus", "detectedAt"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$" },
        "deviceId": { "type": "string", "pattern": "^dev_[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$" },
        "detectionId": { "type": "string", "pattern": "^rpl_[A-Za-z0-9._:-]{15,127}$" },
        "detectionCode": { "type": "string", "const": "REFRESH_REUSE" },
        "revocationStatus": { "type": "string", "enum": ["SESSION_REVOKED", "PENDING_REVIEW"] },
        "detectedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuthDeviceRevoked": {
      "$id": "platform.events.auth.device.revoked.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "sessionId", "reasonCode", "revokedAt"],
      "properties": {
        "deviceId": { "type": "string", "pattern": "^dev_[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$" },
        "sessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$" },
        "reasonCode": { "type": "string", "enum": ["LOGOUT", "KICKED", "REPLAY_DETECTED", "RISK_FREEZE", "ADMIN"] },
        "revokedAt": { "type": "string", "format": "date-time" }
      }
    },
    "IamSessionRevoked": {
      "$id": "platform.events.iam.session.revoked.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "sessionId", "deviceId", "reasonCode", "revocationStatus", "revokedAt"],
      "properties": {
        "principalId": { "type": "string", "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$" },
        "sessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$" },
        "deviceId": { "type": "string", "pattern": "^dev_[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$" },
        "reasonCode": { "type": "string", "enum": ["LOGOUT", "KICKED", "REFRESH_REUSE", "RISK_FREEZE", "ADMIN"] },
        "revocationStatus": { "type": "string", "const": "REVOKED" },
        "revokedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuthConsentUpdated": {
      "$id": "platform.events.auth.consent.updated.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "consentType", "consentVersion", "decision", "updatedAt"],
      "properties": {
        "principalId": { "type": "string", "pattern": "^prn_[A-Za-z0-9._:-]{15,127}$" },
        "consentType": { "type": "string", "enum": ["TERMS", "PRIVACY", "ADULT_LEARNING", "PRODUCT_ANALYTICS"] },
        "consentVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "decision": { "type": "string", "enum": ["ACCEPTED", "WITHDRAWN"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuthAdultGateRejected": {
      "$id": "platform.events.auth.adult_gate.rejected.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "reasonCode", "policyVersion", "rejectedAt"],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^dec_[A-Za-z0-9._:-]{15,127}$" },
        "reasonCode": { "type": "string", "enum": ["UNDER_ADULT_THRESHOLD", "EVIDENCE_REQUIRED", "PHASE_DISABLED"] },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "rejectedAt": { "type": "string", "format": "date-time" }
      }
    },
    "IamPolicyVersionChanged": {
      "$id": "platform.events.iam.policy.version_changed.v1.payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["policyName", "previousVersion", "currentVersion", "activationMode", "changedAt"],
      "properties": {
        "policyName": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,95}$" },
        "previousVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "currentVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "activationMode": { "type": "string", "enum": ["SCHEDULED", "IMMEDIATE", "ROLLBACK"] },
        "changedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
