    "B12SocialReportCreated": { "$id": "platform.events.social.report.created.v1.payload", "type": "object", "additionalProperties": false, "required": ["reportId", "roomId", "targetRef", "categoryCode", "state"], "properties": { "reportId": { "type": "string", "maxLength": 128 }, "roomId": { "type": "string", "maxLength": 128 }, "targetRef": { "type": "string", "maxLength": 128 }, "categoryCode": { "type": "string", "enum": ["HARASSMENT", "SPAM", "INAPPROPRIATE_BEHAVIOR", "SAFETY"] }, "state": { "type": "string", "enum": ["OPEN", "REVIEWING", "RESOLVED", "DISMISSED"] } } },
