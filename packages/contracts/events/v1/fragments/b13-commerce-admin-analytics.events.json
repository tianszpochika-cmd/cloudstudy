{
  "version": "1.0.0",
  "events": [
    { "eventName": "commerce.order.created.v1", "domain": "commerce", "version": 1, "schema": "commerce.event.v1", "aggregateType": "commerce_order", "aggregateIdField": "orderId", "x-envelope-required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "payload"], "payloadSchema": { "$ref": "#/payloadSchemas/B13CommerceOrderCreated" }, "compatibility": { "strategy": "additive", "breakingChange": "publish commerce.order.created.v2", "consumerRule": "按 orderId、priceSnapshotId 和 dedupeKey 幂等；事件不携带支付凭证或主体原始身份。" } },
    { "eventName": "commerce.payment.callback_received.v1", "domain": "commerce", "version": 1, "schema": "commerce.event.v1", "aggregateType": "payment_callback", "aggregateIdField": "providerEventRef", "x-envelope-required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "payload"], "payloadSchema": { "$ref": "#/payloadSchemas/B13CommercePaymentCallback" }, "compatibility": { "strategy": "additive", "breakingChange": "publish commerce.payment.callback_received.v2", "consumerRule": "只发布服务端验证后的状态摘要；provider 回调原文、签名和凭证不得进入事件。" } },
    { "eventName": "commerce.entitlement.activated.v1", "domain": "commerce", "version": 1, "schema": "commerce.event.v1", "aggregateType": "entitlement", "aggregateIdField": "entitlementId", "x-envelope-required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "payload"], "payloadSchema": { "$ref": "#/payloadSchemas/B13CommerceEntitlementActivated" }, "compatibility": { "strategy": "additive", "breakingChange": "publish commerce.entitlement.activated.v2", "consumerRule": "权益只能由 commerce-service 在支付验证或激活码核销后发布；消费者按 entitlementId 幂等。" } },
    { "eventName": "commerce.refund.completed.v1", "domain": "commerce", "version": 1, "schema": "commerce.event.v1", "aggregateType": "commerce_refund", "aggregateIdField": "refundId", "x-envelope-required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "payload"], "payloadSchema": { "$ref": "#/payloadSchemas/B13CommerceRefundCompleted" }, "compatibility": { "strategy": "additive", "breakingChange": "publish commerce.refund.completed.v2", "consumerRule": "退款事实不可变且可重放；不得以客户端状态覆盖订单或权益。" } },
    { "eventName": "commerce.order.reconciled.v1", "domain": "commerce", "version": 1, "schema": "commerce.event.v1", "aggregateType": "commerce_reconciliation", "aggregateIdField": "batchRef", "x-envelope-required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "payload"], "payloadSchema": { "$ref": "#/payloadSchemas/B13CommerceOrderReconciled" }, "compatibility": { "strategy": "additive", "breakingChange": "publish commerce.order.reconciled.v2", "consumerRule": "对账只发布差异摘要和回放状态；不跨服务直接写订单事实。" } },
    { "eventName": "support.ticket.created.v1", "domain": "support", "version": 1, "schema": "support.event.v1", "aggregateType": "support_ticket", "aggregateIdField": "ticketId", "x-envelope-required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "payload"], "payloadSchema": { "$ref": "#/payloadSchemas/B13SupportTicketCreated" }, "compatibility": { "strategy": "additive", "breakingChange": "publish support.ticket.created.v2", "consumerRule": "工单事件只包含分类码、优先级、SLA 和脱敏引用，不包含自由文本或附件内容。" } },
    { "eventName": "analytics.metric.projected.v1", "domain": "analytics", "version": 1, "schema": "analytics.event.v1", "aggregateType": "metric_projection", "aggregateIdField": "projectionRef", "x-envelope-required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "payload"], "payloadSchema": { "$ref": "#/payloadSchemas/B13AnalyticsMetricProjected" }, "compatibility": { "strategy": "additive", "breakingChange": "publish analytics.metric.projected.v2", "consumerRule": "指标是版本化只读投影；下游按 projectionRef、metricVersion 和窗口幂等。" } },
    { "eventName": "analytics.recompute.requested.v1", "domain": "analytics", "version": 1, "schema": "analytics.event.v1", "aggregateType": "analytics_recompute", "aggregateIdField": "jobId", "x-envelope-required": ["eventId", "eventName", "schema", "version", "occurredAt", "aggregateType", "aggregateId", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey", "payload"], "payloadSchema": { "$ref": "#/payloadSchemas/B13AnalyticsRecomputeRequested" }, "compatibility": { "strategy": "additive", "breakingChange": "publish analytics.recompute.requested.v2", "consumerRule": "重算请求只触发可回放任务，不改变领域事实；按 jobId 和窗口幂等。" } }
  ],
  "payloadSchemas": {
    "B13CommerceOrderCreated": { "$id": "platform.events.commerce.order.created.v1.payload", "type": "object", "additionalProperties": false, "required": ["orderId", "skuId", "priceSnapshotId", "amountMinor", "currency", "state"], "properties": { "orderId": { "type": "string", "maxLength": 128 }, "skuId": { "type": "string", "maxLength": 128 }, "priceSnapshotId": { "type": "string", "maxLength": 128 }, "amountMinor": { "type": "integer", "minimum": 0 }, "currency": { "type": "string", "maxLength": 3 }, "state": { "type": "string", "enum": ["CREATED", "PENDING_PAYMENT", "PAYMENT_PENDING"] } } },
    "B13CommercePaymentCallback": { "$id": "platform.events.commerce.payment.callback_received.v1.payload", "type": "object", "additionalProperties": false, "required": ["providerEventRef", "orderRef", "callbackState", "amountMinor", "currency", "verificationRef"], "properties": { "providerEventRef": { "type": "string", "maxLength": 160 }, "orderRef": { "type": "string", "maxLength": 128 }, "callbackState": { "type": "string", "enum": ["VERIFIED_PAID", "VERIFIED_REFUNDED", "REJECTED"] }, "amountMinor": { "type": "integer", "minimum": 0 }, "currency": { "type": "string", "maxLength": 3 }, "verificationRef": { "type": "string", "maxLength": 128 } } },
    "B13CommerceEntitlementActivated": { "$id": "platform.events.commerce.entitlement.activated.v1.payload", "type": "object", "additionalProperties": false, "required": ["entitlementId", "entitlementCode", "sourceRef", "startsAt", "expiresAt", "activationReason"], "properties": { "entitlementId": { "type": "string", "maxLength": 128 }, "entitlementCode": { "type": "string", "maxLength": 96 }, "sourceRef": { "type": "string", "maxLength": 128 }, "startsAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": ["string", "null"], "format": "date-time", "nullable": true }, "activationReason": { "type": "string", "enum": ["VERIFIED_PAYMENT", "ACTIVATION_CODE"] } } },
    "B13CommerceRefundCompleted": { "$id": "platform.events.commerce.refund.completed.v1.payload", "type": "object", "additionalProperties": false, "required": ["refundId", "orderRef", "state", "amountMinor", "currency", "completedAt"], "properties": { "refundId": { "type": "string", "maxLength": 128 }, "orderRef": { "type": "string", "maxLength": 128 }, "state": { "type": "string", "enum": ["SUCCEEDED", "REJECTED"] }, "amountMinor": { "type": "integer", "minimum": 0 }, "currency": { "type": "string", "maxLength": 3 }, "completedAt": { "type": "string", "format": "date-time" } } },
    "B13CommerceOrderReconciled": { "$id": "platform.events.commerce.order.reconciled.v1.payload", "type": "object", "additionalProperties": false, "required": ["batchRef", "provider", "differenceCount", "state", "domainFactsUntouched"], "properties": { "batchRef": { "type": "string", "maxLength": 128 }, "provider": { "type": "string", "maxLength": 32 }, "differenceCount": { "type": "integer", "minimum": 0 }, "state": { "type": "string", "enum": ["MATCHED", "DIFF_FOUND", "REPLAYED"] }, "domainFactsUntouched": { "type": "boolean", "const": true } } },
    "B13SupportTicketCreated": { "$id": "platform.events.support.ticket.created.v1.payload", "type": "object", "additionalProperties": false, "required": ["ticketId", "categoryCode", "priority", "slaDueAt", "redactionVersion"], "properties": { "ticketId": { "type": "string", "maxLength": 128 }, "categoryCode": { "type": "string", "maxLength": 64 }, "priority": { "type": "string", "maxLength": 32 }, "slaDueAt": { "type": "string", "format": "date-time" }, "redactionVersion": { "type": "string", "maxLength": 32 } } },
    "B13AnalyticsMetricProjected": { "$id": "platform.events.analytics.metric.projected.v1.payload", "type": "object", "additionalProperties": false, "required": ["projectionRef", "metricCode", "metricVersion", "windowStart", "windowEnd", "value", "state"], "properties": { "projectionRef": { "type": "string", "maxLength": 128 }, "metricCode": { "type": "string", "maxLength": 96 }, "metricVersion": { "type": "string", "maxLength": 32 }, "windowStart": { "type": "string", "format": "date-time" }, "windowEnd": { "type": "string", "format": "date-time" }, "value": { "type": "number" }, "state": { "type": "string", "enum": ["READY", "STALE", "UNAVAILABLE"] } } },
    "B13AnalyticsRecomputeRequested": { "$id": "platform.events.analytics.recompute.requested.v1.payload", "type": "object", "additionalProperties": false, "required": ["jobId", "metricCode", "metricVersion", "windowStart", "windowEnd", "reasonCode"], "properties": { "jobId": { "type": "string", "maxLength": 128 }, "metricCode": { "type": "string", "maxLength": 96 }, "metricVersion": { "type": "string", "maxLength": 32 }, "windowStart": { "type": "string", "format": "date-time" }, "windowEnd": { "type": "string", "format": "date-time" }, "reasonCode": { "type": "string", "maxLength": 96 } } }
  }
}
