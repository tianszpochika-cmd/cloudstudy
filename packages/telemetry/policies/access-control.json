{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policyId": "yuxuexing-access-control",
  "version": "1.0.0",
  "defaultEffect": "deny",
  "tenantBoundary": {
    "resourceTenantField": "tenantId",
    "selfIdentityFields": ["ownerId", "subjectId", "userId", "actorId"],
    "missingTenantEffect": "deny",
    "crossTenantEffect": "deny",
    "globalRoles": []
  },
  "roles": {
    "learner": {
      "scope": "self",
      "permissions": [
        { "resource": "profile", "actions": ["read", "update"], "scope": "self" },
        { "resource": "learning-record", "actions": ["read", "create"], "scope": "self" },
        { "resource": "study-session", "actions": ["read", "create", "update"], "scope": "self" },
        { "resource": "assessment-attempt", "actions": ["read", "create", "update"], "scope": "self" },
        { "resource": "export", "actions": ["create", "read"], "scope": "self", "exportPolicy": "learner-self" }
      ]
    },
    "admin": {
      "scope": "tenant",
      "permissions": [
        { "resource": "user", "actions": ["read", "list", "update"], "scope": "tenant" },
        { "resource": "profile", "actions": ["read"], "scope": "tenant" },
        { "resource": "learning-record", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "assessment-attempt", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "content", "actions": ["read", "list", "create", "update", "publish", "unpublish"], "scope": "tenant" },
        { "resource": "media", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "commerce", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "entitlement", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "audit-log", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "export", "actions": ["create", "read"], "scope": "tenant", "exportPolicy": "admin-tenant" }
      ]
    },
    "content-editor": {
      "scope": "tenant",
      "permissions": [
        { "resource": "content", "actions": ["read", "list", "create", "update", "submit-review"], "scope": "tenant" },
        { "resource": "media", "actions": ["read", "list", "create", "update"], "scope": "tenant" },
        { "resource": "export", "actions": ["create", "read"], "scope": "tenant", "exportPolicy": "content-editor" }
      ]
    },
    "finance": {
      "scope": "tenant",
      "permissions": [
        { "resource": "commerce", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "payment", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "entitlement", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "export", "actions": ["create", "read"], "scope": "tenant", "exportPolicy": "finance" }
      ]
    },
    "auditor": {
      "scope": "tenant",
      "permissions": [
        { "resource": "audit-log", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "export", "actions": ["create", "read"], "scope": "tenant", "exportPolicy": "audit" }
      ]
    },
    "finance-auditor": {
      "scope": "tenant",
      "permissions": [
        { "resource": "commerce", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "payment", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "entitlement", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "audit-log", "actions": ["read", "list"], "scope": "tenant" },
        { "resource": "export", "actions": ["create", "read"], "scope": "tenant", "exportPolicy": "finance-auditor" }
      ]
    }
  },
  "resources": [
    "profile",
    "learning-record",
    "study-session",
    "assessment-attempt",
    "user",
    "content",
    "media",
    "commerce",
    "payment",
    "entitlement",
    "audit-log",
    "export"
  ],
  "actions": [
    "read",
    "list",
    "create",
    "update",
    "publish",
    "unpublish",
    "submit-review"
  ],
  "exportPolicies": {
