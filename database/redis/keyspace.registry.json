      "atomicity": {"strategy": "atomic_counter_with_boundary_expiry", "operations": ["INCR", "EXPIRE_AT"], "notAuthoritative": true},
      "limits": {"window": "local_day", "maxCount": 10},
      "sourceRefs": ["07_自习室社群与用户基础服务详细设计.md:261"]
    },
    {
      "id": "auth.rate.ip.day",
      "domain": "auth",
