{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "redis.keyspace.v1",
  "redisVersion": "7.x",
  "description": "语学星 Redis 7 短状态、互斥与可重建投影注册表。Redis 不承载长期事实、审计或任何明文凭证。",
  "globalRules": {
    "keyEncoding": "UTF-8",
    "keyMaxLength": 160,
    "literalSegmentPattern": "^[a-z][a-z0-9_-]*$",
    "parameterSyntax": "{camelCaseName}",
    "allKeysMustExpire": true,
    "defaultEvictionPolicy": "volatile-ttl",
    "sensitiveFieldPolicy": "raw_sensitive_values_forbidden",
    "sourceOfTruth": "mysql_or_durable_event_store"
  },
  "entries": [
    {
      "id": "auth.session.projection",
      "domain": "auth",
      "purpose": "短期设备会话在线投影；不保存 Access/Refresh 原文。",
      "keyTemplate": "auth:session:{sessionId}",
      "parameters": [{"name": "sessionId", "type": "opaqueId", "rawSensitiveAllowed": false}],
      "redisType": "hash",
      "valueEncoding": "field_values_json_safe",
      "ttl": {"kind": "fixed", "seconds": 7200},
      "owner": "core-api.auth",
      "rebuildable": true,
      "sourceOfTruth": "mysql.usr_device_session",
      "eviction": {"policy": "volatile-ttl", "onEvict": "rebuild_from_mysql_or_treat_as_offline"},
      "security": {"rawSensitiveAllowed": false, "hashOnlyFields": ["deviceIdHash", "ipHash"], "failMode": "closed"},
      "atomicity": {"strategy": "compare_and_delete_for_logout", "operations": ["HSET", "EXPIRE", "HGETALL"], "notAuthoritative": true},
      "sourceRefs": ["07_自习室社群与用户基础服务详细设计.md:35-38", "07_自习室社群与用户基础服务详细设计.md:277-294"]
    },
    {
      "id": "auth.otp.challenge",
      "domain": "auth",
      "purpose": "一次性 OTP 挑战；只存挑战摘要/计数，不存验证码明文。",
      "keyTemplate": "auth:otp:{subjectHash}:{channel}",
      "parameters": [{"name": "subjectHash", "type": "hmacSha256", "rawSensitiveAllowed": false}, {"name": "channel", "type": "enum", "enum": ["sms"], "rawSensitiveAllowed": false}],
      "redisType": "string",
      "valueEncoding": "json_hash_attempts_only",
      "ttl": {"kind": "fixed", "seconds": 300},
      "owner": "core-api.auth",
      "rebuildable": true,
      "sourceOfTruth": "none_challenge_is_ephemeral",
      "eviction": {"policy": "volatile-ttl", "onEvict": "fail_auth_and_request_new_otp"},
      "security": {"rawSensitiveAllowed": false, "hashOnlyFields": ["subjectHash", "otpDigest"], "failMode": "closed"},
      "atomicity": {"strategy": "lua_check_attempt_and_getdel", "operations": ["SET_NX_EX", "GETDEL"], "notAuthoritative": true},
      "limits": {"maxAttempts": 5, "successes": 1},
      "sourceRefs": ["07_自习室社群与用户基础服务详细设计.md:97", "07_自习室社群与用户基础服务详细设计.md:261"]
    },
    {
      "id": "auth.rate.sms.subject.minute",
      "domain": "auth",
      "purpose": "同一手机号哈希的短信发送 60 秒窗口。",
      "keyTemplate": "rate:auth:sms:phone:{subjectHash}:60s",
      "parameters": [{"name": "subjectHash", "type": "hmacSha256", "rawSensitiveAllowed": false}],
      "redisType": "string",
      "valueEncoding": "integer_counter",
      "ttl": {"kind": "fixed", "seconds": 60},
      "owner": "core-api.auth",
      "rebuildable": true,
      "sourceOfTruth": "none_rate_window",
      "eviction": {"policy": "volatile-ttl", "onEvict": "allow_after_provider_and_global_checks"},
      "security": {"rawSensitiveAllowed": false, "hashOnlyFields": ["subjectHash"], "failMode": "closed"},
      "atomicity": {"strategy": "atomic_counter_with_first_write_expiry", "operations": ["INCR", "EXPIRE_NX"], "notAuthoritative": true},
      "limits": {"windowSeconds": 60, "maxCount": 1},
      "sourceRefs": ["07_自习室社群与用户基础服务详细设计.md:261"]
    },
    {
      "id": "auth.rate.sms.subject.day",
