      "redisType": "string",
      "valueEncoding": "integer_counter",
      "ttl": {"kind": "fixed", "seconds": 172800},
      "owner": "core-api.auth",
      "rebuildable": true,
      "sourceOfTruth": "none_rate_window",
      "eviction": {"policy": "volatile-ttl", "onEvict": "fail_closed_until_boundary_or_recompute"},
      "security": {"rawSensitiveAllowed": false, "hashOnlyFields": ["ipHash"], "failMode": "closed"},
      "atomicity": {"strategy": "atomic_counter_with_boundary_expiry", "operations": ["INCR", "EXPIRE_AT"], "notAuthoritative": true},
      "limits": {"window": "local_day", "maxCount": 20},
      "sourceRefs": ["07_自习室社群与用户基础服务详细设计.md:261"]
    },
    {
      "id": "auth.refresh.lock",
      "domain": "auth",
      "purpose": "Refresh 轮换短互斥；Refresh 只以 hash 进入 MySQL，Redis 不保存原文。",
