{
  "name": "englishflow",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "pnpm ports:check && turbo dev",
    "ports:check": "node scripts/check-fixed-ports.mjs",
    "contracts:validate": "node scripts/contracts/validate-contracts.mjs",
    "contracts:generate": "node scripts/contracts/generate-contracts.mjs",
    "contracts:compatibility": "node scripts/contracts/compatibility-diff.mjs",
    "contracts:merge": "node scripts/contracts/merge-b1-fragments.mjs --write",
    "contracts:b2:merge": "node scripts/contracts/merge-b1-fragments.mjs --write",
    "contracts:b1:merge": "node scripts/contracts/merge-b1-fragments.mjs --write",
    "test:b1": "node --test tests/b1/*.test.mjs",
    "test:b2": "node --test tests/b2/integration-b2.test.mjs",
    "contracts:b3:merge": "node scripts/contracts/merge-b1-fragments.mjs --write",
    "test:b3": "node --test tests/b3/*.test.mjs",
    "test:b4": "node --test tests/b4/*.test.mjs",
    "test:b5": "node --test tests/b5/*.test.mjs",
    "test:b6": "node --test tests/b6/*.test.mjs",
    "test:b7": "node --test tests/b7/*.test.mjs",
    "test:b8": "node --test tests/b8/*.test.mjs",
    "test:b9": "node --test tests/b9/*.test.mjs",
    "test:b10": "node --test tests/b10/*.test.mjs",
    "test:b11": "node --test tests/b11/*.test.mjs",
    "test:b12": "node --test tests/b12/*.test.mjs",
    "test:b13": "node --test tests/b13/*.test.mjs",
    "test:b14": "node --test tests/b14/*.test.mjs",
    "security:b14": "node scripts/security/verify-b14-boundaries.mjs",
    "release:b6:check": "node scripts/release/validate-b6-platform-matrix.mjs",
    "infra:check": "node scripts/check-local-infra.mjs --static-only",
    "db:validate": "node scripts/database/validate-migrations.mjs && node scripts/database/validate-fixtures.mjs",
    "redis:validate": "node scripts/database/validate-redis-keyspace.mjs",
    "config:check": "node scripts/check-runtime-config.mjs",
    "dod:check": "node scripts/check-dod.mjs --json",
    "tasks:v2:check": "node scripts/audit/verify-v2-b7plus-task-baseline.mjs",
    "core-api:build": "mvn -f services/core-api/pom.xml -DskipTests package",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
