# Add these clyunedev full-stack values to the server-only clyunedev.env file.
# Generate every password/secret on the server. Do not commit this completed file.

LEARNER_DB_PASSWORD=replace-with-strong-random-value
CONTENT_DB_PASSWORD=replace-with-strong-random-value
LEARNING_DB_PASSWORD=replace-with-strong-random-value
ASSESSMENT_DB_PASSWORD=replace-with-strong-random-value
MEDIA_DB_PASSWORD=replace-with-strong-random-value
NOTIFICATION_DB_PASSWORD=replace-with-strong-random-value
GAMIFICATION_DB_PASSWORD=replace-with-strong-random-value
SOCIAL_DB_PASSWORD=replace-with-strong-random-value
COMMERCE_DB_PASSWORD=replace-with-strong-random-value
ADMIN_OPS_DB_PASSWORD=replace-with-strong-random-value
ANALYTICS_DB_PASSWORD=replace-with-strong-random-value
AUDIT_DB_PASSWORD=replace-with-strong-random-value
WORKFLOW_DB_PASSWORD=replace-with-strong-random-value

# This plaintext remains only in the server env file. The IAM value is its
# SHA-256 hex digest, not the plaintext.
GATEWAY_AUDIT_SERVICE_CLIENT_SECRET=replace-with-strong-random-value
IAM_SERVICE_CLIENT_GATEWAY_SECRET_DIGEST=replace-with-sha256-hex-digest

# mobile.clyunedev.com remains loopback-only until its DNS and TLS are ready.
CORS_ALLOWED_ORIGIN_MOBILE_H5=https://mobile.clyunedev.com
