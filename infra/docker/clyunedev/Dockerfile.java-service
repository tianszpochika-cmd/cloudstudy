# syntax=docker/dockerfile:1
# Build exactly one Java 25 service from the monorepo. SERVICE_PATH must be a
# service directory relative to the repository root, for example
# services/api-gateway. Runtime configuration is injected only by Compose.
ARG MAVEN_IMAGE=maven:3.9-eclipse-temurin-25
FROM ${MAVEN_IMAGE} AS build

ARG SERVICE_PATH
WORKDIR /workspace

COPY pom.xml ./pom.xml
COPY ${SERVICE_PATH}/pom.xml ${SERVICE_PATH}/pom.xml
RUN mvn -f ${SERVICE_PATH}/pom.xml -DskipTests dependency:go-offline

COPY ${SERVICE_PATH} ${SERVICE_PATH}
RUN mvn -f ${SERVICE_PATH}/pom.xml -DskipTests package \
  && find ${SERVICE_PATH}/target -maxdepth 1 -type f -name '*.jar' ! -name '*.original' -print -quit \
     | xargs -r -I{} cp '{}' /workspace/application.jar \
  && test -s /workspace/application.jar

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/application.jar /app/application.jar
USER 10001:10001
EXPOSE 18070
ENTRYPOINT ["java", "-jar", "/app/application.jar"]
