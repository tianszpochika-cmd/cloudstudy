# syntax=docker/dockerfile:1
# Build the uni-app project once for its H5 target. Native iOS/Android/iPad
# artifacts are deliberately not built in the server image.
ARG NODE_IMAGE=node:20.19.5-bookworm-slim
FROM ${NODE_IMAGE} AS build

ARG VITE_GATEWAY_BASE_URL
# Browser password posts go to IAM over HTTPS; without this the bundle falls back to https://127.0.0.1:18087.
ARG VITE_IAM_AUTH_BASE_URL
# Comma list of domain families served by this build; API host follows the page family at runtime.
ARG VITE_API_DOMAIN_FAMILIES
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.19.0 --activate
COPY . .
RUN --mount=type=cache,id=cloudstudy-pnpm-store,target=/pnpm/store,sharing=locked \
  pnpm install --frozen-lockfile --filter "@englishflow/mobile..." --store-dir /pnpm/store \
    --fetch-timeout=30000 --fetch-retries=2 --reporter=ndjson
RUN VITE_GATEWAY_BASE_URL="${VITE_GATEWAY_BASE_URL}" VITE_IAM_AUTH_BASE_URL="${VITE_IAM_AUTH_BASE_URL}" VITE_API_DOMAIN_FAMILIES="${VITE_API_DOMAIN_FAMILIES}" pnpm --filter @englishflow/mobile build:h5

FROM nginx:1.27-alpine
COPY infra/docker/clyunedev/nginx-static.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/mobile/dist/build/h5 /usr/share/nginx/html
EXPOSE 8080
