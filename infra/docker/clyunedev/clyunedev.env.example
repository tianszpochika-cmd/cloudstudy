# Copy outside Git to /srv/cloudstudy/env/clyunedev.env. All values below are
# placeholders: create new random values on the server and never commit them.
RELEASE_TAG=replace-with-git-short-sha

MYSQL_ROOT_PASSWORD=replace-with-strong-random-value
IAM_DB_PASSWORD=replace-with-strong-random-value
REDIS_PASSWORD=replace-with-strong-random-value
MINIO_ROOT_USER=replace-with-non-default-admin-name
MINIO_ROOT_PASSWORD=replace-with-strong-random-value
OBJECT_STORAGE_BUCKET=clyunedev
KAFKA_CLUSTER_ID=replace-with-one-persistent-22-character-kraft-id

# Absolute host path to an RSA private key generated on the server only.
IAM_JWT_PRIVATE_KEY_HOST_PATH=/srv/cloudstudy/secrets/iam-rsa-private.pem
IAM_IDEMPOTENCY_REPLAY_SECRET=replace-with-32-plus-character-random-value
IAM_IDEMPOTENCY_FINGERPRINT_SECRET=replace-with-different-32-plus-character-random-value

# Browser-facing origins. clyune.com must never appear in this environment.
CORS_ALLOWED_ORIGIN_LEARNER_WEB=https://learn.clyunedev.com
CORS_ALLOWED_ORIGIN_ADMIN_WEB=https://admin.clyunedev.com
CORS_ALLOWED_ORIGIN_OFFICIAL_SITE=https://clyunedev.com
