# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:20.19.5-bookworm-slim
FROM ${NODE_IMAGE} AS build

ARG NUXT_PUBLIC_SITE_URL
ARG NUXT_PUBLIC_LEARNER_WEB_URL
ARG NUXT_PUBLIC_GATEWAY_BASE_URL
ARG NUXT_PUBLIC_LINK_ORIGINS
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.19.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile \
  && NUXT_PUBLIC_SITE_URL="${NUXT_PUBLIC_SITE_URL}" \
     NUXT_PUBLIC_LEARNER_WEB_URL="${NUXT_PUBLIC_LEARNER_WEB_URL}" \
     NUXT_PUBLIC_GATEWAY_BASE_URL="${NUXT_PUBLIC_GATEWAY_BASE_URL}" \
     NUXT_PUBLIC_LINK_ORIGINS="${NUXT_PUBLIC_LINK_ORIGINS}" \
     pnpm --filter @englishflow/official-site build

FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /workspace/apps/official-site/.output /app
USER node
EXPOSE 18182
CMD ["node", "/app/server/index.mjs"]
