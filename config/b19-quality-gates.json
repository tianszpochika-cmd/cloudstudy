      { "code": "P1", "releaseBlocker": true, "openAllowed": 0, "requiredFields": ["steps", "expected", "actual", "environment", "evidenceIds", "owner", "reproducible"] },
      { "code": "P2", "releaseBlocker": false, "openAllowed": null, "requiredFields": ["steps", "expected", "actual", "environment", "evidenceIds", "owner", "reproducible", "disposition"] }
    ],
    "openStatuses": ["open", "reopened"],
    "closedStatuses": ["fixed", "verified", "accepted", "deferred"],
    "p2Dispositions": ["fix-before-release", "risk-accepted", "deferred-with-plan"],
    "reproducibility": { "required": true, "minimumEvidenceIds": 1, "requiredFor": ["P0", "P1", "P2"] },
    "releaseDecision": { "p0OpenMustEqual": 0, "p1OpenMustEqual": 0, "p2RequiresDisposition": true }
  },
  "regressionSelection": {
    "schemaVersion": 1,
    "minimumSuites": ["phase1-smoke", "quality-static"],
    "noChangedAreaFallback": "phase1-smoke",
    "runtimeEvidenceRequired": true,
    "suites": [
      { "id": "phase1-smoke", "kind": "smoke", "status": "defined", "command": "approved Phase 1 journey runner", "covers": ["login", "adult-gate", "learning", "practice", "review", "report"] },
      { "id": "quality-static", "kind": "static", "status": "defined", "command": "node --test tests/b19/b19-quality-evidence.test.mjs && node scripts/runtime/validate-b19-quality-gates.mjs", "covers": ["quality-config", "source-contract", "report-schema"] },
      { "id": "b18-four-app-static", "kind": "targeted", "status": "defined", "command": "node --test tests/b18/*.test.mjs", "covers": ["four-app-boundary", "locale-theme", "recovery"] },
      { "id": "i18n-theme-performance-contract", "kind": "targeted", "status": "defined", "command": "node --test tests/b7/i18n-theme.test.mjs tests/performance/adaptive-performance.test.mjs", "covers": ["fallback", "theme", "performance-levels"] },
      { "id": "full-phase1-regression", "kind": "full", "status": "defined", "command": "approved B0-B19 Phase 1 regression runner", "covers": ["all-phase1"] }
    ],
    "rules": [
      { "id": "regression-auth-gateway", "whenAnyChangedArea": ["auth", "gateway", "contracts"], "includeSuites": ["phase1-smoke", "b18-four-app-static", "full-phase1-regression"] },
      { "id": "regression-learning-offline", "whenAnyChangedArea": ["learning", "assessment", "media", "offline", "performance"], "includeSuites": ["phase1-smoke", "i18n-theme-performance-contract", "full-phase1-regression"] },
      { "id": "regression-frontend-quality", "whenAnyChangedArea": ["learner-web", "mobile", "admin-web", "official-site", "i18n", "theme", "accessibility"], "includeSuites": ["phase1-smoke", "b18-four-app-static", "i18n-theme-performance-contract", "full-phase1-regression"] },
      { "id": "regression-default", "whenAnyChangedArea": ["any"], "includeSuites": ["phase1-smoke", "quality-static"] }
    ]
  },
  "evidenceIndex": [
    { "id": "EV-B19-STATIC-NETWORK", "gateId": "B19-QA-005-NETWORK", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-STATIC-IDEMPOTENCY", "gateId": "B19-QA-005-NETWORK", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-NETWORK", "gateId": "B19-QA-005-NETWORK", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "network-proxy", "artifactPathPattern": "evidence/b19/network/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-RUNTIME-OFFLINE-RECOVERY", "gateId": "B19-QA-005-NETWORK", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "approved-api-and-trace", "artifactPathPattern": "evidence/b19/offline-recovery/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-STATIC-PERFORMANCE", "gateId": "B19-QA-005-PERFORMANCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-LCP-INP", "gateId": "B19-QA-005-PERFORMANCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "lighthouse-and-playwright", "artifactPathPattern": "evidence/b19/performance/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-STATIC-LEVELS", "gateId": "B19-QA-005-PERFORMANCE-LEVELS", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-LEVELS", "gateId": "B19-QA-005-PERFORMANCE-LEVELS", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "device-performance-runner", "artifactPathPattern": "evidence/b19/performance-levels/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-STATIC-A11Y-TOKENS", "gateId": "B19-QA-005-ACCESSIBILITY", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-STATIC-A11Y-STATES", "gateId": "B19-QA-005-ACCESSIBILITY", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-KEYBOARD", "gateId": "B19-QA-005-ACCESSIBILITY", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "playwright-keyboard", "artifactPathPattern": "evidence/b19/accessibility/keyboard/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-RUNTIME-SCREENREADER-CONTRAST", "gateId": "B19-QA-005-ACCESSIBILITY", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "screen-reader-and-contrast-runner", "artifactPathPattern": "evidence/b19/accessibility/screenreader-contrast/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-STATIC-I18N", "gateId": "B19-QA-005-I18N-THEME", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-STATIC-THEME", "gateId": "B19-QA-005-I18N-THEME", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-I18N-THEME", "gateId": "B19-QA-005-I18N-THEME", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "browser-and-device-locale-theme-runner", "artifactPathPattern": "evidence/b19/i18n-theme/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-STATIC-STATE-FALLBACK", "gateId": "B19-QA-005-STATE-FALLBACK", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-STATE-FALLBACK", "gateId": "B19-QA-005-STATE-FALLBACK", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "playwright-axe-state-runner", "artifactPathPattern": "evidence/b19/state-fallback/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-STATIC-DEFECT-POLICY", "gateId": "B19-TEST-006-DEFECTS", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-STATIC-REGRESSION", "gateId": "B19-TEST-006-REGRESSION", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-REGRESSION", "gateId": "B19-TEST-006-REGRESSION", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "ci-regression-runner", "artifactPathPattern": "evidence/b19/regression/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-STATIC-EVIDENCE-INDEX", "gateId": "B19-TEST-006-EVIDENCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-EVIDENCE-CAPTURE", "gateId": "B19-TEST-006-EVIDENCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "evidence-index-runner", "artifactPathPattern": "evidence/b19/index/**", "collectionPolicy": "runtime-runner-only" },
    { "id": "EV-B19-STATIC-REPORT-SCHEMA", "gateId": "B19-TEST-006-REPORT", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "stdout://b19-quality-static", "collectionPolicy": "validator-output" },
    { "id": "EV-B19-RUNTIME-REPORT", "gateId": "B19-TEST-006-REPORT", "class": "runtime", "status": "pending", "runtimeRequired": true, "tool": "report-generator-and-json-schema-validator", "artifactPathPattern": "evidence/b19/report/**", "collectionPolicy": "runtime-runner-only" }
  ],
  "reportSchema": {
    "id": "englishflow.b19.quality-report",
    "version": "1.0.0",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://englishflow.invalid/schemas/b19-quality-report.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "reportId", "batch", "run", "decision", "gates", "defects", "regressions", "evidence"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "reportId": { "type": "string", "minLength": 1 },
        "batch": { "const": "B19" },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startedAt", "environment", "commit", "runner"],
          "properties": {
            "startedAt": { "type": "string", "minLength": 1 },
            "finishedAt": { "type": ["string", "null"] },
            "environment": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "minLength": 1 },
            "runner": { "type": "string", "minLength": 1 }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "p0Open", "p1Open", "p2Unresolved", "runtimePending"],
          "properties": {
            "status": { "enum": ["not-ready", "blocked", "go", "no-go"] },
            "p0Open": { "type": "integer", "minimum": 0 },
            "p1Open": { "type": "integer", "minimum": 0 },
            "p2Unresolved": { "type": "integer", "minimum": 0 },
            "runtimePending": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gateId", "status", "evidenceIds"],
            "properties": {
              "gateId": { "type": "string", "minLength": 1 },
              "status": { "enum": ["not-run", "pending", "pass", "fail", "blocked"] },
              "evidenceIds": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          }
        },
        "defects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "status", "title", "steps", "expected", "actual", "environment", "evidenceIds", "owner", "reproducible"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "severity": { "enum": ["P0", "P1", "P2"] },
              "status": { "enum": ["open", "reopened", "fixed", "verified", "accepted", "deferred"] },
              "title": { "type": "string", "minLength": 1 },
              "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "expected": { "type": "string", "minLength": 1 },
              "actual": { "type": "string", "minLength": 1 },
              "environment": { "type": "string", "minLength": 1 },
              "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "owner": { "type": "string", "minLength": 1 },
              "reproducible": { "type": "boolean" },
              "disposition": { "enum": ["fix-before-release", "risk-accepted", "deferred-with-plan"] }
            }
          }
        },
        "regressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suiteId", "selected", "status", "reason", "evidenceIds"],
            "properties": {
              "suiteId": { "type": "string", "minLength": 1 },
              "selected": { "type": "boolean" },
              "status": { "enum": ["pending", "pass", "fail", "blocked", "not-selected"] },
              "reason": { "type": "string", "minLength": 1 },
              "evidenceIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "gateId", "class", "status", "runtimeRequired", "uri", "sha256", "capturedAt", "environment"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "gateId": { "type": "string", "minLength": 1 },
              "class": { "enum": ["static", "runtime"] },
              "status": { "enum": ["defined", "pending", "captured", "invalid"] },
              "runtimeRequired": { "type": "boolean" },
              "uri": { "type": "string", "minLength": 1 },
              "sha256": { "type": ["string", "null"] },
              "capturedAt": { "type": ["string", "null"] },
              "environment": { "type": ["string", "null"] },
              "tool": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
