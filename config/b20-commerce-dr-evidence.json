        "provider": "sandbox-hmac",
        "liveProvider": false,
        "liveTrafficAllowed": false,
        "credentialSource": "runtime-secret-store-only",
        "clientNeverReceivesProviderCredential": true,
        "unqualifiedChannelDecision": "deny",
        "failedPaymentDecision": "retryable-no-entitlement"
      },
      "callbackVerification": {
        "verificationOrder": [
          "provider-allowlist",
          "canonical-payload-binding",
          "signature-verification",
          "provider-event-dedupe",
          "order-amount-currency-binding",
          "pending-attempt-state",
          "fact-write-and-outbox"
        ],
        "signatureAlgorithm": "HMAC-SHA256",
        "rejectUnverified": true,
        "rejectForgedProvider": true,
        "rawPayloadPersistence": false,
        "sameEventSameDigestDecision": "idempotent-no-second-effect",
        "sameEventDifferentDigestDecision": "reject-and-audit"
      },
      "amountBinding": {
        "bindTo": "server-order-price-snapshot",
        "requiredFields": ["orderId", "amountMinor", "currency", "providerEventId"],
        "clientAmountAuthority": false,
        "currencyAuthority": "server-order-price-snapshot",
        "mismatchDecision": "reject-and-audit",
        "negativeAmountDecision": "reject-and-audit"
      },
      "replayProtection": {
        "providerEventIdentity": ["tenant", "provider", "providerEventId"],
        "callbackReceiptUnique": true,
        "idempotencyFingerprintRequired": true,
        "mismatchedPayloadDecision": "reject-and-audit",
        "samePayloadReplayDecision": "return-existing-result",
        "noSecondEntitlementGrant": true,
        "noSecondRefundEffect": true
      },
      "refunds": {
        "amountCeiling": "paid-minus-refunded",
        "idempotencyRequired": true,
        "providerSignatureRequired": true,
        "refundCallbackAmountBound": true,
        "failedRefundDecision": "retryable-no-entitlement-grant",
        "refundFactAudited": true,
        "refundDoesNotRewriteOrderPriceSnapshot": true
      },
      "reconciliation": {
        "factOwner": "commerce-service",
        "inputs": ["order-fact", "payment-callback-receipt", "refund-fact", "entitlement-fact", "provider-settlement-sandbox"],
        "immutableDomainFacts": true,
        "states": ["MATCHED", "MISMATCHED", "REPAIR_REQUIRED"],
        "repairMode": "command-or-manual-recovery-not-cross-service-write",
        "replayIsIdempotent": true,
        "requiresAuditTrail": true,
        "requiresPostRecoveryRun": true
      }
    }
