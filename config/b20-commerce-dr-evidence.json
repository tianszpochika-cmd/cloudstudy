  "releaseGate": {
    "status": "BLOCKED",
    "defaultDecision": "deny",
    "requiresAllAssignedTasks": true,
    "requiredUpstreamTasks": ["V2-B20-SEC-001", "V2-B20-PRI-002", "V2-B20-CNT-003", "V2-B20-COM-004", "V2-B20-DR-005"],
    "blockingConditions": [
      "any-required-evidence-missing",
      "runtime-evidence-pending-or-blocked",
      "artifact-hash-missing-or-invalid",
      "live-provider-or-unqualified-payment",
      "restore-or-reconciliation-unmeasured",
      "single-reviewer-or-conflicted-reviewer",
      "open-p0-or-p1",
      "rollback-conclusion-missing"
    ],
    "dualReview": {
      "required": true,
      "independentReviewers": true,
      "minimumReviewers": 2,
      "requiredRoles": ["commerce-owner", "reliability-owner"],
      "samePersonCannotSatisfyBoth": true,
      "reviewRecordStatus": "not-present"
    },
    "riskAcceptance": {
      "allowed": true,
      "defaultStatus": "not-present",
      "requiredFields": ["riskId", "scope", "residualRisk", "mitigation", "owner", "expiresAt", "approverA", "approverB", "rollbackPlan"],
      "requiresExpiration": true,
      "cannotAcceptP0": true,
      "cannotOpenLivePayment": true
    },
    "rollback": {
      "required": true,
      "defaultStatus": "not-established",
      "requiresVersionedArtifact": true,
      "requiresRestorePoint": true,
      "requiresOwner": true,
      "requiresDrillEvidence": true,
      "conclusionStatus": "not-established"
    }
  },
  "reportSchema": {
    "id": "b20-release-evidence-report",
    "version": "1.0.0",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "reportId", "batch", "decision", "gates", "evidence", "review", "riskAcceptance", "rollback"],
      "properties": {
        "schemaVersion": {"type": "string", "const": "1.0.0"},
        "reportId": {"type": "string", "minLength": 1},
        "batch": {"type": "string", "const": "B20"},
        "decision": {"enum": ["BLOCKED", "NO-GO", "GO"]},
        "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["gateId", "status", "evidenceIds"], "properties": {"gateId": {"type": "string"}, "status": {"enum": ["defined", "pending", "blocked", "pass", "fail"]}, "evidenceIds": {"type": "array", "items": {"type": "string"}}}}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidenceId", "status", "uri", "sha256", "capturedAt", "environment"], "properties": {"evidenceId": {"type": "string"}, "status": {"enum": ["defined", "pending", "captured", "invalid"]}, "uri": {"type": "string"}, "sha256": {"type": ["string", "null"]}, "capturedAt": {"type": ["string", "null"]}, "environment": {"type": ["string", "null"]}}}},
        "review": {"type": "object", "additionalProperties": false, "required": ["reviewerA", "reviewerB", "independent"], "properties": {"reviewerA": {"type": "string"}, "reviewerB": {"type": "string"}, "independent": {"type": "boolean"}}},
        "riskAcceptance": {"type": "object", "additionalProperties": false, "required": ["status", "expiresAt"], "properties": {"status": {"enum": ["not-present", "accepted", "expired"]}, "expiresAt": {"type": ["string", "null"]}}},
        "rollback": {"type": "object", "additionalProperties": false, "required": ["status", "artifactRef", "owner"], "properties": {"status": {"enum": ["not-established", "ready", "tested"]}, "artifactRef": {"type": ["string", "null"]}, "owner": {"type": ["string", "null"]}}}
      }
    }
  }
