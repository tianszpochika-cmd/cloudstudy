      { "from": "EXECUTING", "to": "CLOSED" },
      { "from": "CLOSED", "to": "EXECUTING" },
      { "from": "REJECTED", "to": "APPROVED" },
      { "from": "EXPIRED", "to": "EXECUTING" },
      { "from": "ESCALATED", "to": "CLOSED" }
