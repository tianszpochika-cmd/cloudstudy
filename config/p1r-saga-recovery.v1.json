      "mayWriteForeignDomainSchema": false,
      "immutable": true
    },
    "domain": {
      "serviceSelector": "SOURCE_DOMAIN_OWNER",
      "factWriteBoundary": "own-schema-only",
      "compensationExecution": "VERSIONED_OWNER_API_OR_EVENT",
      "mustReturnReceipt": true
    },
    "authorization": {
      "service": "iam-service",
      "actorAndTenant": "SERVER_DERIVED",
      "decisionFailure": "FAIL_CLOSED"
    }
  },
  "saga": {
    "recordRequiredFields": [
      "sagaId",
      "sagaType",
      "sagaVersion",
      "rootEventId",
      "sourceEventId",
      "aggregateType",
      "aggregateId",
      "state",
      "currentStepId",
      "requestId",
      "traceId",
      "auditId"
    ],
    "states": [
      "NEW",
      "FORWARD_RUNNING",
      "FORWARD_COMPLETED",
      "COMPENSATION_PENDING",
      "COMPENSATING",
      "COMPENSATED",
      "MANUAL_RECOVERY_REQUIRED"
    ],
