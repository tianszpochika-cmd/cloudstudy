      "recordRequiredFields": [
        "approvalId",
        "recoveryId",
        "recoveryRevision",
        "actionDigest",
        "rootEventId",
        "requesterPrincipalRef",
        "approverPrincipalRef",
        "policyVersion",
        "decision",
        "decidedAt",
        "expiresAt",
        "requestId",
        "traceId",
        "auditId"
