      "task": "P1R-M1-006",
      "runtimeStatus": "NOT_RUNTIME_VERIFIED",
      "catalogRole": "FROZEN_EVENT_GOVERNANCE_DEPENDENCY"
    },
    "b26": {
      "path": "config/b26-event-runtime.json",
      "mode": "static-only",
      "runtimeStatus": "pending",
      "defaultDecision": "NO-GO",
      "classification": "HISTORICAL_STATIC_CANDIDATE",
      "mayNotBePromotedByThisPolicy": true
    },
    "catalogInteraction": {
      "frozenM1_006Catalog": "READ_ONLY_DEPENDENCY",
      "rootEventProjection": "RELIABILITY_RECORD_AND_RECEIPT_ONLY_UNTIL_DOMAIN_EVENT_SCHEMAS_ARE_CLOSED",
      "mayNotMutateB26PayloadOrCanonicalEnvelope": true
    }
  },
  "correlation": {
    "requiredFields": [
      "eventId",
      "rootEventId",
      "aggregateType",
      "aggregateId",
      "schemaVersion",
      "requestId",
      "traceId",
      "dedupeKey"
