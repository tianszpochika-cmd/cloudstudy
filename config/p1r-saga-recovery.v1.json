  "errorRouting": {
    "retryBudget": {
      "bounded": true,
      "maxAttempts": 5,
      "backoff": "EXPONENTIAL_WITH_JITTER",
      "baseDelayMs": 1000,
      "maxDelayMs": 60000,
      "source": "B26_STATIC_CANDIDATE_ONLY"
