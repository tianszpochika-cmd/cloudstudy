  "runtimeBoundary": {
    "thisPolicy": "STATIC_D2_CONTRACT_ONLY",
    "prohibitedClaims": [
      "broker-topic-or-acl-created",
      "outbox-transaction-or-publisher-executed",
      "consumer-deduplication-or-offset-commit-executed",
      "dlq-or-replay-executed",
