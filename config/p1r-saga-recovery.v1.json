    "terminalStates": ["APPLIED", "MANUAL_RECOVERY_REQUIRED"],
    "transitions": [
      { "from": "PENDING", "to": "DISPATCHED" },
      { "from": "PENDING", "to": "MANUAL_RECOVERY_REQUIRED" },
      { "from": "DISPATCHED", "to": "APPLIED" },
      { "from": "DISPATCHED", "to": "MANUAL_RECOVERY_REQUIRED" }
    ],
    "execution": {
      "idempotent": true,
      "versioned": true,
      "idempotencyScope": [
        "sagaId",
        "stepId",
        "compensationKey",
        "ownerService"
      ],
      "foreignSchemaWrite": "PROHIBITED",
      "sourceFactRollback": "PROHIBITED",
      "transport": "VERSIONED_OWNER_API_OR_EVENT",
      "kafkaRpc": false,
      "twoPhaseCommit": false,
      "ownerReceiptRequiredBeforeApplied": true
    }
