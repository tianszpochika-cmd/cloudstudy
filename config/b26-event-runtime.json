  "outbox": {
    "storage": "service-owned-mysql",
    "tablePattern": "<service>_outbox_event",
    "sameTransactionAsAggregate": true,
    "publishAfterCommit": true,
    "eventImmutableAfterCommit": true,
    "delivery": "at-least-once",
    "exactlyOnceClaim": false,
    "publisher": {
      "claimStrategy": "row-lock-skip-locked",
      "leaseMs": 30000,
      "batchSize": 100,
      "maxInFlight": 100,
      "publishConfirmation": "broker-ack-before-mark-published",
      "offsetOrState": "service-owned-outbox-state"
    },
    "stateModel": ["PENDING", "PUBLISHING", "PUBLISHED", "RETRY", "DLQ"],
    "requiredFields": [
      "eventId",
      "eventName",
      "requestId",
      "traceId",
      "schemaVersion",
      "aggregateId",
      "dedupeKey",
      "payload"
    ],
    "forbiddenCoordination": ["kafka-rpc", "distributed-two-phase-commit", "shared-table-write"]
  },
  "consumerReliability": {
    "atLeastOnce": true,
    "deduplication": {
      "required": true,
      "uniqueKey": ["consumerGroup", "eventId"],
      "secondaryKey": "dedupeKey",
      "storage": "consumer-service-owned-idempotency-record",
      "effectAndDeduplicationMustBeAtomic": true,
      "offsetCommitAfterEffect": true,
      "duplicateEffectForbidden": true
    },
    "retry": {
      "bounded": true,
      "maxAttempts": 5,
      "backoff": "exponential-with-jitter",
      "baseDelayMs": 1000,
      "maxDelayMs": 60000,
      "retryableFailureCodes": ["TIMEOUT", "TEMPORARY_UNAVAILABLE", "CONFLICT_RETRYABLE"],
      "nonRetryableFailureCodes": ["SCHEMA_INVALID", "FORBIDDEN", "OWNER_MISMATCH", "STALE_VERSION"],
      "exhaustedAction": "route-to-dlq"
    },
    "dlq": {
      "topic": "platform.events.dlq.v1",
      "requiredOriginalFields": ["eventId", "requestId", "traceId", "schemaVersion", "aggregateId", "dedupeKey"],
      "requiredFailureFields": ["consumerGroup", "failureCode", "attempt", "failedAt", "recoveryState"],
      "preserveRawAuthorizationHeaders": false,
      "operatorOnly": true,
      "domainFactsDirectWriteAllowed": false
    },
    "replay": {
      "source": "immutable-outbox-or-dlq-record",
      "sameConsumerPath": true,
      "replayRunIdRequired": true,
      "dedupeStillEnabled": true,
      "auditRequired": true,
      "operatorApprovalRequired": true,
      "clientTriggered": false,
      "directDomainWrite": false,
      "maxBatchSize": 1000,
      "runtimeStatus": "pending"
    },
    "ordering": {
      "partitionKey": "aggregateId",
      "sameAggregateOrdered": true,
      "crossAggregateOrder": "not-guaranteed",
      "sequenceField": "payload.aggregateVersion",
      "outOfOrderPolicy": "bounded-hold-then-dlq",
      "maxBufferSize": 100,
      "maxWaitMs": 30000,
      "staleEventPolicy": "dedupe-audit-and-skip",
      "manualRecoveryOwner": "workflow-service",
      "runtimeStatus": "pending"
    }
  },
  "saga": {
    "coordinator": "workflow-service",
    "integrationFactsOnly": true,
    "commandsViaVersionedApi": true,
    "kafkaRpc": false,
    "twoPhaseCommit": false,
    "compensation": {
      "required": true,
      "idempotent": true,
      "versioned": true,
      "neverDirectlyWritesForeignSchema": true,
      "failureState": "COMPENSATION_PENDING"
    },
    "manualRecovery": {
      "requiredFor": ["compensation-exhausted", "irreconcilable-ordering-gap", "schema-incompatible-event"],
      "owner": "workflow-service",
      "approvalRequired": true,
      "twoPersonReview": true,
      "clientTriggered": false,
      "auditReferenceRequired": true
    }
  },
  "eventEnvelope": {
    "required": [
      "eventId",
      "eventName",
      "schema",
      "version",
      "occurredAt",
      "aggregateType",
      "aggregateId",
      "actorId",
      "traceId",
      "requestId",
      "schemaVersion",
      "dedupeKey",
      "payload"
    ],
    "serverOwned": ["eventId", "occurredAt", "actorId", "traceId", "requestId", "schemaVersion", "dedupeKey"],
    "partitionKey": "aggregateId",
    "payloadMustBeObject": true,
    "immutableAfterCommit": true
  },
  "eventRouting": [
    { "eventName": "learner.target.updated.v1", "topic": "platform.learner.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.learning-from-learner.v1", "cg.workflow-from-learner.v1"] },
    { "eventName": "assessment.placement.completed.v1", "topic": "platform.assessment.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.learning-from-assessment.v1", "cg.workflow-from-assessment.v1"] },
    { "eventName": "assessment.item.assessed.v2", "topic": "platform.assessment.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.learning-from-assessment.v1", "cg.workflow-from-assessment.v1"] },
    { "eventName": "learning.mastery.projected.v2", "topic": "platform.learning.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.assessment-from-learning.v1", "cg.workflow-from-learning.v1"] },
    { "eventName": "learning.review.scheduled.v2", "topic": "platform.learning.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.assessment-from-learning.v1", "cg.workflow-from-learning.v1"] },
    { "eventName": "workflow.outbox.published.v1", "topic": "platform.workflow.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.workflow-reliability.v1", "cg.audit-from-workflow.v1"] },
    { "eventName": "workflow.event.delivery_failed.v1", "topic": "platform.workflow.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.workflow-reliability.v1", "cg.audit-from-workflow.v1"] },
    { "eventName": "workflow.event.dead_lettered.v1", "topic": "platform.workflow.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.workflow-manual-recovery.v1", "cg.audit-from-workflow.v1"] },
    { "eventName": "workflow.event.replay_requested.v1", "topic": "platform.workflow.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.workflow-reliability.v1", "cg.workflow-manual-recovery.v1"] },
    { "eventName": "workflow.event.ordering_deferred.v1", "topic": "platform.workflow.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.workflow-reliability.v1", "cg.workflow-manual-recovery.v1"] },
    { "eventName": "workflow.saga.compensation_requested.v1", "topic": "platform.workflow.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.workflow-reliability.v1", "cg.audit-from-workflow.v1"] },
    { "eventName": "workflow.saga.manual_recovery_requested.v1", "topic": "platform.workflow.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.workflow-manual-recovery.v1", "cg.audit-from-workflow.v1"] },
    { "eventName": "content.version.submitted.v1", "topic": "platform.content.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.admin-ops-from-content.v1", "cg.audit-from-content.v1"] },
    { "eventName": "content.version.reviewed.v1", "topic": "platform.content.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.admin-ops-from-content.v1", "cg.audit-from-content.v1"] },
    { "eventName": "content.version.published.v1", "topic": "platform.content.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.learner-from-content.v1", "cg.learning-from-content.v1", "cg.assessment-from-content.v1", "cg.admin-ops-from-content.v1", "cg.audit-from-content.v1"] },
    { "eventName": "content.version.unpublished.v1", "topic": "platform.content.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.learner-from-content.v1", "cg.learning-from-content.v1", "cg.assessment-from-content.v1", "cg.admin-ops-from-content.v1", "cg.audit-from-content.v1"] },
    { "eventName": "content.version.rolled_back.v1", "topic": "platform.content.v1", "partitionKey": "aggregateId", "consumerGroups": ["cg.learner-from-content.v1", "cg.learning-from-content.v1", "cg.assessment-from-content.v1", "cg.admin-ops-from-content.v1", "cg.audit-from-content.v1"] }
  ],
  "telemetryBridge": {
    "eventContractIsSeparateFromTelemetryEnvelope": true,
    "schemaPath": "packages/telemetry/schemas/telemetry-event.schema.json",
    "policyPath": "packages/telemetry/policies/telemetry-events.json",
    "requiredCorrelationFields": ["eventId", "requestId", "traceId"],
    "schemaVersionMapping": "eventName-and-eventVersion",
    "sensitiveDataPolicy": "redact-or-do-not-record",
    "rawEventPayloadInLogs": false,
    "runtimeStatus": "pending"
  }
}
