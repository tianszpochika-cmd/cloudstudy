    { "id": "B21-E-GATE-STATIC-B20", "gateId": "B21-GATE-005-GOVERNANCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "config/b21-release-gate-evidence.json#/b20Prerequisite", "collectionPolicy": "repository-static-validator" },
    { "id": "B21-E-GATE-STATIC-ROLES", "gateId": "B21-GATE-005-GOVERNANCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "config/b21-release-gate-evidence.json#/roleGovernance", "collectionPolicy": "repository-static-validator" },
    { "id": "B21-E-GATE-STATIC-RISK", "gateId": "B21-GATE-005-GOVERNANCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "config/b21-release-gate-evidence.json#/releaseGate/riskAcceptance", "collectionPolicy": "repository-static-validator" },
    { "id": "B21-E-GATE-STATIC-ROLLBACK", "gateId": "B21-GATE-005-GOVERNANCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "config/b21-release-gate-evidence.json#/releaseGate/rollback", "collectionPolicy": "repository-static-validator" },
    { "id": "B21-E-GATE-B20-ACCEPTANCE", "gateId": "B21-GATE-005-GOVERNANCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "artifactPathPattern": "evidence/b21/gate/b20-acceptance/**/*.json", "collectionPolicy": "runtime-runner-only" },
    { "id": "B21-E-GATE-ROLE-DECISIONS", "gateId": "B21-GATE-005-GOVERNANCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "artifactPathPattern": "evidence/b21/gate/role-decisions/**/*.json", "collectionPolicy": "runtime-runner-only" },
    { "id": "B21-E-GATE-CHANGE-WINDOW", "gateId": "B21-GATE-005-GOVERNANCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "artifactPathPattern": "evidence/b21/gate/change-window/**/*.json", "collectionPolicy": "runtime-runner-only" },
    { "id": "B21-E-GATE-RISK-REVIEW", "gateId": "B21-GATE-005-GOVERNANCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "artifactPathPattern": "evidence/b21/gate/risk-review/**/*.json", "collectionPolicy": "runtime-runner-only" },
    { "id": "B21-E-GATE-ROLLBACK-DRILL", "gateId": "B21-GATE-005-GOVERNANCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "artifactPathPattern": "evidence/b21/gate/rollback-drill/**/*.json", "collectionPolicy": "runtime-runner-only" },
    { "id": "B21-E-TEST-STATIC-SCHEMA", "gateId": "B21-TEST-006-RC-EVIDENCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "config/b21-release-gate-evidence.json#/reportSchema", "collectionPolicy": "repository-static-validator" },
    { "id": "B21-E-TEST-STATIC-BINDING", "gateId": "B21-TEST-006-RC-EVIDENCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "config/b21-release-gate-evidence.json#/releaseGate/artifactBinding", "collectionPolicy": "repository-static-validator" },
    { "id": "B21-E-TEST-STATIC-REPRO", "gateId": "B21-TEST-006-RC-EVIDENCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "config/b21-release-gate-evidence.json#/releaseGate/reportReproducibility", "collectionPolicy": "repository-static-validator" },
    { "id": "B21-E-TEST-STATIC-INDEX", "gateId": "B21-TEST-006-RC-EVIDENCE", "class": "static", "status": "defined", "runtimeRequired": false, "artifactPathPattern": "config/b21-release-gate-evidence.json#/evidenceIndex", "collectionPolicy": "repository-static-validator" },
    { "id": "B21-E-TEST-RC-ARTIFACT", "gateId": "B21-TEST-006-RC-EVIDENCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "artifactPathPattern": "evidence/b21/rc/artifact/**/*.json", "collectionPolicy": "runtime-runner-only" },
    { "id": "B21-E-TEST-EVIDENCE-REPORT", "gateId": "B21-TEST-006-RC-EVIDENCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "artifactPathPattern": "evidence/b21/rc/report/**/*.json", "collectionPolicy": "runtime-runner-only" },
    { "id": "B21-E-TEST-SIGNOFF-INDEX", "gateId": "B21-TEST-006-RC-EVIDENCE", "class": "runtime", "status": "pending", "runtimeRequired": true, "artifactPathPattern": "evidence/b21/rc/signoff/**/*.json", "collectionPolicy": "runtime-runner-only" }
  ],
  "reportSchema": {
    "id": "B21-RELEASE-GATE-REPORT",
    "version": "1.0.0",
    "closed": true,
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Phase 1 B21 release gate report",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reportId",
        "batch",
        "phase",
        "releaseCandidate",
        "decision",
        "decisionPolicy",
        "roles",
        "upstreamGates",
        "evidence",
        "knownRisks",
        "riskAcceptance",
        "changeWindow",
        "rollback",
        "artifactBindings",
        "reproducibility",
        "reportHash"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0.0" },
        "reportId": { "type": "string", "pattern": "^B21-REPORT-[A-Z0-9-]+$" },
        "batch": { "type": "string", "const": "B21" },
        "phase": { "type": "string", "const": "phase-1" },
        "releaseCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sourceRevision", "environment", "artifactDigest", "artifactSignature"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "sourceRevision": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 },
            "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "artifactSignature": { "type": "string", "minLength": 1 }
          }
        },
        "decision": { "type": "string", "enum": ["NO-GO", "GO"] },
        "decisionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultDecision", "missingEvidenceDecision", "goRequiresAllEvidence", "goRequiresAllRoles"],
          "properties": {
            "defaultDecision": { "type": "string", "const": "NO-GO" },
            "missingEvidenceDecision": { "type": "string", "const": "NO-GO" },
            "goRequiresAllEvidence": { "type": "boolean", "const": true },
            "goRequiresAllRoles": { "type": "boolean", "const": true }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "decision", "reviewerRef", "signatureRef", "decidedAt"],
            "properties": {
              "role": { "type": "string", "enum": ["product", "architecture", "security", "data", "operations"] },
              "decision": { "type": "string", "enum": ["PENDING", "GO", "NO-GO", "BLOCKED"] },
              "reviewerRef": { "type": "string", "minLength": 1 },
              "signatureRef": { "type": ["string", "null"] },
              "decidedAt": { "type": ["string", "null"] }
            }
          }
        },
        "upstreamGates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskId", "status", "evidenceIds"],
            "properties": {
              "taskId": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["pending", "blocked", "pass", "fail"] },
              "evidenceIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceId", "status", "uri", "sha256", "capturedAt", "environment"],
            "properties": {
              "evidenceId": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["pending", "captured", "invalid", "blocked"] },
              "uri": { "type": "string", "minLength": 1 },
              "sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
              "capturedAt": { "type": ["string", "null"] },
              "environment": { "type": ["string", "null"] }
            }
          }
        },
        "knownRisks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["riskId", "status", "owner", "mitigation", "expiresAt"],
            "properties": {
              "riskId": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["open", "mitigated", "accepted", "closed", "expired"] },
              "owner": { "type": "string", "minLength": 1 },
              "mitigation": { "type": "string", "minLength": 1 },
              "expiresAt": { "type": ["string", "null"] }
            }
          }
        },
        "riskAcceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "riskIds", "expiresAt", "approverRefs"],
          "properties": {
            "status": { "type": "string", "enum": ["not-present", "accepted", "expired", "blocked"] },
            "riskIds": { "type": "array", "items": { "type": "string" } },
            "expiresAt": { "type": ["string", "null"] },
            "approverRefs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "changeWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windowId", "status", "ticketRef", "startsAt", "endsAt", "timezone"],
          "properties": {
            "windowId": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "enum": ["not-established", "scheduled", "active", "expired", "blocked"] },
            "ticketRef": { "type": "string", "minLength": 1 },
            "startsAt": { "type": ["string", "null"] },
            "endsAt": { "type": ["string", "null"] },
            "timezone": { "type": "string", "minLength": 1 }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "ownerRef", "artifactDigest", "restorePointRef", "drillEvidenceRef"],
          "properties": {
            "status": { "type": "string", "enum": ["not-established", "pending", "tested", "blocked"] },
            "ownerRef": { "type": ["string", "null"] },
            "artifactDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
            "restorePointRef": { "type": ["string", "null"] },
            "drillEvidenceRef": { "type": ["string", "null"] }
          }
        },
        "artifactBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactId", "sha256", "sourceRevision", "environment", "signatureRef"],
            "properties": {
              "artifactId": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "sourceRevision": { "type": "string", "minLength": 1 },
              "environment": { "type": "string", "minLength": 1 },
              "signatureRef": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generator", "generatorVersion", "manifestDigest", "sourceRevision", "toolVersions", "inputRefs", "reportHash"],
          "properties": {
            "generator": { "type": "string", "minLength": 1 },
            "generatorVersion": { "type": "string", "minLength": 1 },
            "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "sourceRevision": { "type": "string", "minLength": 1 },
            "toolVersions": { "type": "object", "additionalProperties": { "type": "string" } },
            "inputRefs": { "type": "array", "items": { "type": "string" } },
            "reportHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "reportHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
