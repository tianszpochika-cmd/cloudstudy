  "adversarialCases": [
    "public export request supplies subjectId or tenantId",
    "public deletion request supplies ownerService or status",
    "client attempts to set executeAt, legalHoldDecision or sessionRevocationState",
    "unknown legal hold is treated as cleared",
    "cancel occurs after execution starts",
    "execute occurs before 168-hour cooling-off completes",
    "download grant is reusable, cacheable or issued after export expiry",
    "partial owner receipt is reported as anonymized",
    "recovery repeats a completed owner receipt",
    "D2 source is presented as live privacy, IAM, workflow or Kafka evidence"
  ]
