  "export": {
    "owner": "learner-service.privacy",
    "canonicalOperations": [
      "createM1017PrivacyExport",
      "getM1017PrivacyExportStatus",
      "createM1017PrivacyExportDownloadGrant",
      "getM1017PrivacyExportReceipt",
      "recordM1017PrivacyExportOwnerReceipt",
      "recoverM1017PrivacyExport"
    ],
    "states": [
      "REQUESTED",
      "COLLECTING",
      "ASSEMBLING",
      "READY",
      "DOWNLOAD_ISSUED",
      "EXPIRED",
      "FAILED",
      "RECOVERY_REQUIRED"
    ],
    "transitions": {
      "REQUESTED": ["COLLECTING", "FAILED", "RECOVERY_REQUIRED"],
      "COLLECTING": ["ASSEMBLING", "FAILED", "RECOVERY_REQUIRED"],
      "ASSEMBLING": ["READY", "FAILED", "RECOVERY_REQUIRED"],
      "READY": ["DOWNLOAD_ISSUED", "EXPIRED"],
      "DOWNLOAD_ISSUED": ["EXPIRED"],
      "FAILED": ["RECOVERY_REQUIRED"],
      "RECOVERY_REQUIRED": ["COLLECTING", "EXPIRED"],
      "EXPIRED": []
    },
    "download": {
      "oneTime": true,
      "cacheControl": "no-store",
      "expiryServerDerived": true,
      "rawExportInEventOrOrdinaryAudit": "PROHIBITED"
    },
    "receipt": {
      "ownerReceiptRequired": true,
      "ownerServiceDerivedFromTrustedWorkload": true,
      "minimumOutcome": ["COLLECTED", "NO_DATA", "RETAINED_LEGAL_HOLD", "FAILED"],
      "aggregateDigestRequired": true
    },
    "recovery": {
      "owner": "workflow-service",
      "failureState": "RECOVERY_REQUIRED",
      "completedReceiptMayNotBeRepeated": true,
      "manualRecoveryRequiresAudit": true
    }
  },
  "deletion": {
    "owner": "iam-service",
    "canonicalOperations": [
      "createM1017AccountDeletionRequest",
      "getM1017AccountDeletionStatus",
      "cancelM1017AccountDeletionRequest",
      "executeM1017AccountDeletion",
      "recordM1017AccountDeletionOwnerReceipt",
      "recoverM1017AccountDeletion"
    ],
    "states": [
      "PENDING_COOLING_OFF",
      "CANCELLED",
      "EXECUTING",
      "RECOVERY_REQUIRED",
      "ANONYMIZED"
    ],
    "transitions": {
      "PENDING_COOLING_OFF": ["CANCELLED", "EXECUTING"],
      "CANCELLED": [],
      "EXECUTING": ["RECOVERY_REQUIRED", "ANONYMIZED"],
      "RECOVERY_REQUIRED": ["EXECUTING"],
      "ANONYMIZED": []
    },
    "coolingOffHours": 168,
    "cancelAllowedOnlyIn": ["PENDING_COOLING_OFF"],
    "sessionRevocation": {
      "requiredBeforeFinalState": true,
      "scope": "ALL_SESSIONS_REFRESH_FAMILIES_DEVICES_AND_ACCESS_JTIS",
      "state": "REVOKED"
    },
    "legalHold": {
      "mustCheckBeforeOwnerDeleteOrAnonymize": true,
      "unknownDecision": "DENY",
      "activeDecision": "RETAIN_ANONYMIZED_MINIMUM",
      "ttlIsNotRetention": true
    },
    "receipt": {
      "ownerReceiptRequired": true,
      "allowedOutcomes": ["DELETED", "ANONYMIZED", "NO_DATA", "RETAINED_LEGAL_HOLD", "FAILED"],
      "allExpectedOwnersMustReconcileBeforeAnonymized": true
    },
    "recovery": {
      "failureState": "RECOVERY_REQUIRED",
      "partialSuccessDoesNotClaimAnonymized": true,
      "retryOnlyFailedOwnerOrReconcile": true,
      "manualRecoveryRequiresAudit": true
    }
  },
  "eventIntegration": {
    "coordinatorOwned": true,
    "e1MayCreateOrModifyEventFragment": false,
    "e1MayCreateOrModifyCatalogAsyncApiOrB26": false,
    "requiredGapBindings": ["EVENT-GAP-BIND-PRIV-001", "EVENT-GAP-USR-DEL-001"],
    "existingSessionRevocationFact": "auth.session.revoked.v1",
    "payloadMustExclude": ["rawExport", "downloadUrl", "token", "password", "tenantId", "subjectId", "ownerReceiptPayload"]
