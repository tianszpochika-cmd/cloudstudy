  "reportSchema": {
    "id": "b22-phase1-launch-acceptance-report",
    "version": "1.0.0",
    "closed": true,
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reportId",
        "batch",
        "phase",
        "releaseCandidate",
        "observation",
        "decision",
        "decisionPolicy",
        "gates",
        "keyJourneys",
        "evidence",
        "upstreamGates",
        "artifactBinding",
        "permissionPrivacy",
        "backup",
        "incidents",
        "userFeedback",
        "knownRisks",
        "maintenance",
        "p1Disposition",
        "rollback",
        "auditTrail",
        "reproducibility",
        "reportHash"
      ],
      "properties": {
        "schemaVersion": {"type": "string", "const": "1.0.0"},
        "reportId": {"type": "string", "minLength": 1},
        "batch": {"type": "string", "const": "B22"},
        "phase": {"type": "string", "const": "phase-1"},
        "releaseCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseVersion", "sourceRevision", "artifactDigest", "environmentRef"],
          "properties": {
            "releaseVersion": {"type": "string", "minLength": 1},
            "sourceRevision": {"type": "string", "minLength": 1},
            "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "environmentRef": {"type": "string", "minLength": 1}
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shortWindow", "longWindow", "slo", "errorBudget"],
          "properties": {
            "shortWindow": {"type": "object", "additionalProperties": false, "required": ["status", "evidenceRef"], "properties": {"status": {"enum": ["pending", "blocked", "complete"]}, "evidenceRef": {"type": "string"}}},
            "longWindow": {"type": "object", "additionalProperties": false, "required": ["status", "evidenceRef"], "properties": {"status": {"enum": ["pending", "blocked", "complete"]}, "evidenceRef": {"type": "string"}}},
            "slo": {"type": "object", "additionalProperties": false, "required": ["status", "reportRef"], "properties": {"status": {"enum": ["pending", "blocked", "measured"]}, "reportRef": {"type": "string"}}},
            "errorBudget": {"type": "object", "additionalProperties": false, "required": ["status", "consumedPercent", "decision"], "properties": {"status": {"enum": ["pending", "blocked", "within-budget", "exhausted"]}, "consumedPercent": {"type": ["number", "null"]}, "decision": {"enum": ["CONTINUE", "STOP-EXPANSION-AND-ROLLBACK", "BLOCKED"]}}}
          }
        },
        "decision": {"enum": ["NO-GO", "BLOCKED", "GO"]},
        "decisionPolicy": {"type": "object", "additionalProperties": false, "required": ["b21MustBeGo", "noOpenP0P1", "runtimeEvidenceRequired", "reportMustBeReproducible"], "properties": {"b21MustBeGo": {"const": true}, "noOpenP0P1": {"const": true}, "runtimeEvidenceRequired": {"const": true}, "reportMustBeReproducible": {"const": true}}},
        "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["gateId", "status", "evidenceIds"], "properties": {"gateId": {"type": "string"}, "status": {"enum": ["pending", "blocked", "pass"]}, "evidenceIds": {"type": "array", "minItems": 1}}}},
        "keyJourneys": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["journeyId", "status", "evidenceRef"], "properties": {"journeyId": {"type": "string"}, "status": {"enum": ["pending", "blocked", "pass"]}, "evidenceRef": {"type": "string"}}}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidenceId", "class", "status", "sha256", "releaseVersion", "environmentRef"], "properties": {"evidenceId": {"type": "string"}, "class": {"enum": ["runtime"]}, "status": {"enum": ["pending", "blocked", "captured"]}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "releaseVersion": {"type": "string"}, "environmentRef": {"type": "string"}}}},
        "upstreamGates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["batch", "decision", "evidenceRef"], "properties": {"batch": {"type": "string"}, "decision": {"enum": ["BLOCKED", "NO-GO", "GO"]}, "evidenceRef": {"type": "string"}}}},
