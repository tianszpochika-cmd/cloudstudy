  "sourceContracts": [
    {
      "id": "mobile-manifest",
      "path": "apps/mobile/src/manifest.json",
      "jsonAssertions": [
        { "path": "app-plus.screenOrientation", "contains": "portrait-primary" },
        { "path": "app-plus.screenOrientation", "contains": "landscape-primary" },
        { "path": "h5.router.mode", "equals": "hash" },
        { "path": "mp-weixin", "exists": true },
        { "path": "mp-weixin.appid", "equals": "" }
      ]
    },
    {
      "id": "mobile-viewport-and-safe-area",
      "paths": ["apps/mobile/index.html", "apps/mobile/src/App.vue"],
      "textAssertions": [
        { "path": "apps/mobile/index.html", "contains": "viewport-fit=cover" },
        { "path": "apps/mobile/src/App.vue", "contains": "onLaunch" },
        { "path": "apps/mobile/src/App.vue", "contains": "bootstrapMobileAuth" },
        { "path": "apps/mobile/src/App.vue", "contains": "env(safe-area-inset-top)" },
        { "path": "apps/mobile/src/App.vue", "contains": "env(safe-area-inset-bottom)" },
        { "path": "apps/mobile/src/App.vue", "contains": "未完成身份校验前不会渲染受保护学习内容" }
      ]
    },
    {
      "id": "mobile-auth-navigation",
      "path": "apps/mobile/src/auth/navigation.ts",
      "textAssertions": [
        { "contains": "installMobileNavigationGuard" },
        { "contains": "isMobileProtectedPath" },
        { "contains": "safeMobileReturnTo" },
        { "contains": "handleMobileApiError" },
        { "contains": "status === 401" },
        { "contains": "FORBIDDEN_PATH" }
      ]
    },
    {
      "id": "mobile-condition-builds",
      "path": "apps/mobile/package.json",
      "jsonAssertions": [
        { "path": "scripts.build:h5", "exists": true },
        { "path": "scripts.build:app", "exists": true },
        { "path": "scripts.build:mp-weixin", "exists": true },
        { "path": "scripts.dev:app", "exists": true }
      ]
    },
    {
      "id": "learner-pwa-manifest",
      "path": "apps/learner-web/public/manifest.webmanifest",
      "jsonAssertions": [
        { "path": "start_url", "equals": "/home" },
        { "path": "display", "equals": "standalone" },
        { "path": "lang", "equals": "zh-CN" },
        { "path": "theme_color", "exists": true },
        { "path": "background_color", "exists": true }
      ]
    },
    {
      "id": "learner-pwa-shell",
      "paths": ["apps/learner-web/index.html", "apps/learner-web/public/sw.js"],
      "textAssertions": [
        { "path": "apps/learner-web/index.html", "contains": "rel=\"manifest\"" },
        { "path": "apps/learner-web/index.html", "contains": "navigator.serviceWorker.register('/sw.js')" },
        { "path": "apps/learner-web/index.html", "contains": "location.protocol === 'https:'" },
        { "path": "apps/learner-web/public/sw.js", "contains": "CACHE_NAME" },
        { "path": "apps/learner-web/public/sw.js", "contains": "caches.delete" },
        { "path": "apps/learner-web/public/sw.js", "contains": "event.request.method !== 'GET'" }
      ]
    }
  ],
