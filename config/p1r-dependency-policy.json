{
  "version": 1,
  "policy": {
    "lockfileRequired": true,
    "frozenInstallRequired": true,
    "versionDrift": "fail",
    "missingInventory": "fail",
    "unknownLicense": "review",
    "deniedLicense": "fail",
    "highOrCriticalVulnerability": "fail"
  },
  "catalog": {
    "node": "20.19.5",
    "pnpm": "10.19.0",
    "java": 25,
    "mavenMinimum": "3.9.9",
    "springBoot": "4.1.1",
    "springCloud": "2025.1.3",
    "mavenEnforcerPlugin": "3.6.2",
    "cycloneDxMavenPlugin": "2.9.1"
  },
  "manifests": {
    "workspace": "pnpm-workspace.yaml",
    "node": "package.json",
    "nodeLock": "pnpm-lock.yaml",
    "mavenReactor": "pom.xml",
    "toolchain": "config/toolchain-baseline.json"
  },
  "licenses": {
    "allowed": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BlueOak-1.0.0",
      "CC-BY-4.0",
      "CC0-1.0",
      "ISC",
      "MIT",
      "MPL-2.0",
      "Python-2.0",
      "Unlicense",
      "WTFPL",
      "Zlib"
    ],
    "denied": ["AGPL-1.0", "AGPL-3.0", "SSPL-1.0"]
  },
  "sbom": {
    "format": "CycloneDX",
    "specVersion": "1.6",
    "nodeSource": "pnpm-lock.yaml",
    "mavenGoal": "org.cyclonedx:cyclonedx-maven-plugin:2.9.1:makeAggregateBom"
  }
}
