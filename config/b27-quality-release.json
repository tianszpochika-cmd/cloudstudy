  "qualityGates": [
    {
      "id": "B27-QUAL-003-SECURITY",
      "task": "V2-B27-QUAL-003",
      "staticChecks": [
        {
          "id": "B27-QUAL-STATIC-001",
          "kind": "security-boundary-contract",
          "status": "defined",
          "evidenceClass": "static",
          "runtimeRequired": false,
          "sourcePaths": ["config/b20-security-gates.json", "config/b20-privacy-content-gates.json"],
          "assertions": [
            { "sourcePath": "config/b20-security-gates.json", "contains": "fail-closed" },
            { "sourcePath": "config/b20-security-gates.json", "contains": "JWKS" },
            { "sourcePath": "config/b20-privacy-content-gates.json", "contains": "versioned-redacted-json" }
          ]
        },
        {
          "id": "B27-QUAL-STATIC-002",
          "kind": "performance-and-degradation-contract",
          "status": "defined",
          "evidenceClass": "static",
          "runtimeRequired": false,
          "sourcePaths": ["config/b19-quality-gates.json", "packages/performance/src/index.ts"],
          "assertions": [
            { "sourcePath": "config/b19-quality-gates.json", "contains": "web-vitals" },
            { "sourcePath": "config/b19-quality-gates.json", "contains": "PERFORMANCE_LEVELS" },
            { "sourcePath": "config/b19-quality-gates.json", "contains": "prefers-reduced-motion" }
          ]
