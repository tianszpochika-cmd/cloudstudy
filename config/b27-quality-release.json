      "redactSources": ["application-logs", "traces", "metrics", "browser-network", "screenshots", "support-export", "backup-manifest"],
      "rawPiiAllowed": false,
      "rawMediaAllowed": false,
      "productionCredentialsAllowed": false,
      "paymentCredentialsAllowed": false,
      "hashingPolicy": "keyed-reference-only-runtime-secret",
      "evidenceMustBeReproducibleWithoutPii": true
