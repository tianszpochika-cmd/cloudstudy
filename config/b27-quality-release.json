            { "sourcePath": "config/b19-quality-gates.json", "contains": "keyboard-navigation" },
            { "sourcePath": "config/b20-privacy-content-gates.json", "contains": "synthetic-references-only-no-real-subjects-no-raw-media-no-secrets" }
          ]
        }
