      "preflightRequired": true,
      "preflightDeniedOriginStatus": 403,
      "privateNetworkAccessAllowed": false
    },
    "rateLimiting": {
      "algorithm": "token-bucket",
      "enforcementPoint": "gateway-and-sensitive-service",
      "dimensions": ["route", "subject-or-anonymous-key", "source-network", "tenant"],
      "clientSuppliedRoleDimensionAllowed": false,
      "responseStatus": 429,
      "retryAfterRequired": true,
      "failOpenOnLimiterFailure": false,
      "sensitiveRouteOverrides": ["auth", "registration", "assessment-submit", "admin-export"]
    },
    "jwks": {
      "protocol": "self-owned-JWT",
      "issuerSource": "runtime-env-only",
      "jwksUriSource": "runtime-env-only",
      "allowedAlgorithms": ["RS256", "ES256"],
      "forbiddenAlgorithms": ["none", "HS256"],
      "issuerAndAudienceValidation": true,
      "clockSkewSecondsMaximum": 60,
      "keyRotationRequired": true,
      "unknownKeyDecision": "fail-closed",
      "jwksUnavailableDecision": "fail-closed",
      "expiredTokenDecision": "401",
      "missingScopeDecision": "403",
      "tokenForwardingToLogs": false
    },
    "privacyRedaction": {
      "policy": "redact-or-do-not-record",
