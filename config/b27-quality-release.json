  "securityQuality": {
    "defaultDecision": "BLOCKED",
    "authorization": {
      "defaultDeny": true,
      "gatewayJwtPreValidation": true,
      "serviceSidePepRequired": true,
      "pdpFailureDecision": "fail-closed",
      "revocationOrPolicyVersionFailureDecision": "fail-closed",
      "clientRoleHeadersTrusted": false,
      "clientTenantHeadersTrusted": false,
      "tenantDerivedServerSide": true,
      "ownerAndResourceCheckRequired": true,
      "crossTenantAccessDecision": "deny",
