          "kind": "accessibility-and-privacy-contract",
          "status": "defined",
          "evidenceClass": "static",
          "runtimeRequired": false,
          "sourcePaths": ["config/b19-quality-gates.json", "config/b20-privacy-content-gates.json"],
          "assertions": [
