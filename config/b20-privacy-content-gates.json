{
  "version": "1.0.0",
  "batch": "B20",
  "phase": "phase-1",
  "mode": "static-and-synthetic",
  "scope": "privacy-content-only",
  "releaseDecision": {
    "status": "blocked",
    "goAllowed": false,
    "reason": "Static contracts are defined, but real privacy requests, audit replay, content rights, approval and official projection evidence is not present in this repository run."
  },
  "tasks": [
    {
      "id": "V2-B20-PRI-002",
      "title": "隐私告知、同意、主体请求、留存、脱敏与审计回放",
      "hosts": ["iam-service", "learner-service", "admin-ops-service"],
      "staticEvidenceIds": [
        "EV-B20-PRI-STATIC-CONSENT",
        "EV-B20-PRI-STATIC-REQUESTS",
        "EV-B20-PRI-STATIC-REDACTION",
        "EV-B20-PRI-STATIC-AUTHZ"
      ],
      "runtimeEvidenceIds": [
        "EV-B20-PRI-RUNTIME-REQUESTS",
        "EV-B20-PRI-RUNTIME-AUDIT"
      ]
    },
    {
      "id": "V2-B20-CNT-003",
      "title": "Phase 1 内容来源、版权、双审、发布、下线、回滚与官网公示",
      "hosts": ["content-service", "admin-ops-service", "official-site"],
      "staticEvidenceIds": [
        "EV-B20-CNT-STATIC-RIGHTS",
        "EV-B20-CNT-STATIC-WORKFLOW",
        "EV-B20-CNT-STATIC-PROJECTION"
      ],
      "runtimeEvidenceIds": [
        "EV-B20-CNT-RUNTIME-REVIEW",
        "EV-B20-CNT-RUNTIME-PROJECTION"
      ]
    }
  ],
  "runtimeGate": {
    "staticOnlyByDefault": true,
    "requireRuntimeEnv": "B20_REQUIRE_RUNTIME",
    "requiredEnv": [
      "B20_RUNTIME_PRIVACY_EVIDENCE_REF",
      "B20_RUNTIME_AUDIT_REPLAY_EVIDENCE_REF",
      "B20_RUNTIME_CONTENT_EVIDENCE_REF",
      "B20_RUNTIME_OFFICIAL_PROJECTION_EVIDENCE_REF"
    ],
    "requiredEvidence": [
      "approved-isolated-privacy-request-run",
      "approved-audit-replay-integrity-report",
      "approved-content-rights-and-dual-review-run",
      "approved-official-site-projection-replay"
    ],
    "runtimeStatusPolicy": "pending-until-external-evidence",
    "staticValidatorCannotPromoteRuntime": true
  },
  "privacy": {
    "notice": {
      "required": true,
      "versioned": true,
      "requiredFields": ["noticeId", "policyVersion", "effectiveAt", "locale", "publishedAt"],
      "contentAndUiLocaleAreSeparate": true,
      "supersededNoticeRemainsReplayable": true
    },
    "consent": {
      "grant": {
        "explicit": true,
        "requiresCurrentPolicyVersion": true,
        "subjectDerivedServerSide": true,
        "tenantDerivedServerSide": true
      },
      "revoke": {
        "supported": true,
        "createsImmutableFact": true,
        "stopsOptionalProcessing": true,
        "doesNotEraseAuditHistory": true
      },
      "requiredTypes": ["TERMS_OF_SERVICE", "PRIVACY_NOTICE"],
      "unknownPolicyVersionDecision": "deny"
    },
    "subjectRequests": {
      "export": {
        "supported": true,
        "scope": "self",
        "authorization": "server-side-pep",
        "format": "versioned-redacted-json",
        "idempotencyRequired": true,
        "tenantDerivedServerSide": true
      },
      "erasure": {
        "supported": true,
        "scope": "self",
        "requiresExplicitConfirmation": true,
        "retentionPolicyApplied": true,
        "legalHoldBlocksDestructiveStep": true,
        "auditFactPreserved": true
      },
      "status": {
        "states": ["REQUESTED", "AUTHORIZED", "PROCESSING", "COMPLETED", "REJECTED", "BLOCKED_BY_HOLD"],
        "replayable": true
      }
    },
    "retention": {
      "policyVersioned": true,
      "deletionJobMustBeIdempotent": true,
      "deletionScopeMustBeSubjectBound": true,
      "legalHoldOverridesDeletion": true,
      "rawMediaDefaultAction": "delete-or-expire-by-policy",
      "auditAndLegalFacts": "retain-minimal-redacted-fact"
    },
    "redaction": {
      "version": "redaction-v1",
      "adminProjectionMustBeRedacted": true,
      "auditMustUseSafeFieldsOnly": true,
      "adminProjectionAllowedFields": ["resourceRef", "categoryCode", "priority", "state", "slaState", "redactionVersion"],
      "maskedFields": ["contactEmail", "phoneNumber", "ipAddress", "subjectId", "tenantId"],
      "forbiddenOutputFields": ["password", "accessToken", "refreshToken", "authorizationCode", "paymentCredential", "rawAudio", "audioBytes", "privateNotes"],
      "strategies": ["drop", "hash", "partial", "email", "phone", "ip", "dateOnly"]
    },
    "auditReplay": {
      "appendOnly": true,
      "hashChained": true,
      "integrityCheckRequired": true,
      "replayable": true,
      "rawIdentityStored": false,
      "safeFieldsOnly": true,
      "decisionMustInclude": ["decisionId", "operation", "traceId", "occurredAt", "result"],
      "tamperDecision": "deny-and-alert"
    },
    "authorization": {
      "defaultDecision": "deny",
      "serverSidePepRequired": true,
      "clientRoleHeadersIgnored": true,
      "forbiddenClientAuthorityFields": ["subjectId", "tenantId", "ownerId", "role", "roles", "permissions", "consentState"],
      "selfExportOnly": true,
      "adminCrossSubjectAccess": "explicit-permission-and-redacted-projection"
    }
  },
  "content": {
    "rights": {
      "requiredFields": ["sourceCode", "licenseCode", "status", "allowsLearning", "permittedChannels", "authorizationEvidenceRef"],
      "missingRightsAction": "deny-publish-and-projection",
      "expiredOrRevokedAction": "deny-publish-and-projection",
      "rightsMustBeEvaluatedBy": "content-service",
      "cacheCannotOverrideRights": true
    },
    "workflow": {
      "states": ["DRAFT", "IN_REVIEW", "APPROVED", "PUBLISHED", "ARCHIVED"],
      "requiredTransitions": [
        { "from": "DRAFT", "to": "IN_REVIEW" },
        { "from": "IN_REVIEW", "to": "APPROVED" },
        { "from": "APPROVED", "to": "PUBLISHED" },
        { "from": "PUBLISHED", "to": "ARCHIVED" }
      ],
      "rollback": {
        "supported": true,
        "requiresTargetVersion": true,
        "requiresReason": true,
        "invalidatesProjection": true,
        "emitsReplayableFact": true
      },
      "dualReview": {
        "required": true,
        "stages": ["FIRST_REVIEW", "FINAL_REVIEW"],
        "reviewersMustBeDistinct": true,
        "publisherCannotApproveOwnReview": true,
        "approvalRequiredBeforePublish": true,
        "selfApprovalDecision": "deny"
      },
      "draftIsolation": {
        "publicReadable": false,
        "learnerReadable": false,
        "officialSiteReadable": false
      },
      "unpublish": {
        "supported": true,
        "invalidatesCache": true,
        "withdrawalPropagatesToOfficialSite": true
      }
    },
    "publicProjection": {
      "sourceOfTruth": "content-service",
      "consumerApp": "apps/official-site",
      "readOnly": true,
      "noDirectFactWrite": true,
      "routes": ["/courses", "/pricing", "/download", "/announcements", "/compliance"],
      "allowedFields": ["contentId", "versionId", "title", "summary", "locale", "targetLevel", "goalCode", "contentHash", "publishedAt"],
      "forbiddenFields": ["answer", "answerRules", "correctAnswer", "scoringRule", "reviewNotes", "copyrightEvidence", "privateNotes"],
      "fallback": "explicit-stale-or-unavailable-state",
      "unpublishedContentAction": "not-found-or-unavailable"
    },
    "adminBoundary": {
      "commandsGoToContentService": true,
      "adminCannotWriteFactTable": true,
      "auditAssociationRequired": true,
      "permissionDeniedIsExplicit": true
    }
  },
  "syntheticFixtures": {
    "subjects": [
      {
        "id": "fixture-subject-001",
