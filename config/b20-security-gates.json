{
  "schemaVersion": 1,
  "batch": "B20",
  "taskId": "V2-B20-SEC-001",
  "phase": "phase-1",
  "mode": "static-and-synthetic",
  "task": {
    "id": "V2-B20-SEC-001",
    "name": "SAST、依赖与镜像扫描、秘密扫描、SBOM、KMS/Vault、最小权限和运行边界 Gate",
    "status": "defined",
    "runtimeRequired": true,
    "acceptanceRefs": ["ARCH-SEC-001", "ARCH-IAM-002", "ARCH-DEP-001"]
  },
  "execution": {
    "mode": "static-fixture-only",
    "status": "runtimeBlocked",
    "runtimeBlocked": true,
    "allowUnverifiedPass": false,
    "runtimeEvidence": null,
    "blockedReasons": [
      "CI 尚未绑定可复现的 SAST、依赖、镜像和秘密扫描工具链及其 SARIF/SBOM 归档",
      "受信镜像仓库、KMS/Vault、签名验证和部署平台工作负载身份尚未提供运行凭据",
      "Kubernetes 非 root、默认拒绝网络策略和服务间 mTLS 尚未在目标运行环境完成演练"
    ]
  },
  "tooling": {
    "sast": {
      "required": true,
      "tools": ["Semgrep", "CodeQL"],
      "output": "SARIF",
      "status": "pending",
      "runtimeRequired": true
    },
    "dependency": {
      "required": true,
      "tools": ["OWASP Dependency-Check", "OSV-Scanner"],
      "output": "SARIF-or-JSON",
      "status": "pending",
      "runtimeRequired": true
    },
    "image": {
      "required": true,
      "tools": ["Trivy", "Grype"],
      "output": "JSON",
      "status": "pending",
      "runtimeRequired": true
    },
    "secrets": {
      "required": true,
      "tools": ["Gitleaks", "synthetic-fixture-scan"],
      "output": "JSON",
      "status": "pending",
      "runtimeRequired": true
    },
    "sbomAndProvenance": {
      "required": true,
      "tools": ["Syft", "CycloneDX", "cosign"],
      "formats": ["SPDX", "CycloneDX"],
      "status": "pending",
      "runtimeRequired": true
    }
  },
  "repositorySecretPolicy": {
    "actualSecretMaterial": "forbidden",
    "fixtureMode": "synthetic-only",
    "allowPlaceholderValues": ["", "change-me", "local-only", "mock"],
    "forbiddenFixtureFields": [
      "password",
      "secret",
      "privateKey",
      "clientSecret",
      "accessToken",
      "refreshToken",
      "paymentCredential",
      "rawAudio"
    ],
    "forbiddenPatterns": [
      "-----BEGIN PRIVATE KEY-----",
      "AKIA[0-9A-Z]{16}",
      "ghp_[A-Za-z0-9]{36}",
      "sk-[A-Za-z0-9]{20,}",
      "Bearer eyJ[A-Za-z0-9_-]+\\.",
      "@gmail\\.com",
      "@qq\\.com",
      "@163\\.com",
      "@outlook\\.com"
    ],
    "scanTargets": [
      ".gitignore",
      ".env.example",
      "scripts/security/scan-synthetic-fixtures.mjs",
      "packages/telemetry/policies/access-control.json"
    ],
    "redactionPolicy": "do-not-log-or-archive-secret-values; store only finding metadata and digest"
  },
  "kmsVault": {
    "providerMode": "external-approved-kms-or-vault",
    "repositorySecretMaterial": false,
    "environmentReferenceOnly": true,
    "signingKeySource": "KMS-or-Vault",
    "requiredControls": [
      "key-versioning",
      "dual-key-rotation-window",
      "audited-access",
      "least-privilege-workload-policy",
      "revocation-and-rollback"
    ],
    "failClosedOnUnavailable": true,
    "runtimeStatus": "pending"
  },
  "leastPrivilege": {
    "defaultEffect": "deny",
    "serviceAccountPerService": true,
    "crossServiceSchemaWrite": false,
    "clientAuthorityHeadersTrusted": false,
    "forbiddenAuthorityHeaders": [
      "X-Role",
      "X-B5-Role",
      "X-Tenant-Id",
      "X-Owner-Id",
      "X-Subject-Id",
      "X-Permissions",
      "X-Policy-Version"
    ],
    "requiredDecisionFacts": [
      "subject",
      "tenant",
      "role",
      "permission",
      "resource",
      "action",
      "owner",
      "phase",
      "contentRights",
      "consent"
    ],
    "unknownDecision": "deny"
  },
  "containerRuntime": {
    "podSecurityStandard": "restricted",
    "runAsNonRoot": true,
    "allowPrivilegeEscalation": false,
    "readOnlyRootFilesystem": true,
    "dropLinuxCapabilities": ["ALL"],
    "seccompProfile": "RuntimeDefault",
    "imageReference": "immutable-digest-required",
    "runtimeStatus": "pending"
  },
  "networkBoundary": {
    "localBindAddress": "127.0.0.1",
    "defaultDenyNetworkPolicy": true,
    "publicIngressOwner": "api-gateway",
    "domainServicesDirectPublicIngress": false,
    "egressAllowlistRequired": true,
    "serviceToServiceIdentity": "mTLS-or-platform-workload-identity",
    "runtimeStatus": "pending"
  },
  "mtlsAndSigning": {
    "serviceTransport": "mTLS",
    "clientCertificateRequiredForInternalCalls": true,
    "certificateExpiryDecision": "deny",
    "forwardedIdentityHeadersTrusted": false,
    "artifactSignatureRequired": true,
    "signatureVerificationBeforeDeploy": true,
    "signatureKeySource": "KMS-or-Vault",
    "runtimeStatus": "pending"
  },
  "controls": [
    {
      "id": "B20-SEC-SAST",
      "objective": "对 Java、Node、配置和 IaC 执行可复现的 SAST，并归档 SARIF；高危结果阻断发布。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-DEPENDENCY",
      "objective": "对 Maven、pnpm 和 transitive dependency 执行漏洞扫描，按 CVSS/可利用性阻断高危版本。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-IMAGE",
      "objective": "对 OCI 镜像执行漏洞、配置、非 root、digest 和 provenance 检查。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-SECRETS",
      "objective": "阻止真实密钥、令牌、PII、支付凭据和原始音频进入 Git、镜像、日志或测试夹具。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-SBOM",
      "objective": "为构建物生成 SPDX/CycloneDX SBOM，绑定来源、锁文件、镜像 digest 和 cosign 签名。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-KMS",
      "objective": "签名密钥只能由外部 KMS/Vault 管理，支持轮换、撤销、审计和不可用时 fail closed。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-PRIVILEGE",
      "objective": "验证默认拒绝、服务账号隔离、服务 schema 写权限隔离和客户端 authority header 不可信。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-CONTAINER",
      "objective": "验证 restricted Pod Security、非 root、只读根文件系统、禁止提权和能力丢弃策略。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-NETWORK",
      "objective": "验证 Gateway 是唯一公共入口、默认拒绝网络、最小 egress 和固定边界绑定。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    },
    {
      "id": "B20-SEC-MTLS",
      "objective": "验证服务间 mTLS/workload identity、证书过期拒绝和 OCI 签名部署前校验。",
      "priority": "P0",
      "staticPolicy": "defined",
      "runtimeStatus": "pending"
    }
  ],
