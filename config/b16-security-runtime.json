{
  "version": 1,
  "phase": "phase-1",
  "defaultDecision": "deny",
  "gateway": {
    "serviceId": "api-gateway",
    "portKey": "api-gateway",
    "publicPrefix": "/api/v1",
    "directConnectAllowed": false,
    "requiresRequestId": true,
    "requiresTraceId": true,
    "errorEnvelope": "application/json",
    "corsAllowlistSource": "gateway.cors.allowed-origins",
    "rateLimitDistributed": true,
    "forbiddenAuthorityHeaders": [
      "X-Role",
      "X-B5-Role",
      "X-Tenant-Id",
      "X-Owner-Id"
    ]
  },
  "jwt": {
    "mode": "self-owned-jwt",
    "issuerEnv": "IAM_JWT_ISSUER",
    "jwksEnv": "IAM_JWT_JWKS_URI",
    "audienceEnv": "IAM_JWT_AUDIENCE",
    "issuer": "http://127.0.0.1:18087",
    "jwksUri": "http://127.0.0.1:18087/api/v1/auth/jwks",
    "audience": "yuxuexing-api",
    "algorithm": "RS256",
    "tokenType": "access",
    "requiredClaims": ["iss", "sub", "aud", "exp", "iat", "nbf", "jti", "token_type", "scope", "roles", "permissions", "tenant_id", "session_id"],
    "refreshRotationRequired": true,
    "keyRotationRequired": true,
    "sessionRevocationRequired": true,
    "failClosedOnJwksUnavailable": true,
    "privateKeyOutsideRepository": true
  },
  "iam": {
    "serviceId": "iam-service",
    "portKey": "iam-service",
    "platformTenant": "platform",
    "serverOwnedFacts": [
      "principal",
      "tenant",
      "device",
      "session",
      "adultGate",
      "consent",
      "audit"
    ],
    "tenantDerivation": "server-owned-principal-mapping",
    "adultMinimumAge": 18,
    "minorDomainEnabled": false,
    "auditReplayRequired": true
  },
  "pep": {
    "resourceServerRequired": true,
    "policyVersionRequired": true,
    "securityCacheMustBeBounded": true,
    "pdpUnknownDecision": "deny",
    "revocationUnknownDecision": "deny",
    "checks": [
      "subject",
      "tenant",
      "role",
      "permission",
      "resource",
      "action",
      "owner",
      "phase",
      "contentRights",
      "consent"
    ],
    "domainServices": [
      "learner-service",
      "content-service",
      "learning-service",
      "assessment-service",
      "media-service",
      "gamification-service",
      "social-service",
      "commerce-service",
      "notification-service",
      "analytics-service",
      "admin-ops-service"
    ]
  },
  "workloadIdentity": {
    "transport": "mTLS-or-platform-workload-identity",
    "clientAuthorityHeadersTrusted": false,
    "credentialRotationRequired": true,
    "certificateExpiryDecision": "deny",
    "minimumPrivilegeRequired": true
  },
  "runtimeEvidence": {
    "static": [
      "manifest",
      "contract",
      "configuration",
      "forbidden-header",
      "default-deny"
    ],
    "runtime": [
      "gateway-to-iam-login",
      "jwt-login-refresh-logout",
      "gateway-to-domain-pep",
      "cross-tenant-deny",
      "revocation",
      "jwks-fault-fail-closed",
      "direct-connect-deny"
    ],
    "runtimePrerequisites": [
      "java-25",
      "maven-3.9.9-or-newer",
      "docker-or-equivalent",
      "iam-jwt-jwks-and-test-account-fixture"
    ]
  }
}
