      "expand-contract migration, backup/restore point and rollback evidence",
      "content copyright, dual approval, withdrawal and version restore Gate",
      "payment sandbox, signature, idempotency, refund and reconciliation Gate",
      "Gateway/IAM/service PEP/platform health and four-client binding Gate",
      "immutable OCI artifact, signature, SBOM, provenance and audit evidence",
      "production approval, maintenance ownership, stop-expansion and rollback evidence"
    ],
    "excluded": [
      "kubectl execution",
      "helm execution",
      "docker execution",
      "real production release",
      "real traffic switch",
      "destructive database migration",
      "real payment operation"
    ]
  },
