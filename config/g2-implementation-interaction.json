  "interactionStateContract": {
    "states": ["loading", "empty", "error", "permission", "recovery", "offline", "success", "partial"],
    "nonColorSignals": ["visible text", "icon", "role", "aria-live", "action label"],
    "permissionSemantics": ["401/unauthorized", "403/forbidden", "explicit permission state", "no permission-to-empty downgrade"],
    "recoverySemantics": ["retry action", "resume checkpoint", "idempotent replay", "visible result", "no fabricated success"],
    "emptySemantics": ["empty is not zero", "no local sample promoted", "server projection may be unavailable"],
    "partialSemantics": ["degraded content is labeled", "available facts remain usable", "missing facts are not invented"]
  },
  "retryAndDegradation": {
    "writeRequests": {
      "idempotencyHeader": "Idempotency-Key",
      "offlineClientEventId": "clientEventId",
      "duplicateSideEffectsForbidden": true
    },
    "retry": {
      "retryableErrorMustBeExplicit": true,
      "recoveryActionMustBeVisible": true,
      "replayMustBeBoundToRequestOrCheckpoint": true
    },
    "offline": {
      "stateMustBeVisible": true,
      "queueOrCheckpointMustBeBounded": true,
      "reconnectRecoveryRequired": true
    },
    "degradation": {
      "preservePrimaryLearningPath": true,
      "performanceFallbackMode": "static",
      "noAutomaticQualityUpgrade": true,
      "noSyntheticDataOnFailure": true
    }
  },
