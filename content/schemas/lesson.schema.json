{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "englishflow.lesson.v1",
  "title": "Lesson",
  "type": "object",
  "required": ["id", "version", "title", "level", "skillTags", "steps"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1"] },
    "skillTags": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "status": { "enum": ["draft", "review", "published", "archived"] }
  }
}
