# 统一以 LF 存储与检出，避免 Windows / Linux 行为分叉。
# 该文件优先于个人 core.autocrlf 设置，保证所有机器检出结果一致。
* text=auto eol=lf

# 二进制文件：禁止任何换行符转换。
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.jar   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Windows 批处理脚本必须保持 CRLF，否则 cmd.exe 解析可能异常。
*.bat   text eol=crlf
*.cmd   text eol=crlf

# R1-002 evidence snapshots use raw bytes; do not rewrite their recorded SHA-256 inputs.
evidence/p1r/m2/P1R-M2-002/redesign/R1-002/** -text whitespace=cr-at-eol
