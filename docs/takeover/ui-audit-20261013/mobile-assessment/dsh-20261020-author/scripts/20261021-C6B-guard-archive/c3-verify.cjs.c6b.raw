//   apps/mobile/src/pages/assessment/assessment.vue  ac8fb8d2831f4d5f1f20091e09abef7cc6a1314021545ecbbb84a31d11f157fd  (C6b; supersedes C5c 719cc0ce... and C3 86620ed0...)
//   packages/i18n/src/mobile-experience.ts           6ac6800e179de0ba15ab3607918b2f8427d364e19306eaf8f2a146f016247380  (unchanged)
//
// C6b expected-only: clean UI self-block and navigation permit owner/op/target.
